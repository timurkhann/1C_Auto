    Реквизит_тм_ОписаниеСпецификация = Новый РеквизитФормы("тм_ОписаниеСпецификации", Новый ОписаниеТипов("Строка",,,, Новый КвалификаторыСтроки(250)), "Объект.Работы",  "Описание спецификации");

