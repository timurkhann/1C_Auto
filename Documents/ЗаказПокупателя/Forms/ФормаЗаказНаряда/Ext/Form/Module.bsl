
#Область ОбработчикиСобытийФормы

&НаСервере
Процедура тм_ПриСозданииНаСервереПосле(Отказ, СтандартнаяОбработка)	
	
	Результат = тм_ОбщегоНазначенияВызовСервера.ПроверитьДоступыОткрытияДокумента(Отказ, ЭтотОбъект.ИмяФормы);
	
	Если Результат.Отказ Тогда
		ОбщегоНазначения.СообщитьПользователю(Результат.ПричинаОтказа,,,, Отказ); 
		Возврат;
	КонецЕсли; 
	
	ДобавитьВставитьЭлементыНаФорму();
	
	ДобавитьКоманды();

	//Блокировка документа от ввода данных
	ЗаблокироватьРазблокироватьДокумент();
	
	ЗаполнитьРеквизитыПоУмолчанию();
	
	тм_ОбщегоНазначенияВызовСервера.ВывестиЗакупочныеЦены(Объект.Запасы);
	тм_ОбщегоНазначенияВызовСервера.ВывестиПроизводителя(Объект.Запасы);
	тм_ОбщегоНазначенияВызовСервера.ВывестиОписаниеХарактеристики(Объект.Работы);
	
	тм_ПереопределяемыйСервер.ПереопределитьПараметрыВыбора(ЭтотОбъект);
	
	ЭтотОбъект.тм_ВедетсяУчетПоЯчейкам = ПолучитьФункциональнуюОпцию("УчетПоЯчейкам");
	ЭтотОбъект.тм_ОсновнойСкладПользователя = тм_ПерсональныеНастройкиУНФ.Прочитать("ОсновнойСклад",, ПараметрыСеанса.ТекущийПользователь);
	
	Если ЭтотОбъект.тм_ВедетсяУчетПоЯчейкам Тогда
		тм_УстановитьПараметрыВыбораСклада();
	КонецЕсли;
	
	тм_ЗагрузитьМастеровПриемщиков();
	тм_УстановитьУсловноеОформление();

КонецПроцедуры

&НаКлиенте
Процедура тм_ПриОткрытииПосле(Отказ)
	
	тм_УправлениеДоступом();
	тм_ОбновитьВидимостьЯчейки(Объект, ЭтотОбъект);
	
КонецПроцедуры

&НаСервере
Процедура тм_ПередЗаписьюНаСервереПеред(Отказ, ТекущийОбъект, ПараметрыЗаписи)
	
	ПроверитьЗаполненияРеквизитов(Отказ, ТекущийОбъект);

	// Избавит от лишних блокировок формы
	Если Не ЗначениеЗаполнено(Параметры.Ключ) Тогда
		ТекущийОбъект.ДополнительныеСвойства.Вставить("тм_ЭтоНовыйДокумент", Истина);
	КонецЕсли;
	
	// Право
	ТолькоПроведение = тм_ОбщегоНазначенияВызовСервера.ЗначениеНастройкиПользователя("Разрешено только проведение документа", ПараметрыСеанса.ТекущийПользователь, Ложь, Истина);
	Если ТолькоПроведение 
		И ПараметрыЗаписи.РежимЗаписи = РежимЗаписиДокумента.Запись Тогда
		ЭтотОбъект.тм_РазрешеноПроведение = Ложь;
		ОбщегоНазначения.СообщитьПользователю("Разрешено только ПРОВЕДЕНИЕ документа!",,,, Отказ);
	КонецЕсли;
	
	Если ТекущийОбъект.СостояниеЗаказа = ПредопределенноеЗначение("Справочник.СостоянияЗаказНарядов.Завершен")
		И Объект.Организация = тм_ОбщегоНазначения.ПредопределенныйЭлемент("Организация_Куликова", "Значение") Тогда
		ТекущийОбъект.ЭтоУниверсальныйДокумент = Истина;
	КонецЕсли;
	
	Если ТекущийОбъект.Дата >= Дата("20260529")
		И ЭтотОбъект["тм_МастераПриемщики"].Количество() = 0 Тогда
		ОбщегоНазначения.СообщитьПользователю("Необходимо указать мастера-приемщика",, "тм_МастераПриемщики",, Отказ);
		Возврат;
	КонецЕсли;
	
	ТекущийОбъект.тм_МастераПриемщики.Очистить();
	
	Для каждого МастерПриемщик Из ЭтотОбъект["тм_МастераПриемщики"] Цикл
		НоваяСтрока = ТекущийОбъект.тм_МастераПриемщики.Добавить();
		НоваяСтрока.тм_Сотрудник = МастерПриемщик.Значение;
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура тм_ПослеЗаписиНаСервереПосле(ТекущийОбъект, ПараметрыЗаписи)
	
	Если ТекущийОбъект.ДополнительныеСвойства.Свойство("тм_ЭтоНовыйДокумент") Тогда
		ЗаблокироватьРазблокироватьДокумент();
	КонецЕсли; 
	
	тм_ОбщегоНазначенияВызовСервера.ВывестиЗакупочныеЦены(Объект.Запасы);
	тм_ОбщегоНазначенияВызовСервера.ВывестиПроизводителя(Объект.Запасы);

КонецПроцедуры

&НаКлиенте
Процедура тм_ПередЗакрытиемПеред(Отказ, ЗавершениеРаботы, ТекстПредупреждения, СтандартнаяОбработка)
		
	Если ЗавершениеРаботы Тогда
		Если Не ЭтотОбъект.тм_МожноЗакрытьФорму Тогда
			Отказ = Истина;
			СтандартнаяОбработка = Ложь;
			ТекстПредупреждения = "Нажмите <Продолжить работу> для сохранения данных! 
				|Далее <Завершить работу> после сохранения";
			ПодключитьОбработчикОжидания("ЗаблокироватьРазблокироватьДокументНаКлиенте", 1, Истина);
		КонецЕсли;
	Иначе
		ЗаблокироватьРазблокироватьДокумент(Ложь);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура тм_ПередЗаписьюПеред(Отказ, ПараметрыЗаписи)
	
	Если ПараметрыЗаписи.РежимЗаписи = РежимЗаписиДокумента.Проведение
		И Не ЭтотОбъект.тм_РазрешеноПроведение
		И Не ПустаяСтрока(Объект.тм_Рекомендация) Тогда
		
		ОписаниеОповещенияВопроса = Новый ОписаниеОповещения("тм_ПослеПоказаВопроса", ЭтотОбъект);
		ТекстВопроса = НСтр("ru = 'Указана рекомендация в документе. Необходимо подписать заказ-наряд'");
		
		ПоказатьВопрос(ОписаниеОповещенияВопроса, ТекстВопроса, РежимДиалогаВопрос.ОКОтмена,,, НСтр("ru = 'Подписать заказ-наряд'"));
		Отказ = Истина;
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Асинх Процедура АвтомобильПриИзмененииДанных(Элемент)
	
	ПоследняяРекоммендация = "";
	
	АвтомобильПриИзмененииДанныхНаСервере(ПоследняяРекоммендация); 
	
	Если Не ПустаяСтрока(ПоследняяРекоммендация) Тогда
		Ждать ВвестиСтрокуАсинх(ПоследняяРекоммендация, "Обратите внимание",, Истина);
	КонецЕсли;
	
КонецПроцедуры 

&НаКлиенте
Асинх Процедура тм_ЗНКонтрагентПриИзмененииПосле(Элемент)
	
	Объект.тм_Пробег = 0;
	Если ЗначениеЗаполнено(Объект.Контрагент) Тогда
		
		ИнформацияОКлиенте = ПолучитьИнформациюОКлиенте(Объект.Контрагент);
		Если Не ПустаяСтрока(ИнформацияОКлиенте) Тогда
			
			ФорматированнаяСтрока = Новый ФорматированнаяСтрока(ИнформацияОКлиенте,, Новый Цвет(255, 0, 0)); 
			Ждать ПредупреждениеАсинх(ФорматированнаяСтрока,, "Обратите внимание");
			
		КонецЕсли; 
		
	КонецЕсли;
	
	тм_КонтрагентПриИзмененииНаСервере();
	
	ОрганизацияПриИзменении(Элементы.ЗНОрганизация);
	
КонецПроцедуры

&НаКлиенте
Процедура ИсполнительПриИзмененииДанных(Элемент)

	ТекущиеДанные = Элементы.Работы.ТекущиеДанные;
	Проверка = Новый Структура("ЭтоТипУслуга, НеЗаданПроцентЗаВыполненнуюРаботу", Ложь, Ложь);
	
	ИсполнительПриИзмененииДанныхНаСервере(ТекущиеДанные.Номенклатура, ТекущиеДанные.тм_Сотрудник, Проверка); 
	
	Если Проверка.ЭтоТипУслуга Тогда
		ТекущиеДанные.тм_Сотрудник = ПредопределенноеЗначение("Справочник.Сотрудники.ПустаяСсылка");
		ОбщегоНазначенияКлиент.СообщитьПользователю("Для работ с типом ""Услуга"" исполнитель не указывается!");
	КонецЕсли;
	
	Если Проверка.НеЗаданПроцентЗаВыполненнуюРаботу Тогда
		ПоказатьПредупреждение(, "Не задан процент за выполненную работу сотруднику",, "Внимание");
	КонецЕсли; 
	
КонецПроцедуры

&НаКлиенте
&ИзменениеИКонтроль("СчетФактураНадписьОбработкаНавигационнойСсылки")
Процедура тм_СчетФактураНадписьОбработкаНавигационнойСсылки(Элемент, НавигационнаяСсылкаФорматированнойСтроки, СтандартнаяОбработка)

	СтандартнаяОбработка = Ложь;
	#Вставка
	Если НавигационнаяСсылкаФорматированнойСтроки = "создать" Тогда
		Если Объект.СостояниеЗаказа <> ПредопределенноеЗначение("Справочник.СостоянияЗаказНарядов.Завершен") Тогда
			Права = тм_ОбщегоНазначенияВызовСервера.ПолучитьПраваОбъекта(Объект);
			Если Не Права.SA Тогда
				ПоказатьПредупреждение(, НСтр("ru = 'Создать счет-фактуру возможно только в завершенном статусе!'"));
				Возврат;
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	#КонецВставки
	СчетаФактурыУНФКлиент.ОткрытьСчетФактуру(ЭтотОбъект);

КонецПроцедуры

&НаКлиенте
Процедура тм_СкидкаПроцентПриИзмененииПеред(Элемент)
	
	Если СкидкаПроцент = 100 Тогда
		СкидкаПроцент = 99.99;
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормы

&НаКлиенте
Процедура тм_ЗапасыНоменклатураПриИзмененииПосле(Элемент)
	
	Номенклатура = Элементы.Запасы.ТекущиеДанные.Номенклатура;
	
	Если Не Номенклатура.Пустая() Тогда
		// Проверка на выбранный тип номенклатуры
		Для каждого ПараметрВыбора Из Элементы.ЗапасыНоменклатура.ПараметрыВыбора Цикл
			Если ПараметрВыбора.Имя = "Отбор.ТипНоменклатуры" Тогда
				ТипНоменклатуры = тм_ТипНоменклатуры(Номенклатура);
				ЕстьДоступныйТип = ПараметрВыбора.Значение.Найти(ТипНоменклатуры) <> Неопределено;
				Если Не ЕстьДоступныйТип Тогда
					Элементы.Запасы.ТекущиеДанные.Номенклатура = ПредопределенноеЗначение("Справочник.Номенклатура.ПустаяСсылка");
					ТекстСообщения = СтрШаблон(НСтр("ru = 'Запрещено указывать номенклатуру с типом: %1'"), ТипНоменклатуры);
					ОбщегоНазначенияКлиент.СообщитьПользователю(ТекстСообщения);
					Возврат;
				КонецЕсли;
			КонецЕсли;
		КонецЦикла;
		
		тм_ОбщегоНазначенияВызовСервера.ВывестиЗакупочнуюЦенуПриИзмененииНоменклатуры(Элементы.Запасы.ТекущиеДанные.тм_ЗакупочнаяЦена, Номенклатура);
		тм_ОбщегоНазначенияВызовСервера.ВывестиПроизводителя(Номенклатура, Элементы.Запасы.ТекущиеДанные.тм_Производитель);
		Если Объект.Организация = тм_глПрава["Организация_Куликова"] Тогда
			тм_СтавкаНДС20_22 = тм_СтавкаНДС20_22();
			
			Если Элементы.Запасы.ТекущиеДанные.СтавкаНДС <> тм_СтавкаНДС20_22 Тогда
				Элементы.Запасы.ТекущиеДанные.СтавкаНДС = тм_СтавкаНДС20_22;
				РассчитатьСуммуВСтрокеТабличнойЧасти("Запасы");
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	
	УстановитьТекущегоСотрудника();
	ОбновитьДопРеквизитыПодвала();
	
КонецПроцедуры

&НаКлиенте
Процедура тм_РаботыСпецификацияПриИзмененииПосле(Элемент)
	
	Спецификация = Элементы.Работы.ТекущиеДанные.Спецификация;
	Если Не Спецификация.Пустая() Тогда                                        
		тм_ОбщегоНазначенияВызовСервера.ВывестиОписаниеХарактеристики(Спецификация, Элементы.Работы.ТекущиеДанные.тм_ОписаниеСпецификации);   
	Иначе
		Элементы.Работы.ТекущиеДанные.тм_ОписаниеСпецификации = "";
	КонецЕсли;                                    
	
КонецПроцедуры

&НаКлиенте
Процедура тм_ЗНРаботыНоменклатураПриИзмененииПосле(Элемент)
	
	тм_Работа = Элементы.Работы.ТекущиеДанные.Номенклатура;
	//тм_ОписаниеСпецификации = Элементы.Работы.ТекущиеДанные.тм_ОписаниеСпецификации;
	УстановитьСпецификацию(тм_Работа, Элементы.Работы.ТекущиеДанные.тм_ОписаниеСпецификации);
	УстановитьЦенуРаботы(тм_Работа, Элементы.Работы.ТекущиеДанные.Цена);
	
	Если Объект.Организация = тм_глПрава["Организация_Куликова"] Тогда
		тм_СтавкаНДС20_22 = тм_СтавкаНДС20_22();
		
		Если Элементы.Работы.ТекущиеДанные.СтавкаНДС <> тм_СтавкаНДС20_22 Тогда
			Элементы.Работы.ТекущиеДанные.СтавкаНДС = тм_СтавкаНДС20_22;
		КонецЕсли;
		
	КонецЕсли;
	
	РаботыЦенаПриИзменении("");
	
	ОбновитьДопРеквизитыПодвала();
	
КонецПроцедуры

&НаКлиенте
Процедура тм_РаботыСпецификацияСозданиеПосле(Элемент, СтандартнаяОбработка)
		
	СтандартнаяОбработка = Ложь;
	
	ЗначенияЗаполнения = Новый Структура;
	ЗначенияЗаполнения.Вставить("Владелец", Элементы.Работы.ТекущиеДанные.Номенклатура); 
	ЗначенияЗаполнения.Вставить("Наименование", ПолучитьНаименованиеСпецификации(Элементы.Работы.ТекущиеДанные.Номенклатура));
	
	ПараметрыПередачи = Новый Структура;
	ПараметрыПередачи.Вставить("ЗначенияЗаполнения", ЗначенияЗаполнения);
	
	ОткрытьФорму("Справочник.Спецификации.ФормаОбъекта", ПараметрыПередачи); 
		
КонецПроцедуры

