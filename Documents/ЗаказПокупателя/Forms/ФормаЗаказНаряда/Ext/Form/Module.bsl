Функция тм_ДоступныеМастераПриемщики()
	
	ГруппаМастера = тм_ОбщегоНазначения.ПредопределенныйЭлемент("Сотрудники_МастераПриемщики", "Значение");
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	Сотрудники.Ссылка КАК Сотрудник
		|ИЗ
		|	Справочник.Сотрудники КАК Сотрудники
		|ГДЕ
		|	Сотрудники.Ссылка В ИЕРАРХИИ(&ГруппаМастера)
		|	И НЕ Сотрудники.ЭтоГруппа";
	
	Запрос.УстановитьПараметр("ГруппаМастера", ГруппаМастера);
	
	Возврат Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Сотрудник");
	
КонецФункции 

&НаСервереБезКонтекста
Функция тм_ДоступныеИсполнителиРабот()
	
	ГруппаИсполнители = тм_ОбщегоНазначения.ПредопределенныйЭлемент("Сотрудники_ИсполнителиРабот", "Значение");
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	Сотрудники.Ссылка КАК Сотрудник
		|ИЗ
		|	Справочник.Сотрудники КАК Сотрудники
		|ГДЕ
		|	Сотрудники.Ссылка В ИЕРАРХИИ(&ГруппаИсполнители)
		|	И НЕ Сотрудники.ЭтоГруппа";
	
	Запрос.УстановитьПараметр("ГруппаИсполнители", ГруппаИсполнители);
	
	Возврат Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Сотрудник");
	
КонецФункции 

&НаСервере
Процедура тм_ЗагрузитьМастеровПриемщиков()
	
	Если ЗначениеЗаполнено(Параметры.Ключ) Тогда
		Для каждого СтрокаТаблицы Из Объект.тм_МастераПриемщики Цикл
			ЭтотОбъект["тм_МастераПриемщики"].Добавить(СтрокаТаблицы.тм_Сотрудник);
		КонецЦикла; 
	КонецЕсли;

КонецПроцедуры

&НаСервере
&ИзменениеИКонтроль("ОпределитьВидимостьИУстановитьНастройкиУчетаВНалогообложении")
Процедура тм_ОпределитьВидимостьИУстановитьНастройкиУчетаВНалогообложении()

	ВидимостьГруппыУчетВНУДоИзменения = Элементы.ГруппаУчетВНУ.Видимость;

	Если Не Справочники.Организации.ЭтоИП(Объект.Организация) Тогда
		Элементы.ГруппаУчетВНУ.Видимость = Ложь;

		Возврат;
	Иначе
		Элементы.ГруппаУчетВНУ.Видимость = Истина;
	КонецЕсли;

	СистемаНалогообложенияСтруктура = РегистрыСведений.СистемыНалогообложенияОрганизаций.ОпределитьСистемуНалогообложенияОрганизации(
	Объект.Организация, Объект.Дата);

	Если Не СистемаНалогообложенияСтруктура.ПлательщикУСН Тогда
		Элементы.ГруппаУчетВНУ.Видимость = Ложь;
	Иначе
		Элементы.ГруппаУчетВНУ.Видимость = Истина;
	КонецЕсли;

	Если Не ЗначениеЗаполнено(Объект.Ссылка) И СистемаНалогообложенияСтруктура.ПлательщикУСН
		И СистемаНалогообложенияСтруктура.ПлательщикЕНВД Тогда
		ОрганизацияВидУчетаСтраховыхВзносов = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Объект.Организация,
		"ВидУчетаСтраховыхВзносов");
		Объект.УчитыватьВНУ = ОрганизацияВидУчетаСтраховыхВзносов
		<> Перечисления.ВидыУчетаСтраховыхВзносов.УчитыватьВЕНВД;
	КонецЕсли;

	ГруппаУчетВНУСталаВидимой = Не ВидимостьГруппыУчетВНУДоИзменения И Элементы.ГруппаУчетВНУ.Видимость;
	ГруппаУчетВНУСталаНевидимой = ВидимостьГруппыУчетВНУДоИзменения И Не Элементы.ГруппаУчетВНУ.Видимость;
	Если Объект.УчитыватьВНУ
		И ((НЕ Элементы.ГруппаУчетВНУ.Видимость И Объект.Ссылка.Пустая())
		Или ГруппаУчетВНУСталаНевидимой) Тогда
		#Удаление
		Объект.УчитыватьВНУ = Ложь;
		Модифицированность = Истина;
 		#КонецУдаления
	ИначеЕсли ГруппаУчетВНУСталаВидимой И Не Объект.УчитыватьВНУ Тогда
		Объект.УчитыватьВНУ = Истина;
		Модифицированность = Истина;
	КонецЕсли;

КонецПроцедуры

&НаСервере
Процедура тм_УстановитьУсловноеОформление()
	
	ПредставлениеУО = НСтр("ru = 'Цена ниже закупочной (Запасы)'");
	
	// Защита от повторного добавления элемента оформления
	Для Каждого ЭлементУО Из УсловноеОформление.Элементы Цикл
		Если ЭлементУО.Представление = ПредставлениеУО Тогда
			Возврат;
		КонецЕсли;
	КонецЦикла;
	
	ЭлементУО = УсловноеОформление.Элементы.Добавить();
	ЭлементУО.Представление = ПредставлениеУО;
	
	ОформляемоеПоле = ЭлементУО.Поля.Элементы.Добавить();
	ОформляемоеПоле.Поле = Новый ПолеКомпоновкиДанных("ЗапасыЦена");
	
	ЭлементУО.Оформление.УстановитьЗначениеПараметра("ЦветФона", Новый Цвет(255, 0, 0));
	
	ГруппаЭлементовОтбораКомпоновкиДанных = ЭлементУО.Отбор.Элементы.Добавить(Тип("ГруппаЭлементовОтбораКомпоновкиДанных"));
	ГруппаЭлементовОтбораКомпоновкиДанных.ТипГруппы = ТипГруппыЭлементовОтбораКомпоновкиДанных.ГруппаИ;
	
	ОтборЦена = ГруппаЭлементовОтбораКомпоновкиДанных.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	ОтборЦена.ЛевоеЗначение  = Новый ПолеКомпоновкиДанных("Объект.Запасы.Цена");
	ОтборЦена.ВидСравнения   = ВидСравненияКомпоновкиДанных.Меньше;
	ОтборЦена.ПравоеЗначение = Новый ПолеКомпоновкиДанных("Объект.Запасы.тм_ЗакупочнаяЦена");
	ОтборЦена.Использование  = Истина;
	
КонецПроцедуры

#КонецОбласти 

