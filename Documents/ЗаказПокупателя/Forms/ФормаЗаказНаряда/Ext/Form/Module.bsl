&НаСервере
Процедура тм_УстановитьПараметрыВыбораЗапасыНоменклатура()
	
	ПараметрыВыбораНоменклатурыМассив = Новый Массив(Элементы.ЗапасыНоменклатура.ПараметрыВыбора);
	Индекс = -1;
	Для Сч = 0 По ПараметрыВыбораНоменклатурыМассив.ВГраница() Цикл
		Если ПараметрыВыбораНоменклатурыМассив[Сч].Имя = "Отбор.ТипНоменклатуры" Тогда
			Индекс = Сч;
			Прервать;
		КонецЕсли;
	КонецЦикла;
	
	Если Индекс >= 0 Тогда
		НовыйМассив = Новый Массив();
		НовыйМассив.Добавить(ПредопределенноеЗначение("Перечисление.ТипыНоменклатуры.Запас"));
		
		МассивТипов = Новый ФиксированныйМассив(НовыйМассив);
		НовыйПараметр = Новый ПараметрВыбора("Отбор.ТипНоменклатуры", МассивТипов);
		
		ПараметрыВыбораНоменклатурыМассив.Установить(Индекс, НовыйПараметр);
		
		НовыеПараметры = Новый ФиксированныйМассив(ПараметрыВыбораНоменклатурыМассив);
		Элементы.ЗапасыНоменклатура.ПараметрыВыбора = НовыеПараметры;
	КонецЕсли;
	
КонецПроцедуры

