&НаКлиенте
Процедура ПослеВыбораОтвета(РезультатВопроса, ДополнительныеПараметры) Экспорт
	
	Если РезультатВопроса = КодВозвратаДиалога.Да Тогда
		ЗапасыПередУдалением(ДополнительныеПараметры, Ложь);
		СтрокиУдаления = Новый Массив; 
		ВыделенныеСтроки = Элементы.Запасы.ВыделенныеСтроки;
		Для каждого ВыделеннаяСтрока Из ВыделенныеСтроки Цикл
			СтрокаТЧ = Объект.Запасы.НайтиПоИдентификатору(ВыделеннаяСтрока);
			Если СтрокаТЧ = Неопределено Тогда
				Продолжить;
			КонецЕсли;  
			СтрокиУдаления.Добавить(СтрокаТЧ);
		КонецЦикла;  
		
		Для каждого СтрокаУдаления Из СтрокиУдаления Цикл
			Объект.Запасы.Удалить(СтрокаУдаления);
			Модифицированность = Истина;
		КонецЦикла; 
		
		ЗапасыПослеУдаления(ДополнительныеПараметры);
	КонецЕсли;  
	
КонецПроцедуры

&НаСервере
Процедура тм_КонтрагентПриИзмененииНаСервере()

	ЮридическоеФизическоеЛицо = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Объект.Контрагент, "ВидКонтрагента", Истина);
	
	Организация_Куликова = тм_ОбщегоНазначения.ПредопределенныйЭлемент("Организация_Куликова", "Значение");
	Организация_СавицкаяОксана = тм_ОбщегоНазначения.ПредопределенныйЭлемент("Организация_СавицкаяОксана", "Значение");
	Организация_Савицкий = тм_ОбщегоНазначения.ПредопределенныйЭлемент("Организация_Савицкий", "Значение");
	
	Если ЮридическоеФизическоеЛицо = Перечисления.ВидыКонтрагентов.ЮридическоеЛицо
		Или ЮридическоеФизическоеЛицо = Перечисления.ВидыКонтрагентов.ИндивидуальныйПредприниматель Тогда
		Объект.Организация = Организация_Куликова;
	Иначе
		//Объект.Организация = Организация_СавицкаяОксана;
		Объект.Организация = Организация_Савицкий;
	КонецЕсли;

КонецПроцедуры // тм_КонтрагентПриИзмененииНаСервере()

