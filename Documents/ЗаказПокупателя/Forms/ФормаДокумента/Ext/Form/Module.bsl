	ЭлементЗапасыГруппаНоменклатура.ФиксацияВТаблице = ФиксацияВТаблице.Нет;
	
	#Область Запасы

	//Права = тм_КЭШ.ПолучитьПраваОбъекта(Метаданные.Документы.ЗаказПокупателя.Имя, Пользователи.ТекущийПользователь());
	//Если Права.SA Тогда
		
		Элемент_тм_Сотрудник = тм_ОбщегоНазначенияВызовСервера.ДобавитьЭлементНаФорму(ЭтотОбъект, 
			"тм_Сотрудник",
			Тип("ПолеФормы"),
			ВидПоляФормы.ПолеВвода,
			ЭтотОбъект.Элементы.Запасы,
			"Объект.Запасы.тм_Сотрудник");
			
		Элемент_тм_Сотрудник.Заголовок = "Сотрудник/Исполнитель";
	//	Элемент_тм_Сотрудник.Доступность = Ложь;
	//		
	//КонецЕсли; 

	#КонецОбласти
	
	ДобавляемыеРеквизиты = Новый Массив;
	
	Реквизит_тм_МожноЗакрытьФорму = Новый РеквизитФормы("тм_МожноЗакрытьФорму", Новый ОписаниеТипов("Булево"));
	Реквизит_тм_ПоложениеРеквизитаНаФормеВТабличнойЧасти = Новый РеквизитФормы("тм_ПоложениеРеквизитаНаФормеВТабличнойЧасти", Новый ОписаниеТипов("Булево"));
	
