
#Область ОбработчикиСобытийФормы
 
&НаСервере
Процедура тм_ПриСозданииНаСервереПосле(Отказ, СтандартнаяОбработка)
	
	тм_ДобавитьВставитьЭлементыНаФорму();
	
	тм_ДобавитьКоманды();

	//Блокировка документа от ввода данных
	тм_ЗаблокироватьРазблокироватьДокумент();
	
	тм_ОбщегоНазначенияВызовСервера.ВывестиПроизводителя(Объект.Запасы);
	
	ЭтотОбъект.тм_ПоложениеРеквизитаНаФормеВТабличнойЧасти = Объект.ПоложениеСклада = Перечисления.ПоложениеРеквизитаНаФорме.ВТабличнойЧасти;
	
КонецПроцедуры

&НаКлиенте
Процедура тм_ПриОткрытииПосле(Отказ)
		
	тм_УправлениеДоступом();
		
КонецПроцедуры

&НаСервере
Процедура тм_ПередЗаписьюНаСервереПеред(Отказ, ТекущийОбъект, ПараметрыЗаписи)
	
	тм_ПроверитьУстановкуИсполнителяРабот(Отказ);
	
КонецПроцедуры

&НаСервере
Процедура тм_ПередЗаписьюНаСервереПосле(Отказ, ТекущийОбъект, ПараметрыЗаписи)
	
	// Избавит от лишних блокировок формы
	Если Не ЗначениеЗаполнено(Параметры.Ключ) Тогда
		ТекущийОбъект.ДополнительныеСвойства.Вставить("тм_ЭтоНовыйДокумент", Истина);
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура тм_ПослеЗаписиНаСервереПосле(ТекущийОбъект, ПараметрыЗаписи)
	
	Если ТекущийОбъект.ДополнительныеСвойства.Свойство("тм_ЭтоНовыйДокумент") Тогда
		тм_ЗаблокироватьРазблокироватьДокумент();
	КонецЕсли; 
	
КонецПроцедуры

&НаКлиенте
Процедура тм_ПередЗакрытиемПеред(Отказ, ЗавершениеРаботы, ТекстПредупреждения, СтандартнаяОбработка)
	
	Если ЗавершениеРаботы Тогда
		Если Не ЭтотОбъект.тм_МожноЗакрытьФорму Тогда
			Отказ = Истина;
			СтандартнаяОбработка = Ложь;
			ТекстПредупреждения = "Нажмите <Продолжить работу> для сохранения данных! 
				|Далее <Завершить работу> после сохранения";
			ПодключитьОбработчикОжидания("тм_ЗаблокироватьРазблокироватьДокументНаКлиенте", 1, Истина);
		КонецЕсли;
	Иначе
		тм_ЗаблокироватьРазблокироватьДокумент(Ложь);
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура тм_ОткрытьЧат(Команда)

	Если Не ЗначениеЗаполнено(Параметры.Ключ) Тогда
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = "Необходимо записать документ!";
		Сообщение.Сообщить(); 
		Возврат;
	КонецЕсли; 
	
	ПараметрыФормыЧата = Новый Структура; 
	ПараметрыФормыЧата.Вставить("ИдентификаторСообщения", Строка(Объект.Ссылка.УникальныйИдентификатор())); 
	ОткрытьФорму("Обработка.тм_Чат.Форма.ФормаПросмотраСообщения", ПараметрыФормыЧата, ЭтаФорма, УникальныйИдентификатор);
	
КонецПроцедуры // СоздатьЗаказНаряд()
 
#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормы

&НаКлиенте
Процедура тм_ЗапасыПередУдалениемВместо(Элемент, Отказ)
	
	Если Не глДоступнаНастройка(тм_глПрава, "ПроверятьСтрокиПередУдалением", Истина) Тогда
		ЗапасыПередУдалением(Элемент, Отказ);
		Возврат;
	КонецЕсли;  
	
	Отказ = Истина;

	Режим = РежимДиалогаВопрос.ДаНет;	
	Описание = Новый ОписаниеОповещения("ПослеВыбораОтвета", ЭтаФорма, Элемент);
	
	ПоказатьВопрос(Описание, НСтр("ru = 'Удалить выделенные строки?'"), Режим, 10,, "Удаление строк", КодВозвратаДиалога.Нет); 
	
КонецПроцедуры

&НаКлиенте
Процедура тм_ЗапасыНоменклатураПриИзмененииПосле(Элемент)
	
	Номенклатура = Элементы.Запасы.ТекущиеДанные.Номенклатура;
	Если Не Номенклатура.Пустая() Тогда
		тм_ОбщегоНазначенияВызовСервера.ВывестиПроизводителя(Номенклатура, Элементы.Запасы.ТекущиеДанные.тм_Производитель);
		тм_УстановитьТекущегоСотрудника();
		
		Если ЭтотОбъект.тм_ПоложениеРеквизитаНаФормеВТабличнойЧасти Тогда
			Элементы.Запасы.ТекущиеДанные.СтруктурнаяЕдиницаРезерв = тм_глПрава["ОсновнойСклад"];
		КонецЕсли;
		
		// Прееопределение ставки НДС
		Если Объект.Организация = тм_глПрава["Организация_Куликова"] Тогда
			тм_СтавкаНДС20_22 = тм_СтавкаНДС20_22();
			
			Если Элементы.Запасы.ТекущиеДанные.СтавкаНДС <> тм_СтавкаНДС20_22 Тогда
				Элементы.Запасы.ТекущиеДанные.СтавкаНДС = тм_СтавкаНДС20_22;
				РассчитатьСуммуВСтрокеТабличнойЧасти();
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура тм_ЗапасыПередНачаломИзмененияПеред(Элемент, Отказ)
		
	СтрокаТабличнойЧасти = Элементы.Запасы.ТекущиеДанные;
	Если Элемент.ТекущийЭлемент = Элементы.тм_Сотрудник
		И СтрокаТабличнойЧасти.ТипНоменклатурыЗапас Тогда
		Отказ = Истина;
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Асинх Процедура тм_КонтрагентПриИзмененииПосле(Элемент)
	
	Если ЗначениеЗаполнено(Объект.Контрагент) Тогда
		
		ИнформацияОКлиенте = ПолучитьИнформациюОКлиенте(Объект.Контрагент);
		Если Не ПустаяСтрока(ИнформацияОКлиенте) Тогда
			
			ФорматированнаяСтрока = Новый ФорматированнаяСтрока(ИнформацияОКлиенте,, Новый Цвет(255, 0, 0)); 
			Ждать ПредупреждениеАсинх(ФорматированнаяСтрока,, "Обратите внимание");
			
		КонецЕсли; 
		
	КонецЕсли;
	
	тм_КонтрагентПриИзмененииНаСервере();
	
	ОрганизацияПриИзменении(Элементы.Организация);
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура СоздатьЗаказНаряд(Команда)

	Если Модифицированность 
		Или Не ЗначениеЗаполнено(Параметры.Ключ) Тогда
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = "Необходимо записать документ";
		Сообщение.Сообщить();
		Возврат;
	КонецЕсли; 
	
	ЗаказНарядСсылка = тм_СоздатьЗаказНарядНаСервере();
	Если Не ЗначениеЗаполнено(ЗаказНарядСсылка) Тогда
		Возврат;
	КонецЕсли; 
	
	ПоказатьОповещениеПользователя("Создан заказ наряд", ПолучитьНавигационнуюСсылку(ЗаказНарядСсылка), "Открыть созданный заказ-наряд"); 
	
КонецПроцедуры // СоздатьЗаказНаряд()

#КонецОбласти

#Область СлужебныеПроцедурыИФункции
 
&НаКлиенте
Процедура тм_УправлениеДоступом()
	
	Если Не тм_ОбщегоНазначенияВызовСервера.ВключенаФункциональнаяОпция("тм_ИспользованиеФункционалаЧата") Тогда	
		тм_РаботаСФормойКлиент.ОтключитьВидимостьЭлементов(ЭтотОбъект, "ФормаОбщаяКомандатм_Чат");
	КонецЕсли;
		
КонецПроцедуры 
 
