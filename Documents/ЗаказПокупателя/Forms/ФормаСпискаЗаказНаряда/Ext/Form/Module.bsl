		ЭлементЧат.КартинкаШапки = БиблиотекаКартинок.Сообщение;
		ЭлементЧат.ПоложениеЗаголовка = ПоложениеЗаголовкаЭлементаФормы.Нет;
		ЭлементЧат.КартинкаЗначений = БиблиотекаКартинок.Сообщение;
