&НаСервере
Процедура УстановитьОтборы()
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	тм_ДоступКПросмотруДокументы.Ссылка КАК Ссылка
		|ИЗ
		|	Справочник.тм_ДоступКПросмотру.Документы КАК тм_ДоступКПросмотруДокументы
		|ГДЕ
		|	тм_ДоступКПросмотруДокументы.НаименованиеДокумента ПОДОБНО &НаименованиеДокумента
		|	И тм_ДоступКПросмотруДокументы.Пользователь = &Пользователь";
	
	Запрос.УстановитьПараметр("НаименованиеДокумента", "ЗаказПокупателя");
	Запрос.УстановитьПараметр("Пользователь", Пользователи.ТекущийПользователь());
	
	РезультатЗапроса = Запрос.Выполнить();
		
	Если РезультатЗапроса.Пустой() Тогда
		ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбораДинамическогоСписка(Список, "Автор", Пользователи.ТекущийПользователь());  		
	КонецЕсли; 
	 
КонецПроцедуры // УстановитьОтборы()

&НаКлиенте
Процедура тм_ВыполнитьРасширенныйПоиск()

	Если ПустаяСтрока(ЭтотОбъект.тм_СтрокаРасширенногоПоиска) Тогда
		
		ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбораДинамическогоСписка(Список, 
			"Ссылка", Неопределено, ВидСравненияКомпоновкиДанных.ВСписке,, Ложь);
		
		Возврат;
		
	КонецЕсли;
	
	СтрокаРасширенногоПоиска = СокрЛП(ЭтотОбъект.тм_СтрокаРасширенногоПоиска);
	СтрокиПоиска = СтрРазделить(СтрокаРасширенногоПоиска, " ", Ложь);
	
	РезультатПоиска = Новый Массив;
	НомерЗапроса = 1;
	Для каждого СтрокаПоиска Из СтрокиПоиска Цикл
		тм_РезультатПоискаПоПодстроке(СтрокаПоиска, РезультатПоиска, НомерЗапроса);
		НомерЗапроса = НомерЗапроса + 1;
	КонецЦикла;
	
	ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбораДинамическогоСписка(Список,
		"Ссылка", РезультатПоиска, ВидСравненияКомпоновкиДанных.ВСписке,, Истина);
	
	ЭтотОбъект.ТекущийЭлемент = Элементы.тм_СтрокаРасширенногоПоиска;

КонецПроцедуры

&НаСервереБезКонтекста
Процедура тм_РезультатПоискаПоПодстроке(СтрокаРасширенногоПоиска, РезультатПоиска, НомерЗапроса)
	
	//МассивДокументов = Новый Массив;
	
	// АПК:96 -выкл результат должен содержать уникальные значения
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("СтрокаПоиска", "%" + СтрокаРасширенногоПоиска + "%");
	Запрос.УстановитьПараметр("ВидОперации", Перечисления.ВидыОперацийЗаказПокупателя.ЗаказНаряд);
	Запрос.УстановитьПараметр("РезультатПоиска", РезультатПоиска);
	Запрос.УстановитьПараметр("ЭтоНеПервыйЗапрос", НомерЗапроса > 1);
	
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ЗаказПокупателя.Ссылка КАК Ссылка
	|ИЗ
	|	Документ.ЗаказПокупателя КАК ЗаказПокупателя
	|ГДЕ
	|	ЗаказПокупателя.ВидОперации = &ВидОперации
	|	И ЗаказПокупателя.Номер ПОДОБНО &СтрокаПоиска
	|	И ВЫБОР
	|			КОГДА &ЭтоНеПервыйЗапрос
	|				ТОГДА ЗаказПокупателя.Ссылка В (&РезультатПоиска)
	|			ИНАЧЕ ИСТИНА
	|		КОНЕЦ
	|
	|ОБЪЕДИНИТЬ
	|
	|ВЫБРАТЬ
	|	ЗаказПокупателя.Ссылка
	|ИЗ
	|	Документ.ЗаказПокупателя КАК ЗаказПокупателя
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Контрагенты КАК Контрагенты
	|		ПО ЗаказПокупателя.Контрагент = Контрагенты.Ссылка
	|ГДЕ
	|	ЗаказПокупателя.ВидОперации = &ВидОперации
	|	И ЕСТЬNULL(Контрагенты.Наименование, """") ПОДОБНО &СтрокаПоиска
	|	И ВЫБОР
	|			КОГДА &ЭтоНеПервыйЗапрос
	|				ТОГДА ЗаказПокупателя.Ссылка В (&РезультатПоиска)
	|			ИНАЧЕ ИСТИНА
	|		КОНЕЦ
	|
	|ОБЪЕДИНИТЬ
	|
	|ВЫБРАТЬ
	|	ЗаказПокупателя.Ссылка
	|ИЗ
	|	Документ.ЗаказПокупателя КАК ЗаказПокупателя
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Контрагенты КАК Контрагенты
	|		ПО ЗаказПокупателя.Контрагент = Контрагенты.Ссылка
	|ГДЕ
	|	ЗаказПокупателя.ВидОперации = &ВидОперации
	|	И ЕСТЬNULL(Контрагенты.НаименованиеПолное, """") ПОДОБНО &СтрокаПоиска
	|	И ВЫБОР
	|			КОГДА &ЭтоНеПервыйЗапрос
	|				ТОГДА ЗаказПокупателя.Ссылка В (&РезультатПоиска)
	|			ИНАЧЕ ИСТИНА
	|		КОНЕЦ
	|
	|ОБЪЕДИНИТЬ
