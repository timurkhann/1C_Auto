#Область ОбработчикиСобытийФормы

&НаСервере
Процедура тм_ПриСозданииНаСервереПосле(Отказ, СтандартнаяОбработка)
	
	тм_ИспользоватьНовыйПоиск = тм_ОбщегоНазначения.ПредопределенныйЭлемент("ИспользоватьНовыйПоиск");
	тм_ДобавитьВставитьЭлементыНаФорму(тм_ИспользоватьНовыйПоиск);
	
	Если тм_ИспользоватьНовыйПоиск Тогда
		Элементы.Список.ПоложениеСтрокиПоиска = ПоложениеСтрокиПоиска.Нет;
	КонецЕсли;
	
КонецПроцедуры


&НаКлиенте
Процедура тм_ПриОткрытииПосле(Отказ)
	
	тм_УправлениеДоступом();

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура тм_СтрокаРасширенногоПоискаПриИзменении(Элемент)
	
	ПодключитьОбработчикОжидания("тм_ВыполнитьРасширенныйПоиск", 0.5, Истина);
	
КонецПроцедуры

&НаКлиенте
Процедура тм_СтрокаРасширенногоПоискаОчистка(Элемент, СтандартнаяОбработка)
	
	ЭтотОбъект.тм_СтрокаРасширенногоПоиска = "";
	ПодключитьОбработчикОжидания("тм_ВыполнитьРасширенныйПоиск", 0.5, Истина);
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормы

#КонецОбласти

#Область ОбработчикиКомандФормы

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Процедура тм_ДобавитьВставитьЭлементыНаФорму(тм_ИспользоватьНовыйПоиск)
	
	ОписаниеТипаСтрока = ОбщегоНазначения.ОписаниеТипаСтрока(50);
	ОписаниеТипаБулево = Новый ОписаниеТипов("Булево");
	
	Реквизит_СтрокаРасширенногоПоиска = Новый РеквизитФормы("тм_СтрокаРасширенногоПоиска", ОписаниеТипаСтрока);
	
	ДобавляемыеРеквизиты = Новый Массив;
	ДобавляемыеРеквизиты.Добавить(Реквизит_СтрокаРасширенногоПоиска);
	
	ИзменитьРеквизиты(ДобавляемыеРеквизиты);
	
	// тм_СтрокаРасширенногоПоиска
	Если тм_ИспользоватьНовыйПоиск Тогда
		ЭлементСтрокаРасширенногоПоиска = тм_ОбщегоНазначенияВызовСервера.ВставитьЭлементНаФорму(
			ЭтотОбъект,
			"тм_СтрокаРасширенногоПоиска",
			Тип("ПолеФормы"),
			ВидПоляФормы.ПолеВвода,
			Элементы.ФильтрыНастройкиИДопИнфо,
			"тм_СтрокаРасширенногоПоиска",
			Элементы.ГруппаОтборы);
			
		ЭлементСтрокаРасширенногоПоиска.ПоложениеЗаголовка = ПоложениеЗаголовкаЭлементаФормы.Нет;
		ЭлементСтрокаРасширенногоПоиска.ПодсказкаВвода = НСтр("ru = 'Поиск 2.0'");
		ЭлементСтрокаРасширенногоПоиска.КнопкаОчистки = Истина;
		
		ЭлементСтрокаРасширенногоПоиска.УстановитьДействие("ПриИзменении", "тм_СтрокаРасширенногоПоискаПриИзменении");
		ЭлементСтрокаРасширенногоПоиска.УстановитьДействие("Очистка", "тм_СтрокаРасширенногоПоискаОчистка");
	КонецЕсли;

КонецПроцедуры // тм_ДобавитьВставитьЭлементыНаФорму()

&НаКлиенте
Процедура тм_УправлениеДоступом()
	
	Если Не тм_ОбщегоНазначенияВызовСервера.ВключенаФункциональнаяОпция("тм_ИспользованиеФункционалаЧата") Тогда	
		тм_РаботаСФормойКлиент.ОтключитьВидимостьЭлементов(ЭтотОбъект, "ФормаОбщаяКомандатм_Чат");	
	КонецЕсли;
		
КонецПроцедуры 

&НаКлиенте
Процедура тм_ВыполнитьРасширенныйПоиск()

	Если ПустаяСтрока(ЭтотОбъект.тм_СтрокаРасширенногоПоиска) Тогда
		
		ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбораДинамическогоСписка(Список, 
			"Ссылка", Неопределено, ВидСравненияКомпоновкиДанных.ВСписке,, Ложь);
		
		Возврат;
		
	КонецЕсли;
	
	СтрокаРасширенногоПоиска = СокрЛП(ЭтотОбъект.тм_СтрокаРасширенногоПоиска);
	СтрокиПоиска = СтрРазделить(СтрокаРасширенногоПоиска, " ", Ложь);
	
	РезультатПоиска = Новый Массив;
	НомерЗапроса = 1;
	Для каждого СтрокаПоиска Из СтрокиПоиска Цикл
		тм_РезультатПоискаПоПодстроке(СтрокаПоиска, РезультатПоиска, НомерЗапроса);
		НомерЗапроса = НомерЗапроса + 1;
	КонецЦикла;
	
	ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбораДинамическогоСписка(Список,
		"Ссылка", РезультатПоиска, ВидСравненияКомпоновкиДанных.ВСписке,, Истина);
	
	ЭтотОбъект.ТекущийЭлемент = Элементы.тм_СтрокаРасширенногоПоиска;

КонецПроцедуры

&НаСервереБезКонтекста
Процедура тм_РезультатПоискаПоПодстроке(СтрокаРасширенногоПоиска, РезультатПоиска, НомерЗапроса)
	
	МассивДокументов = Новый Массив;
	
	// АПК:96 -выкл результат должен содержать уникальные значения
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("СтрокаПоиска", "%" + СтрокаРасширенногоПоиска + "%");
	Запрос.УстановитьПараметр("ВидОперации", Перечисления.ВидыОперацийЗаказПокупателя.ЗаказНаПродажу);
	Запрос.УстановитьПараметр("РезультатПоиска", РезультатПоиска);
	Запрос.УстановитьПараметр("ЭтоНеПервыйЗапрос", НомерЗапроса > 1);
	
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ЗаказПокупателя.Ссылка КАК Ссылка
	|ИЗ
	|	Документ.ЗаказПокупателя КАК ЗаказПокупателя
	|ГДЕ
	|	ЗаказПокупателя.ВидОперации = &ВидОперации
	|	И ЗаказПокупателя.Номер ПОДОБНО &СтрокаПоиска
	|	И ВЫБОР
	|			КОГДА &ЭтоНеПервыйЗапрос
	|				ТОГДА ЗаказПокупателя.Ссылка В (&РезультатПоиска)
	|			ИНАЧЕ ИСТИНА
	|		КОНЕЦ
	|
	|ОБЪЕДИНИТЬ
	|
	|ВЫБРАТЬ
	|	ЗаказПокупателя.Ссылка
	|ИЗ
	|	Документ.ЗаказПокупателя КАК ЗаказПокупателя
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Контрагенты КАК Контрагенты
	|		ПО ЗаказПокупателя.Контрагент = Контрагенты.Ссылка
	|ГДЕ
	|	ЗаказПокупателя.ВидОперации = &ВидОперации
	|	И ЕСТЬNULL(Контрагенты.Наименование, """") ПОДОБНО &СтрокаПоиска
	|	И ВЫБОР
	|			КОГДА &ЭтоНеПервыйЗапрос
	|				ТОГДА ЗаказПокупателя.Ссылка В (&РезультатПоиска)
	|			ИНАЧЕ ИСТИНА
	|		КОНЕЦ
	|
	|ОБЪЕДИНИТЬ
	|
	|ВЫБРАТЬ
	|	ЗаказПокупателя.Ссылка
	|ИЗ
	|	Документ.ЗаказПокупателя КАК ЗаказПокупателя
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Контрагенты КАК Контрагенты
	|		ПО ЗаказПокупателя.Контрагент = Контрагенты.Ссылка
	|ГДЕ
	|	ЗаказПокупателя.ВидОперации = &ВидОперации
	|	И ЕСТЬNULL(Контрагенты.НаименованиеПолное, """") ПОДОБНО &СтрокаПоиска
	|	И ВЫБОР
	|			КОГДА &ЭтоНеПервыйЗапрос
	|				ТОГДА ЗаказПокупателя.Ссылка В (&РезультатПоиска)
	|			ИНАЧЕ ИСТИНА
	|		КОНЕЦ
	|
	|ОБЪЕДИНИТЬ
	|
	|ВЫБРАТЬ
	|	ЗаказПокупателя.Ссылка
	|ИЗ
	|	Документ.ЗаказПокупателя КАК ЗаказПокупателя
	|ГДЕ
	|	ЗаказПокупателя.ВидОперации = &ВидОперации
	|	И ЗаказПокупателя.КонтактныйТелефон ПОДОБНО &СтрокаПоиска
	|	И ВЫБОР
	|			КОГДА &ЭтоНеПервыйЗапрос
	|				ТОГДА ЗаказПокупателя.Ссылка В (&РезультатПоиска)
	|			ИНАЧЕ ИСТИНА
	|		КОНЕЦ
	|
	|ОБЪЕДИНИТЬ
	|
	|ВЫБРАТЬ
	|	ЗаказПокупателя.Ссылка
	|ИЗ
	|	Документ.ЗаказПокупателя КАК ЗаказПокупателя
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.тм_АвтомобилиКлиентов КАК тм_АвтомобилиКлиентов
	|		ПО ЗаказПокупателя.тм_Автомобиль = тм_АвтомобилиКлиентов.Ссылка
	|ГДЕ
	|	ЗаказПокупателя.ВидОперации = &ВидОперации
	|	И ЕСТЬNULL(тм_АвтомобилиКлиентов.VIN, """") ПОДОБНО &СтрокаПоиска
	|	И ВЫБОР
	|			КОГДА &ЭтоНеПервыйЗапрос
	|				ТОГДА ЗаказПокупателя.Ссылка В (&РезультатПоиска)
	|			ИНАЧЕ ИСТИНА
	|		КОНЕЦ
	|
	|ОБЪЕДИНИТЬ
	|
	|ВЫБРАТЬ
	|	ЗаказПокупателя.Ссылка
	|ИЗ
	|	Документ.ЗаказПокупателя КАК ЗаказПокупателя
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.тм_АвтомобилиКлиентов КАК тм_АвтомобилиКлиентов
	|		ПО ЗаказПокупателя.тм_Автомобиль = тм_АвтомобилиКлиентов.Ссылка
	|ГДЕ
	|	ЗаказПокупателя.ВидОперации = &ВидОперации
	|	И ЕСТЬNULL(тм_АвтомобилиКлиентов.ГосударственныйНомер, """") ПОДОБНО &СтрокаПоиска
	|	И ВЫБОР
	|			КОГДА &ЭтоНеПервыйЗапрос
	|				ТОГДА ЗаказПокупателя.Ссылка В (&РезультатПоиска)
	|			ИНАЧЕ ИСТИНА
	|		КОНЕЦ
	|
	|ОБЪЕДИНИТЬ
	|
	|ВЫБРАТЬ
	|	ЗаказПокупателя.Ссылка
	|ИЗ
	|	Документ.ЗаказПокупателя КАК ЗаказПокупателя
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.тм_АвтомобилиКлиентов КАК тм_АвтомобилиКлиентов
	|		ПО ЗаказПокупателя.тм_Автомобиль = тм_АвтомобилиКлиентов.Ссылка
	|ГДЕ
	|	ЗаказПокупателя.ВидОперации = &ВидОперации
	|	И ЕСТЬNULL(тм_АвтомобилиКлиентов.МаркаАвто.Наименование, """") ПОДОБНО &СтрокаПоиска
	|	И ВЫБОР
	|			КОГДА &ЭтоНеПервыйЗапрос
	|				ТОГДА ЗаказПокупателя.Ссылка В (&РезультатПоиска)
	|			ИНАЧЕ ИСТИНА
	|		КОНЕЦ
	|
	|ОБЪЕДИНИТЬ
	|
	|ВЫБРАТЬ
	|	ЗаказПокупателя.Ссылка
	|ИЗ
	|	Документ.ЗаказПокупателя КАК ЗаказПокупателя
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.тм_АвтомобилиКлиентов КАК тм_АвтомобилиКлиентов
	|		ПО ЗаказПокупателя.тм_Автомобиль = тм_АвтомобилиКлиентов.Ссылка
	|ГДЕ
	|	ЗаказПокупателя.ВидОперации = &ВидОперации
	|	И ЕСТЬNULL(тм_АвтомобилиКлиентов.МодельАвто.Наименование, """") ПОДОБНО &СтрокаПоиска
	|	И ВЫБОР
	|			КОГДА &ЭтоНеПервыйЗапрос
	|				ТОГДА ЗаказПокупателя.Ссылка В (&РезультатПоиска)
	|			ИНАЧЕ ИСТИНА
	|		КОНЕЦ";
	
	РезультатПоиска.Очистить();
	
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		РезультатПоиска.Добавить(Выборка.Ссылка);
	КонецЦикла;
	
КонецПроцедуры

#КонецОбласти
