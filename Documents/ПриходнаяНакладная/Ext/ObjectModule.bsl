
#Область ОбработчикиСобытий

&После("ПриКопировании")
Процедура тм_ПриКопировании(ОбъектКопирования)
	
	ЭтотОбъект.тм_ДокументОснованиеНачисленияБонусов = Документы.РасходнаяНакладная.ПустаяСсылка();
	ЭтотОбъект.тм_ЗаявкаНаРазмещение = Неопределено;
	
КонецПроцедуры

&После("ОбработкаЗаполнения")
Процедура тм_ОбработкаЗаполнения(ДанныеЗаполнения, СтандартнаяОбработка)
	
	Если ТипЗнч(ДанныеЗаполнения) = Тип("ДокументСсылка.РасходнаяНакладная") Тогда
		ЭтотОбъект.тм_ДокументОснованиеНачисленияБонусов = ДанныеЗаполнения;
		Если ЗначениеЗаполнено(ДанныеЗаполнения.Запасы) Тогда
			ПроверитьВозможностьСозданияДокумента(ДанныеЗаполнения, ДанныеЗаполнения.Запасы);
			Если Не ЗначениеЗаполнено(Запасы) Тогда
				ВызватьИсключение НСтр("ru = 'По всем позициям был произведен возврат. Новое создание запрещено.'");
			Иначе
				ЗапретитьИзменениеТЧПриходнаяНакладнаяВозвратПокупателя = ХранилищеОбщихНастроек.Загрузить("тм_НастройкиПользователей", "ЗапретитьИзменениеТЧПриходнаяНакладнаяВозвратПокупателя");
				Если ЗапретитьИзменениеТЧПриходнаяНакладнаяВозвратПокупателя = Неопределено
					Или Не ЗапретитьИзменениеТЧПриходнаяНакладнаяВозвратПокупателя Тогда
						ХранилищеОбщихНастроек.Сохранить("тм_НастройкиПользователей", "ЗапретитьИзменениеТЧПриходнаяНакладнаяВозвратПокупателя", Истина);
				КонецЕсли; 
			КонецЕсли; 
		КонецЕсли;
	КонецЕсли; 
		
КонецПроцедуры 

&После("ОбработкаУдаленияПроведения")
Процедура тм_ОбработкаУдаленияПроведения(Отказ)
	
	тм_ОбщегоНазначенияВызовСервера.ОтменитьПроведенияДокументовСписанияБонусов(ЭтотОбъект.Ссылка);
	
КонецПроцедуры

&После("ПередЗаписью")
Процедура тм_ПередЗаписью(Отказ, РежимЗаписи, РежимПроведения)
	
	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;
	
	Если Не ЭтоНовый() Тогда
	
		Права = тм_КЭШ.ПолучитьПраваОбъекта(Метаданные().Имя, Пользователи.ТекущийПользователь());
		
		ЗначенияРеквизитовОбъекта = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Ссылка, "Проведен");
		
		Если Не Права.SA И ЗначенияРеквизитовОбъекта.Проведен Тогда
			ОбщегоНазначения.СообщитьПользователю("Документ проведен. Изменение документа невозможно!",,,, Отказ);
			Возврат;
		КонецЕсли;
		
	КонецЕсли;
	
	Если РежимЗаписи = РежимЗаписиДокумента.Проведение
		И Не ПустаяСтрока(НомерВходящегоДокумента) Тогда
		ЕстьРанееСозданныйДокумент = тм_ЕстьРанееСозданныйДокумент();
		Если ЕстьРанееСозданныйДокумент Тогда
			ОбщегоНазначения.СообщитьПользователю("Есть ранее созданный документ с данным № вх. документа ",,,, Отказ);
			Возврат;
		КонецЕсли;
	КонецЕсли;
	
	ДополнительныеСвойства.Вставить("РежимЗаписи", РежимЗаписи);
	
	Если ЭтоНовый()
		И РежимЗаписи = РежимЗаписиДокумента.Проведение
		И тм_ВыгрузитьВТСД Тогда
		
		Отказ = тм_ОбменТСД.ПроверитьКорректностьУказанияЯчейки(Ячейка);
		Если Отказ Тогда
			ОбщегоНазначения.СообщитьПользователю("Необходимо указать ячейку ""Зона приемки""");
			Возврат;
		КонецЕсли; 
		
		ДополнительныеСвойства.Вставить("СоздатьЗаявкуНаРаспределенение");
		тм_ЗаявкаНаРазмещение = Документы.тм_ЗаявкаНаРазмещение.ПолучитьСсылку();
	Иначе
		Если тм_ВыгрузитьВТСД
			И РежимЗаписи = РежимЗаписиДокумента.Проведение
			И Не тм_ОбменТСД.ВыгруженВТСД(Ссылка) Тогда
			
			Отказ = тм_ОбменТСД.ПроверитьКорректностьУказанияЯчейки(Ячейка);
			Если Отказ Тогда
				ОбщегоНазначения.СообщитьПользователю("Необходимо указать ячейку ""Зона приемки""");
				Возврат;
			КонецЕсли; 
			
			ДополнительныеСвойства.Вставить("СоздатьЗаявкуНаРаспределенение");
			тм_ЗаявкаНаРазмещение = Документы.тм_ЗаявкаНаРазмещение.ПолучитьСсылку();
		Иначе
			Если тм_ОбменТСД.ВыгруженВТСД(Ссылка) Тогда
				ОбщегоНазначения.СообщитьПользователю("Документ заявка на распределенение был ранее выгружен в ТСД");
				тм_ВыгрузитьВТСД = Истина;
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
		
КонецПроцедуры

&После("ПриЗаписи")
Процедура тм_ПриЗаписи(Отказ)
	
	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли; 
	
	Если ДополнительныеСвойства.Свойство("СоздатьЗаявкуНаРаспределенение") Тогда
		ДокументЗаявкаНаРазмещение = Документы.тм_ЗаявкаНаРазмещение.СоздатьДокумент();
		ДокументЗаявкаНаРазмещение.Заполнить(Ссылка);
		ДокументЗаявкаНаРазмещение.ДополнительныеСвойства.Вставить("ЗагрузкаИзТСД");
		
		Если Не тм_ЗаявкаНаРазмещение.Пустая() Тогда
			ДокументЗаявкаНаРазмещение.УстановитьСсылкуНового(тм_ЗаявкаНаРазмещение);
		КонецЕсли; 
		
		ДокументЗаявкаНаРазмещение.Записать();
		
		ТаблицаСвойств = Новый ТаблицаЗначений;
		ТаблицаСвойств.Колонки.Добавить("Свойство");
		ТаблицаСвойств.Колонки.Добавить("Значение");
		
		НоваяСтрока = ТаблицаСвойств.Добавить();
		НоваяСтрока.Свойство = ПланыВидовХарактеристик.ДополнительныеРеквизитыИСведения.НайтиПоРеквизиту("Имя", "ВыгруженВТСД");
		НоваяСтрока.Значение = Истина;
		
		УправлениеСвойствами.ЗаписатьСвойстваУОбъекта(Ссылка, ТаблицаСвойств);
	КонецЕсли; 

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура ПроверитьВозможностьСозданияДокумента(ДокументОснование, Запасы)

	 ТаблицаЗапасов = Запасы.Выгрузить(, "Номенклатура, Количество");
	 
	 Запрос = Новый Запрос;
	 Запрос.Текст = "ВЫБРАТЬ
		 |	ТаблицаЗапасов.Номенклатура КАК Номенклатура,
		 |	ТаблицаЗапасов.Количество КАК Количество
		 |ПОМЕСТИТЬ ВТ_Подг
		 |ИЗ
		 |	&ТаблицаЗапасов КАК ТаблицаЗапасов
		 |;
		 |
		 |////////////////////////////////////////////////////////////////////////////////
		 |ВЫБРАТЬ
		 |	ВТ_Подг.Номенклатура КАК Номенклатура,
		 |	СУММА(ВТ_Подг.Количество) КАК Количество
		 |ПОМЕСТИТЬ ВТ_Сгруппировано
		 |ИЗ
		 |	ВТ_Подг КАК ВТ_Подг
		 |
		 |СГРУППИРОВАТЬ ПО
		 |	ВТ_Подг.Номенклатура
		 |;
		 |
		 |////////////////////////////////////////////////////////////////////////////////
		 |ВЫБРАТЬ
		 |	ПриходнаяНакладнаяЗапасы.Номенклатура КАК Номенклатура,
		 |	СУММА(ПриходнаяНакладнаяЗапасы.Количество) КАК Количество
		 |ПОМЕСТИТЬ ВТ_ЗапасыСгруппировано
		 |ИЗ
		 |	Документ.ПриходнаяНакладная.Запасы КАК ПриходнаяНакладнаяЗапасы
		 |ГДЕ
		 |	ПриходнаяНакладнаяЗапасы.Ссылка.ДокументОснование = &ДокументОснование
		 |	И ПриходнаяНакладнаяЗапасы.Ссылка.Проведен
		 |
		 |СГРУППИРОВАТЬ ПО
		 |	ПриходнаяНакладнаяЗапасы.Номенклатура
		 |;
		 |
		 |////////////////////////////////////////////////////////////////////////////////
		 |ВЫБРАТЬ
		 |	ВТ_Сгруппировано.Номенклатура КАК Номенклатура,
		 |	ВТ_Сгруппировано.Количество КАК Количество,
		 |	ВТ_ЗапасыСгруппировано.Номенклатура КАК НоменклатураПрихода,
		 |	ВТ_Сгруппировано.Количество - ЕСТЬNULL(ВТ_ЗапасыСгруппировано.Количество, 0) КАК КоличествоЗаполнить
		 |ПОМЕСТИТЬ ВТ_Расчет
		 |ИЗ
		 |	ВТ_Сгруппировано КАК ВТ_Сгруппировано
		 |		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_ЗапасыСгруппировано КАК ВТ_ЗапасыСгруппировано
		 |		ПО ВТ_Сгруппировано.Номенклатура = ВТ_ЗапасыСгруппировано.Номенклатура
		 |;
		 |
		 |////////////////////////////////////////////////////////////////////////////////
		 |ВЫБРАТЬ
		 |	ВТ_Расчет.Номенклатура КАК Номенклатура,
		 |	ВТ_Расчет.Количество КАК Количество,
		 |	ВТ_Расчет.НоменклатураПрихода КАК НоменклатураПрихода,
		 |	ВТ_Расчет.КоличествоЗаполнить КАК КоличествоЗаполнить
		 |ИЗ
		 |	ВТ_Расчет КАК ВТ_Расчет
		 |ГДЕ
		 |	ВТ_Расчет.КоличествоЗаполнить > 0
		 |";
		
	Запрос.Параметры.Вставить("ТаблицаЗапасов", ТаблицаЗапасов); 
	Запрос.Параметры.Вставить("ДокументОснование", ДокументОснование);
	
	РезультатЗапроса = Запрос.Выполнить();
	Выборка = РезультатЗапроса.Выбрать();
	
	УдаленныеСтроки = Новый Массив;
	Для каждого СтрокаЗапасы Из ЭтотОбъект.Запасы Цикл
		Отбор = Новый Структура("Номенклатура", СтрокаЗапасы.Номенклатура); 
		Если Выборка.НайтиСледующий(Отбор) Тогда
			СтрокаЗапасы.Количество = Выборка.КоличествоЗаполнить;
			Выборка.Сбросить();
		Иначе
			УдаленныеСтроки.Добавить(СтрокаЗапасы);
		КонецЕсли;
	КонецЦикла;  
	
	Для каждого УдаленнаяСтрока Из УдаленныеСтроки Цикл
		ЭтотОбъект.Запасы.Удалить(УдаленнаяСтрока);
	КонецЦикла;
	
КонецПроцедуры

Функция тм_ЕстьРанееСозданныйДокумент()
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ПриходнаяНакладная.Ссылка КАК Ссылка
		|ИЗ
		|	Документ.ПриходнаяНакладная КАК ПриходнаяНакладная
		|ГДЕ           
		|	ПриходнаяНакладная.НомерВходящегоДокумента = &НомерВходящегоДокумента
		|	И ПриходнаяНакладная.Контрагент = &Контрагент
		|	И ПриходнаяНакладная.Дата МЕЖДУ &ДатаНачала И &ДатаОкончания
		|	И ПриходнаяНакладная.Проведен";
	
	Запрос.УстановитьПараметр("НомерВходящегоДокумента", НомерВходящегоДокумента);
	Запрос.УстановитьПараметр("Контрагент", Контрагент);
	Запрос.УстановитьПараметр("ДатаНачала", НачалоГода(Дата));
	Запрос.УстановитьПараметр("ДатаОкончания", КонецГода(Дата));
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Возврат Не РезультатЗапроса.Пустой();
	
КонецФункции

#КонецОбласти