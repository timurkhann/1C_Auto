
#Область ОбработчикиСобытий

Процедура ПередЗаписью(Отказ, РежимЗаписи, РежимПроведения)
	
	Если Не ДополнительныеСвойства.Свойство("ВыполняетсяЗаписьИзРегламентногоЗадания") Тогда
		ОбщегоНазначения.СообщитьПользователю(НСтр("ru = 'Интерактивная запись запрещена'"),,,, Отказ);
	КонецЕсли;
	
КонецПроцедуры

Процедура ОбработкаПроведения(Отказ, РежимПроведения)
	
	ЗаполнитьДвижения();
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура ЗаполнитьДвижения()
	
	Для каждого СтрокаНачисления Из Начисления Цикл
		
		Если СтрокаНачисления.Сумма = 0 Тогда
			Продолжить;
		КонецЕсли;
		
		Движения.тм_ЗарплатаКВыплате.Записывать = Истина;
		
		Движение = Движения.тм_ЗарплатаКВыплате.Добавить();
		Движение.ВидДвижения        = ВидДвиженияНакопления.Приход;
		Движение.Период             = Дата;
		Движение.ДокументОснование  = СтрокаНачисления.ДокументОснование;
		Движение.Сотрудник          = СтрокаНачисления.Сотрудник;
		Движение.СуммаКВыплате      = СтрокаНачисления.Сумма;
		Движение.Комментарий        = СтрокаНачисления.Комментарий;
		
	КонецЦикла;

КонецПроцедуры

#КонецОбласти


