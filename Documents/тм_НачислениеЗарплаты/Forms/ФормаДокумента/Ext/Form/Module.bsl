#Область ОбработчикиСобытийФормы

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	ИтогоОбщее = Объект.Начисления.Итог("Сумма");
	Элементы.НачисленияСумма.ТекстПодвала = СтрШаблон("По документу: %1", ИтогоОбщее);
	
	ПодключитьОбработчикОжидания("ПосчитатьИтогиНажатие", 1);
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаКлиенте
Процедура ПосчитатьИтогиНажатие() Экспорт
	
	СуммаНаФорме = 0;
	
	Для Каждого Строка Из Объект.Начисления Цикл
		ИдентификаторСтроки = Строка.ПолучитьИдентификатор();
		Если Элементы.Начисления.ПроверитьСтроку(ИдентификаторСтроки) = Истина тогда
			СуммаНаФорме = СуммаНаФорме + Строка.Сумма;
		КонецЕсли;
	КонецЦикла;
	
	Если СуммаНаФорме = ИтогоОбщее Тогда
		ТекстПодвала = СтрШаблон("По документу: %1", ИтогоОбщее);
	Иначе
		ТекстПодвала = СтрШаблон("По отбору: %1", СуммаНаФорме);
	КонецЕсли;
	
	Элементы.НачисленияСумма.ТекстПодвала = ТекстПодвала;
	
КонецПроцедуры

#КонецОбласти
