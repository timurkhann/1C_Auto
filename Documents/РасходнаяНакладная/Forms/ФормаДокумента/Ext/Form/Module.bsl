Процедура тм_ПроверитьУстановитьСкладПользователя()
	
	ТекущиеДанные = Элементы.Запасы.ТекущиеДанные;
	Если ЗначениеЗаполнено(ТекущиеДанные.Номенклатура) Тогда
		Если ТекущиеДанные.СтруктурнаяЕдиница <> ЭтотОбъект.тм_ОсновнойСкладПользователя Тогда
			ТекущиеДанные.СтруктурнаяЕдиница = ЭтотОбъект.тм_ОсновнойСкладПользователя;
			ТекущиеДанные.Ячейка = тм_ЯчейкаНоменклатуры(ТекущиеДанные.Номенклатура, ТекущиеДанные.СтруктурнаяЕдиница);
		КонецЕсли;
	КонецЕсли;

КонецПроцедуры

