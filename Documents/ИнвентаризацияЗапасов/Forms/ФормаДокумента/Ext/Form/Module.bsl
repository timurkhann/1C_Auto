
#Область ОбработчикиСобытийФормы

&НаСервере
Процедура тм_ПриСозданииНаСервереПосле(Отказ, СтандартнаяОбработка)
	
	ДобавитьВставитьЭлементыНаФорму();
	
	ЗаполнитьРеквизитыПоУмолчанию();
	
КонецПроцедуры

&НаСервере
Процедура тм_ПослеЗаписиНаСервереПосле(ТекущийОбъект, ПараметрыЗаписи)
	
	ЗаполнитьРеквизитыПоУмолчанию();
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормы

&НаКлиенте
Процедура тм_ЗапасыНоменклатураПриИзмененииПосле(Элемент)
	
	Номенклатура = Элементы.Запасы.ТекущиеДанные.Номенклатура;
	Если Не Номенклатура.Пустая() Тогда                                        
		тм_ОбщегоНазначенияВызовСервера.ВывестиПроизводителя(Номенклатура, Элементы.Запасы.ТекущиеДанные.тм_Производитель);
		ВывестиАртикулВТабличнуюЧасть(Номенклатура, Элементы.Запасы.ТекущиеДанные.тм_Артикул);
		ВывестиРезервВТабличнуюЧасть(Номенклатура, Элементы.Запасы.ТекущиеДанные.тм_Резерв);	
	КонецЕсли;                                    

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

#КонецОбласти

#Область СлужебныеПроцедурыИФункции
 
&НаСервере
Процедура ДобавитьВставитьЭлементыНаФорму()
	
	#Область Производитель
	
	ДобавляемыеРеквизиты = Новый Массив;                   
		
    Реквизит_тм_Производитель = Новый РеквизитФормы("тм_Производитель", Новый ОписаниеТипов("Строка",,,, Новый КвалификаторыСтроки(50)), "Объект.Запасы", "Производитель");
	
    ДобавляемыеРеквизиты.Добавить(Реквизит_тм_Производитель);
	
    ИзменитьРеквизиты(ДобавляемыеРеквизиты);		
		
	ЭлементПроизводитель = тм_ОбщегоНазначенияВызовСервера.ВставитьЭлементНаФорму(ЭтаФорма, 
		"Производитель",                                                                                  	
		Тип("ПолеФормы"),
		ВидПоляФормы.ПолеВвода,
		ЭтаФорма.Элементы.Запасы,
		"Объект.Запасы.тм_Производитель", Элементы.ЗапасыХарактеристика); 
		
	ЭлементПроизводитель.Заголовок = "Производитель";	
	ЭлементПроизводитель.Доступность = Ложь;	
	
	#КонецОбласти 
	
	#Область Артикул
	
	ДобавляемыеРеквизиты = Новый Массив;                   
		
    Реквизит_тм_Артикул = Новый РеквизитФормы("тм_Артикул", Новый ОписаниеТипов("Строка",,,, Новый КвалификаторыСтроки(50)), "Объект.Запасы", "Артикул");
	
    ДобавляемыеРеквизиты.Добавить(Реквизит_тм_Артикул);
	
    ИзменитьРеквизиты(ДобавляемыеРеквизиты);		
		
	ЭлементАртикул = тм_ОбщегоНазначенияВызовСервера.ВставитьЭлементНаФорму(ЭтаФорма, 
		"Артикул",                                                                                  	
		Тип("ПолеФормы"),
		ВидПоляФормы.ПолеВвода,
		ЭтаФорма.Элементы.Запасы,
		"Объект.Запасы.тм_Артикул", Элементы.Производитель); 
		
	ЭлементАртикул.Заголовок = "Артикул";	
	ЭлементАртикул.Доступность = Истина;
	
	#КонецОбласти 
	
	#Область Резерв
	
	ДобавляемыеРеквизиты = Новый Массив;                   
		
    Реквизит_Резерв = Новый РеквизитФормы("тм_Резерв", Новый ОписаниеТипов("Число",,, Новый КвалификаторыЧисла(15, 3)), "Объект.Запасы", "Резерв");
	
    ДобавляемыеРеквизиты.Добавить(Реквизит_Резерв);
	
    ИзменитьРеквизиты(ДобавляемыеРеквизиты);		
		
	ЭлементРезерв = тм_ОбщегоНазначенияВызовСервера.ВставитьЭлементНаФорму(ЭтаФорма, 
		"Резерв",                                                                                  	
		Тип("ПолеФормы"),
		ВидПоляФормы.ПолеВвода,
		ЭтаФорма.Элементы.Запасы,
		"Объект.Запасы.тм_Резерв", Элементы.ЗапасыКоличествоУчет); 
		
	ЭлементРезерв.Заголовок = "Резерв";	
	ЭлементРезерв.Доступность = Истина;
	
	#КонецОбласти 
		
КонецПроцедуры // ДобавитьВставитьЭлементыНаФорму()

&НаСервере
Процедура ЗаполнитьРеквизитыПоУмолчанию()

	тм_ОбщегоНазначенияВызовСервера.ВывестиПроизводителя(Объект.Запасы);
	ВывестиАртикулВТабличнуюЧасть();
	ВывестиРезервВТабличнуюЧасть();

КонецПроцедуры // ЗаполнитьРеквизитыПоУмолчанию()

&НаСервере
Процедура ВывестиАртикулВТабличнуюЧасть(Номенклатура = Неопределено, Артикул = Неопределено)

	Если Номенклатура <> Неопределено Тогда
		Артикул = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Номенклатура, "Артикул");
		Возврат;
	КонецЕсли; 
	
	СписокПозиций = Объект.Запасы.Выгрузить().ВыгрузитьКолонку("Номенклатура");
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	Номенклатура.Ссылка КАК Ссылка,
		|	Номенклатура.Ссылка КАК Артикул		
		|ИЗ
		|	Справочник.Номенклатура КАК Номенклатура
		|ГДЕ
		|	Номенклатура.Ссылка В(&СписокПозиций)";
	
	Запрос.УстановитьПараметр("СписокПозиций", СписокПозиций);
	
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "Номенклатура.Ссылка КАК Артикул", "Номенклатура.Артикул КАК Артикул");
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Выборка = РезультатЗапроса.Выбрать();
	
	Пока Выборка.Следующий() Цикл
		ИскомыеСтроки = Объект.Запасы.НайтиСтроки(Новый Структура("Номенклатура", Выборка.Ссылка));	
		Если ИскомыеСтроки.Количество() Тогда
			Для каждого ИскомаяСтрока Из ИскомыеСтроки Цикл
				ИскомаяСтрока.тм_Артикул = Выборка.Артикул;
			КонецЦикла;  
		КонецЕсли; 
	КонецЦикла;

КонецПроцедуры // ВывестиАртикулВТабличнуюЧасть()

&НаСервере
Процедура ВывестиРезервВТабличнуюЧасть(Номенклатура = Неопределено, Резерв = Неопределено)

	Если Номенклатура <> Неопределено Тогда
		СтруктураДанных = Новый Структура("Организация, Характеристика, СтруктурнаяЕдиница, Номенклатура", Номенклатура, Справочники.ХарактеристикиНоменклатуры.ПустаяСсылка()); 
		СтруктураДанных.Организация 		= Объект.Организация;
		СтруктураДанных.СтруктурнаяЕдиница 	= Объект.СтруктурнаяЕдиница;
		
		Резерв = тм_ОбщегоНазначенияВызовСервера.ПолучитьОстатокРезерва(СтруктураДанных);
		Возврат;
	КонецЕсли; 
	
	Товары = Объект.Запасы.Выгрузить(, "Номенклатура, Характеристика");
	Товары.Колонки.Добавить("Организация", Новый ОписаниеТипов("СправочникСсылка.Организации"));
	Товары.Колонки.Добавить("СтруктурнаяЕдиница", Новый ОписаниеТипов("СправочникСсылка.СтруктурныеЕдиницы"));
	Товары.ЗаполнитьЗначения(Объект.Организация, "Организация");
	Товары.ЗаполнитьЗначения(Объект.СтруктурнаяЕдиница, "СтруктурнаяЕдиница");
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	Товары.Номенклатура КАК Номенклатура,
		|	Товары.Характеристика КАК Характеристика,
		|	Товары.Организация КАК Организация,
		|	Товары.СтруктурнаяЕдиница КАК СтруктурнаяЕдиница
		|ПОМЕСТИТЬ ВТ_Товары
		|ИЗ
		|	&Товары КАК Товары
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ВТ_Товары.Номенклатура КАК Номенклатура,
		|	ЕСТЬNULL(ОстаткиТоваров.Резерв, 0) КАК Резерв
		|ИЗ
		|	ВТ_Товары КАК ВТ_Товары
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ОстаткиТоваров КАК ОстаткиТоваров
		|		ПО ВТ_Товары.Номенклатура = ОстаткиТоваров.Номенклатура
		|			И ВТ_Товары.Характеристика = ОстаткиТоваров.Характеристика
		|			И ВТ_Товары.Организация = ОстаткиТоваров.Организация
		|			И ВТ_Товары.СтруктурнаяЕдиница = ОстаткиТоваров.СтруктурнаяЕдиница
		|";
	Запрос.Параметры.Вставить("Товары", Товары); 			
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Выборка = РезультатЗапроса.Выбрать();
	
	Пока Выборка.Следующий() Цикл
		ИскомыеСтроки = Объект.Запасы.НайтиСтроки(Новый Структура("Номенклатура", Выборка.Номенклатура));	
		Если ИскомыеСтроки.Количество() Тогда
			Для каждого ИскомаяСтрока Из ИскомыеСтроки Цикл
				ИскомаяСтрока.тм_Резерв = Выборка.Резерв;
			КонецЦикла;  
		КонецЕсли; 
	КонецЦикла;

КонецПроцедуры // ВывестиАртикулВТабличнуюЧасть()

#КонецОбласти 