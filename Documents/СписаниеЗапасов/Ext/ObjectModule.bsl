#Область ОбработчикиСобытий

&После("ПередЗаписью")
Процедура тм_ПередЗаписью(Отказ, РежимЗаписи, РежимПроведения)
	
	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли; 
	
	Права = тм_КЭШ.ПолучитьПраваОбъекта(Метаданные().Имя, Пользователи.ТекущийПользователь());
	
	Если (РежимЗаписи = РежимЗаписиДокумента.Проведение) И (Не Права.SA) Тогда
		ОбщегоНазначения.СообщитьПользователю("Проведение документа запрещено! Недостаточно прав!",,,, Отказ);
	КонецЕсли; 
	
КонецПроцедуры

#КонецОбласти
