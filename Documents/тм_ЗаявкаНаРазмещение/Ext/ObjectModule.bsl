
#Область ОбработчикиСобытий

Процедура ОбработкаЗаполнения(ДанныеЗаполнения, ТекстЗаполнения, СтандартнаяОбработка)

	Если ТипЗнч(ДанныеЗаполнения) = Тип("ДокументСсылка.ПриходнаяНакладная")
		Или ТипЗнч(ДанныеЗаполнения) = Тип("ДокументСсылка.ОприходованиеЗапасов") Тогда
		ЭтотОбъект.ДокументОснование = ДанныеЗаполнения;
		ЭтотОбъект.Комментарий = "Создан на основание документа " + ДанныеЗаполнения; 
		ЭтотОбъект.Дата = ТекущаяДатаСеанса();
		ЭтотОбъект.СтруктурнаяЕдиница = ДанныеЗаполнения.СтруктурнаяЕдиница;
		
		ЗапасыОбъектаЗаполнения = ДанныеЗаполнения.Запасы.Выгрузить();
		ЗапасыОбъектаЗаполнения.Свернуть("Номенклатура", "Количество");
		
		ЭтотОбъект.Запасы.Загрузить(ЗапасыОбъектаЗаполнения);
		Для каждого СтрокаТаблицы Из ЭтотОбъект.Запасы Цикл
			СтрокаТаблицы.Ячейка = ДанныеЗаполнения.Ячейка;
		КонецЦикла;
	Иначе
		ВызватьИсключение "Создание документов можно только на основании документов!";
	КонецЕсли; 
	
	ЭтотОбъект.Автор = ПараметрыСеанса.ТекущийПользователь;

КонецПроцедуры

Процедура ПриКопировании(ОбъектКопирования)
	
	ЭтотОбъект.Комментарий = Неопределено;
	ЭтотОбъект.Автор = Неопределено;
	ЭтотОбъект.ДокументОснование = Неопределено;

КонецПроцедуры

Процедура ПередЗаписью(Отказ, РежимЗаписи, РежимПроведения)
	
	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;

	Права = тм_КЭШ.ПолучитьПраваОбъекта(Метаданные().Имя, Пользователи.ТекущийПользователь());

	Если Не ДополнительныеСвойства.Свойство("ЗагрузкаИзТСД")
		И Не Права.SA Тогда
		ОбщегоНазначения.СообщитьПользователю("Запись возможна только из ТСД",,,, Отказ);
	КонецЕсли;
	
	Если ДополнительныеСвойства.Свойство("СоздатьДокументПеремещениеПоЯчейкам") Тогда
		ПеремещениеПоЯчейкам = Документы.ПеремещениеПоЯчейкам.ПолучитьСсылку();
	КонецЕсли; 
	
КонецПроцедуры

Процедура ПередУдалением(Отказ)
	
	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;
	
	ОбщегоНазначения.СообщитьПользователю("Удаление объекта запрещено",,,, Отказ);
	
КонецПроцедуры

Процедура ПриЗаписи(Отказ)
	
	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;
	
	Если ЗаполненВТСД
		И ДополнительныеСвойства.Свойство("СоздатьДокументПеремещениеПоЯчейкам") Тогда
		СоздатьДокументПеремещениеПоЯчейкам();
	КонецЕсли; 
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура СоздатьДокументПеремещениеПоЯчейкам()

	Документ = Документы.ПеремещениеПоЯчейкам.СоздатьДокумент();
	Документ.Заполнить(Неопределено);
	Документ.СтруктурнаяЕдиница = СтруктурнаяЕдиница;
	Документ.Ячейка = ДокументОснование.Ячейка;
	Документ.Дата = ТекущаяДатаСеанса();
	Документ.ВидОперации = Перечисления.ВидыОперацийПеремещениеПоЯчейкам.ИзОднойВНесколько;
	Документ.Комментарий  = СтрШаблон("Создан на основании документа <%1>", Ссылка);
	
	Для каждого СтрокаТаблицы Из Запасы Цикл
		НоваяСтрока = Документ.Запасы.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаТаблицы,, "Количество");
		НоваяСтрока.ЕдиницаИзмерения = СтрокаТаблицы.Номенклатура.ЕдиницаИзмерения; 
		НоваяСтрока.Количество = СтрокаТаблицы.КоличествоФакт;
	КонецЦикла;
	
	Если Не ПеремещениеПоЯчейкам.Пустая() Тогда
		Документ.УстановитьСсылкуНового(ПеремещениеПоЯчейкам);
	КонецЕсли; 
	
	Документ.Записать(РежимЗаписиДокумента.Проведение);

КонецПроцедуры

#КонецОбласти

#Область Инициализация

#КонецОбласти

