#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда
	
#Область ОбработчикиСобытий
	
&После("ПередЗаписью")
Процедура тм_ПередЗаписью(Отказ, РежимЗаписи, РежимПроведения)
	
	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;
	
	Если Не ЭтоНовый() Тогда
		Права = тм_КЭШ.ПолучитьПраваОбъекта(Метаданные().Имя, Пользователи.ТекущийПользователь());	
		
		ПроведеноПеремещение = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Ссылка, "Проведен");
		
		Если Не Права.SA И ПроведеноПеремещение Тогда
			ОбщегоНазначения.СообщитьПользователю(НСтр("ru = 'Документ проведен. Изменение документа невозможно!'"),,,, Отказ);
			Возврат;
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти


#КонецЕсли