
#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура Декорация1Нажатие(Элемент)
	
	Если Объект.Сотрудник.Пустая() Тогда
		ПоказатьПредупреждение(, "Выберите сотрудника!");
		Возврат;
	КонецЕсли;
	
	СуммаКВыплатеОстаток = ПолучитьДоступнуюСуммуВыплатыСотруднику(Объект.Сотрудник);
	
	ЗаголовокДоступнойСуммы = Новый Массив;
	ЗаголовокДоступнойСуммы.Добавить("Доступно к выплате - ");
	ЗаголовокДоступнойСуммы.Добавить(Новый ФорматированнаяСтрока(Строка(СуммаКВыплатеОстаток),, WebЦвета.Зеленый));
	
	Элементы.Декорация1.Заголовок = Новый ФорматированнаяСтрока(ЗаголовокДоступнойСуммы);
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервереБезКонтекста
Функция ПолучитьДоступнуюСуммуВыплатыСотруднику(Сотрудник)
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	тм_ЗарплатаКВыплатеОстатки.СуммаКВыплатеОстаток КАК СуммаКВыплатеОстаток
		|ИЗ
		|	РегистрНакопления.тм_ЗарплатаКВыплате.Остатки(, Сотрудник = &Сотрудник) КАК тм_ЗарплатаКВыплатеОстатки";
	
	Запрос.УстановитьПараметр("Сотрудник", Сотрудник);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Выборка = РезультатЗапроса.Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка.СуммаКВыплатеОстаток;
	Иначе
		Возврат 0;
	КонецЕсли;
	
КонецФункции // ПолучитьДоступнуюСуммуВыплатыСотруднику()

#КонецОбласти 

