
#Область ОбработчикиСобытий

Процедура ОбработкаЗаполнения(ДанныеЗаполнения, ТекстЗаполнения, СтандартнаяОбработка)
	
	Автор = Пользователи.ТекущийПользователь();
	
КонецПроцедуры

Процедура ПриКопировании(ОбъектКопирования)
	
	Автор = Пользователи.ТекущийПользователь();
	
КонецПроцедуры

Процедура ОбработкаПроведения(Отказ, Режим)
	
	ЗаполнитьДвижения(Отказ);

КонецПроцедуры

Процедура ЗаполнитьДвижения(Отказ)

	Блокировка = Новый БлокировкаДанных;
	ЭлементБлокировки = Блокировка.Добавить("РегистрНакопления.тм_ЗарплатаКВыплате");
	ЭлементБлокировки.Режим = РежимБлокировкиДанных.Исключительный;
	ЭлементБлокировки.УстановитьЗначение("Сотрудник", Сотрудник);
	Блокировка.Заблокировать();
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	тм_ЗарплатаКВыплатеОстатки.ДокументОснование КАК ДокументОснование,
		|	тм_ЗарплатаКВыплатеОстатки.СуммаКВыплатеОстаток КАК СуммаКВыплатеОстаток
		|ИЗ
		|	РегистрНакопления.тм_ЗарплатаКВыплате.Остатки(, Сотрудник = &Сотрудник) КАК тм_ЗарплатаКВыплатеОстатки
		|
		|УПОРЯДОЧИТЬ ПО
		|	тм_ЗарплатаКВыплатеОстатки.ДокументОснование.МоментВремени
		|ИТОГИ
		|	СУММА(СуммаКВыплатеОстаток)
		|ПО
		|	ОБЩИЕ";
	
	Запрос.УстановитьПараметр("Сотрудник", Сотрудник);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Если РезультатЗапроса.Пустой() Тогда
		ТекстСообщения = НСтр("ru = 'Нет суммы к выплате сотруднику!'");
		ОбщегоНазначения.СообщитьПользователю(ТекстСообщения,,,, Отказ);
		Возврат;
	КонецЕсли;
	
	ВыборкаОбщийИтог = РезультатЗапроса.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	
	ВыборкаОбщийИтог.Следующий(); // Общий итог
	
	Если Сумма > ВыборкаОбщийИтог.СуммаКВыплатеОстаток Тогда
		ТекстСообщения = СтрШаблон("Не хватает суммы выплаты. Допустимая сумма = %1", ВыборкаОбщийИтог.СуммаКВыплатеОстаток);
		ОбщегоНазначения.СообщитьПользователю(ТекстСообщения,,,, Отказ);
		Возврат;
	КонецЕсли;
	
	Движения.тм_ЗарплатаКВыплате.Записывать = Истина;
	
	ОсталосьКВыплате = Сумма;
	
	Выборка = ВыборкаОбщийИтог.Выбрать();
	
	Пока Выборка.Следующий() И ОсталосьКВыплате <> 0 Цикл
		Выплачено = Мин(ОсталосьКВыплате, Выборка.СуммаКВыплатеОстаток);
		
		Движение = Движения.тм_ЗарплатаКВыплате.ДобавитьРасход();
		Движение.Период = Дата;
		Движение.Сотрудник = Сотрудник;
		Движение.ДокументОснование = Выборка.ДокументОснование;
		Движение.СуммаКВыплате = Выплачено;
		Движение.Комментарий = Комментарий;
		
		ОсталосьКВыплате = ОсталосьКВыплате - Выплачено;
	КонецЦикла;
	
КонецПроцедуры

#КонецОбласти
 