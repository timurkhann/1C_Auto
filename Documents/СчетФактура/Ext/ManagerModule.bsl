#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

&ИзменениеИКонтроль("ПодготовитьДанныеДляПечатиКорректировочныхСчетовФактур")
Функция тм_ПодготовитьДанныеДляПечатиКорректировочныхСчетовФактур(ДокументОснование, СчетФактура, ВидСчетаФактуры, ИспользуетсяПостановлениеНДС1137)

	ДанныеДляПечати = Новый Структура;

	Если ТипЗнч(ДокументОснование) = Тип("ДокументСсылка.КорректировкаПоступления") Тогда
		КонтрагентРезидентТаможенногоСоюза = Справочники.Контрагенты.КонтрагентРезидентТаможенногоСоюза(
		ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ДокументОснование, "Контрагент"));
		Если КонтрагентРезидентТаможенногоСоюза Тогда

			ДанныеДляПечати.Вставить("Реквизиты", Неопределено);
			ДанныеДляПечати.Вставить("ТаблицаДокумента", Неопределено);

			Возврат ДанныеДляПечати;

		КонецЕсли;
	КонецЕсли;

	Если ТипЗнч(СчетФактура) = Тип("ДокументСсылка.СчетФактураПолученный") 
		И ТипЗнч(ДокументОснование) = Тип("ДокументСсылка.РасходнаяНакладная")
		И ВидСчетаФактуры = Перечисления.ВидыОперацийСчетФактураПолученный.Корректировка Тогда

		ДанныеДляПечати.Вставить("Реквизиты", Неопределено);
		ДанныеДляПечати.Вставить("ТаблицаДокумента", Неопределено);

		Возврат ДанныеДляПечати;

	КонецЕсли;

	ПоддерживаютсяАкцизы = ТипЗнч(ДокументОснование) = Тип("ДокументСсылка.ПриходнаяНакладная") Или ТипЗнч(
	ДокументОснование) = Тип("ДокументСсылка.КорректировкаРеализации");

	ПредставлениеПоставщика = "";
	АдресПоставщика         = "";
	ИННКПППоставщика        = "";

	ВалютаРеглУчета = Константы.НациональнаяВалюта.Получить();

	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ВалютаРеглУчета", ВалютаРеглУчета);
	Запрос.УстановитьПараметр("ДокументОснование", ДокументОснование);
	Запрос.УстановитьПараметр("СчетФактура", СчетФактура);
	Запрос.УстановитьПараметр("ВидСчетаФактуры", ВидСчетаФактуры);
	Запрос.УстановитьПараметр("ТекстБезАкциза", ?(ИспользуетсяПостановлениеНДС1137, "без акциза", ""));
	Запрос.УстановитьПараметр("ИспользуетсяПостановлениеНДС1137", ИспользуетсяПостановлениеНДС1137);
	Запрос.УстановитьПараметр("ПустоеПодразделение", Неопределено);
	Запрос.УстановитьПараметр("ПредставлениеПоставщика", ПредставлениеПоставщика);
	Запрос.УстановитьПараметр("АдресПоставщика", АдресПоставщика);
	Запрос.УстановитьПараметр("ИННКПППоставщика", ИННКПППоставщика);
	Если ТипЗнч(ДокументОснование) = Тип("ДокументСсылка.КорректировкаПоступления") Тогда
		ИсправляемыйДокументРеализации = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ДокументОснование,
		"ИсправляемыйДокументПоступления");
	ИначеЕсли ТипЗнч(ДокументОснование) = Тип("ДокументСсылка.КорректировкаРеализации") Тогда
		ИсправляемыйДокументРеализации = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ДокументОснование,
		"ИсправляемыйДокументРеализации");
	ИначеЕсли ТипЗнч(ДокументОснование) = Тип("ДокументСсылка.ПриходнаяНакладная") Тогда
		ИсправляемыйДокументРеализации = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ДокументОснование,
		"ДокументОснование");
		Запрос.УстановитьПараметр("ДатаОснования", Новый Граница(ДокументОснование.МоментВремени(), ВидГраницы.Включая));
		Запрос.УстановитьПараметр("Регистратор", ДокументОснование);
	Иначе
		ИсправляемыйДокументРеализации = Неопределено;
	КонецЕсли;

	НомераТаблиц = Новый Структура;

	ЭтоОтчетКомиссионера = ТипЗнч(ДокументОснование) = Тип("ДокументСсылка.ОтчетКомиссионера");
	Если ЭтоОтчетКомиссионера Тогда

		ЗапросТаблицаПокупатели = Новый Запрос;
		ЗапросТаблицаПокупатели.УстановитьПараметр("СсылкаНаДокумент", ДокументОснование);
		ЗапросТаблицаПокупатели.Текст =
		"ВЫБРАТЬ
		|	ОтчетКомиссионераПокупатели.КлючСвязи КАК КлючСвязи,
		|	ОтчетКомиссионераПокупатели.ОтчетКомиссионера КАК ОтчетКомиссионера,
		|	ОтчетКомиссионераПокупатели.СчетФактура КАК СчетФактура
		|ИЗ
		|	Документ.ОтчетКомиссионера.Покупатели КАК ОтчетКомиссионераПокупатели
		|ГДЕ
		|	ОтчетКомиссионераПокупатели.Ссылка = &СсылкаНаДокумент";

		ТаблицаПокупатели = ЗапросТаблицаПокупатели.Выполнить().Выгрузить();

		ПараметрыПоиска = Новый Структура("СчетФактура", СчетФактура);
		НайденныеСтроки = ТаблицаПокупатели.НайтиСтроки(ПараметрыПоиска);

		Если НайденныеСтроки.Количество() Тогда
			Запрос.УстановитьПараметр("КлючСвязи", НайденныеСтроки[0].КлючСвязи);
			Запрос.УстановитьПараметр("ИсправляемыйДокументРеализации", НайденныеСтроки[0].ОтчетКомиссионера);
		Иначе
			Запрос.УстановитьПараметр("КлючСвязи", 0);
			Запрос.УстановитьПараметр("ИсправляемыйДокументРеализации", Неопределено);
		КонецЕсли;
	Иначе
		Запрос.УстановитьПараметр("ИсправляемыйДокументРеализации", ИсправляемыйДокументРеализации);
	КонецЕсли;

	Запрос.Текст = Документы[ДокументОснование.Метаданные().Имя].ТекстЗапросаДанныеДляПечатиКорректировочныхСчетовФактур(НомераТаблиц);

	ДополнениеЗапроса = ?(ПоддерживаютсяАкцизы, ТекстЗапросаДанныеДляПечатиКорректировочныхСчетовФактурСАкцизами(НомераТаблиц)
	, ?(ЭтоОтчетКомиссионера, ТекстЗапросаДанныеДляПечатиКорректировочныхСчетовФактурОтчетКомиссионераВозвраты(НомераТаблиц)
	, ТекстЗапросаДанныеДляПечатиКорректировочныхСчетовФактур(НомераТаблиц)));

	Запрос.Текст = Запрос.Текст + ДополнениеЗапроса;

	Если Не ТипЗнч(ДокументОснование) = Тип("ДокументСсылка.КорректировкаРеализации") Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "ТаблицаДокумента.НоменклатураНабора КАК НоменклатураНабора,", "");
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "ТаблицаДокумента.ХарактеристикаНабора КАК ХарактеристикаНабора,", "");

		Запрос.Текст = СтрЗаменить(Запрос.Текст, "ТаблицаДокумента.НомерГТДДоИзменения КАК НомерГТДДоИзменения,", "");
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "ТаблицаДокумента.СтранаПроисхожденияДоИзменения КАК СтранаПроисхожденияДоИзменения,", "");
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "СтраныМира1.Код КАК СтранаПроисхожденияКодДоИзменения,", "");
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "ЛЕВОЕ СОЕДИНЕНИЕ Справочник.СтраныМира КАК СтраныМира1", "");
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "ПО ТаблицаДокумента.СтранаПроисхожденияДоИзменения = СтраныМира1.Ссылка", "");

	КонецЕсли;
	#Вставка
	ТекстЗамены = Новый Соответствие;
	ТекстЗамены.Вставить("// Замена.Документ.РасходнаяНакладная КАК РасходнаяНакладная", "Документ.РасходнаяНакладная КАК РасходнаяНакладная");
	Если ТипЗнч(ДокументОснование) = Тип("ДокументСсылка.ПриходнаяНакладная") Тогда
		ДокументОснованиеПН = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ДокументОснование, "ДокументОснование");
		Если ТипЗнч(ДокументОснованиеПН) = Тип("ДокументСсылка.ЗаказПокупателя") Тогда
			ТекстЗамены.Вставить("// Замена.Документ.РасходнаяНакладная КАК РасходнаяНакладная", "Документ.ЗаказПокупателя КАК РасходнаяНакладная");
		КонецЕсли;
	КонецЕсли;
	Для каждого СтрокаЗамены Из ТекстЗамены Цикл
		Запрос.Текст = СтрЗаменить(Запрос.Текст, СтрокаЗамены.Ключ, СтрокаЗамены.Значение);
	КонецЦикла;
	#КонецВставки

	Результат = Запрос.ВыполнитьПакет();

	Если Результат[НомераТаблиц.Реквизиты].Пустой() Или Результат[НомераТаблиц.ТаблицаДокумента].Пустой() Тогда

		ДанныеДляПечати.Вставить("Реквизиты", Неопределено);
		ДанныеДляПечати.Вставить("ТаблицаДокумента", Неопределено);

		Возврат ДанныеДляПечати;

	КонецЕсли;

	Если ТипЗнч(ДокументОснование) = Тип("ДокументСсылка.ОтчетКомиссионера") Тогда
		ТаблицаПокупатели = Результат[НомераТаблиц.ВременнаяТаблицаПокупатели].Выгрузить();
	Иначе
		ТаблицаПокупатели = Новый ТаблицаЗначений;
	КонецЕсли;

	ТаблицаРеквизиты = Результат[НомераТаблиц.Реквизиты].Выгрузить();
	ТаблицаДокумента = Результат[НомераТаблиц.ТаблицаДокумента].Выгрузить();
	ТаблицаСведенияПрослеживаемости = Результат[НомераТаблиц.ТаблицаСведенияПрослеживаемости].Выгрузить();
	ТаблицаСведенияПрослеживаемостиДоИзменения = Результат[НомераТаблиц.ТаблицаСведенияПрослеживаемостиДоИзменения].Выгрузить();

	Если ТипЗнч(ДокументОснование) = Тип("ДокументСсылка.КорректировкаРеализации") Тогда
		ДанныеОбъектовПечати = Новый ТаблицаЗначений;
		ДанныеОбъектовПечати.Колонки.Добавить("ТаблицаЗапасы");
		ДанныеОбъектовПечати.Колонки.Добавить("ТаблицаДобавленныеНаборы");
		СтрокаОбъектаПечати = ДанныеОбъектовПечати.Добавить();
		СтрокаОбъектаПечати.ТаблицаЗапасы = ТаблицаДокумента;
		СтрокаОбъектаПечати.ТаблицаДобавленныеНаборы = ПодготовленнаяТаблицаНаборов(ДокументОснование);

		// Наборы
		НаборыСервер.КомпоноватьТабличнуюЧастьПоНаборамДокументыКорректировки(ДанныеОбъектовПечати, "ТаблицаЗапасы");
	КонецЕсли;

	ОснованиеПриходнаяНакладная = ТипЗнч(ДокументОснование) = Тип("ДокументСсылка.ПриходнаяНакладная");

	Для Каждого СтрокаДокумента Из ТаблицаДокумента Цикл

		Если Не ЗначениеЗаполнено(СтрокаДокумента.НаименованиеЕдиницыИзмерения) Тогда
			СтрокаДокумента.КоличествоДоИзменения    = 0;
			СтрокаДокумента.КоличествоПослеИзменения = 0;
			СтрокаДокумента.ЦенаДоИзменения          = 0;
			СтрокаДокумента.ЦенаПослеИзменения       = 0;
		Иначе
			Если СтрокаДокумента.КоличествоДоИзменения = 0 Тогда
				СтрокаДокумента.ЦенаДоИзменения = 0;
			ИначеЕсли СтрокаДокумента.ЦенаДоИзменения = 0 Тогда
				СтрокаДокумента.ЦенаДоИзменения = Окр(СтрокаДокумента.СтоимостьБезНДСДоИзменения
				/ СтрокаДокумента.КоличествоДоИзменения, 2);
			КонецЕсли;
			Если СтрокаДокумента.КоличествоПослеИзменения = 0 И Не ОснованиеПриходнаяНакладная Тогда
				СтрокаДокумента.ЦенаПослеИзменения = 0;
			ИначеЕсли СтрокаДокумента.ЦенаПослеИзменения = 0 И Не ОснованиеПриходнаяНакладная Тогда
				СтрокаДокумента.ЦенаПослеИзменения = Окр(СтрокаДокумента.СтоимостьБезНДСПослеИзменения
				/ СтрокаДокумента.КоличествоПослеИзменения, 2);
			КонецЕсли;
			Если СтрокаДокумента.КоличествоДоИзменения = 0 И СтрокаДокумента.КоличествоПослеИзменения = 0 Тогда
				СтрокаДокумента.НаименованиеЕдиницыИзмерения = "";
			КонецЕсли;
		КонецЕсли;

	КонецЦикла;

	ДанныеДляПечати.Вставить("Реквизиты", ТаблицаРеквизиты);
	ДанныеДляПечати.Вставить("ТаблицаДокумента", ТаблицаДокумента);
	ДанныеДляПечати.Вставить("ТаблицаСведенияПрослеживаемости", ТаблицаСведенияПрослеживаемости);
	ДанныеДляПечати.Вставить("ТаблицаСведенияПрослеживаемостиДоИзменения", ТаблицаСведенияПрослеживаемостиДоИзменения);
	ДанныеДляПечати.Вставить("ТаблицаПокупатели", ТаблицаПокупатели);

	Возврат ДанныеДляПечати;

КонецФункции

#КонецЕсли
