
#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура Перенести(Команда)
	
	Если Не ПроверитьЗаполнение() Тогда
		Возврат;
	КонецЕсли; 
	
	Адрес = ПолучитьАдресВоВременномХранилище();
	ОповеститьОВыборе(Адрес);
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Функция ПолучитьАдресВоВременномХранилище()

	ПараметрыПередачи = Новый Структура;
	ПараметрыПередачи.Вставить("Автомобиль", Автомобиль);
	ПараметрыПередачи.Вставить("Работа", Работа);
	ПараметрыПередачи.Вставить("РаботыИЦены", КузоваЦены.Выгрузить());
	
	Возврат ПоместитьВоВременноеХранилище(ПараметрыПередачи, УникальныйИдентификатор);

КонецФункции // ПолучитьАдресВоВременномХранилище()

#КонецОбласти
