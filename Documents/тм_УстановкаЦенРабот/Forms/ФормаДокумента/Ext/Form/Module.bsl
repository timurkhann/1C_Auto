
#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Права = тм_КЭШ.ПолучитьПраваОбъекта(Метаданные.Документы.тм_УстановкаЦенРабот.Имя, Пользователи.ТекущийПользователь());
	
	Если Не Права.Чтение Тогда
		ОбщегоНазначения.СообщитьПользователю(НСтр("ru = 'Недостаточно прав на чтение'"),,,, Отказ);
		Возврат;
	КонецЕсли; 
	
	УстановитьВидимость();
	УстановитьПараметрыВыбора();
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаВыбора(ВыбранноеЗначение, ИсточникВыбора)
	
	Если ИсточникВыбора.ИмяФормы = "Документ.тм_УстановкаЦенРабот.Форма.ФормаДобавления" Тогда
		ЗаполнитьРаботы(ВыбранноеЗначение);
	КонецЕсли;
	
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура МножественноеДобавлениеПоТипуКузова(Команда)
	
	ОткрытьФорму("Документ.тм_УстановкаЦенРабот.Форма.ФормаДобавления",, ЭтотОбъект,,,,, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Процедура УстановитьВидимость()

	Если Объект.СозданАвтоматически Тогда
		ЭтотОбъект.ТолькоПросмотр = Истина;
	КонецЕсли; 

КонецПроцедуры // УстановитьВидимость()

&НаСервере
Процедура УстановитьПараметрыВыбора()

	// Не удается указать данный параметр на форме.
	// Пришлось указать данный параметр программно
	
	НовыйМассив = Новый Массив();
	НовыйМассив.Добавить(Перечисления.ТипыНоменклатуры.Работа);
	НовыеЗначения = Новый ФиксированныйМассив(НовыйМассив);
	
	НовыйПараметр = Новый ПараметрВыбора("Отбор.ТипНоменклатуры", НовыеЗначения);
	
	НовыйМассив = Новый Массив();
	НовыйМассив.Добавить(НовыйПараметр);
	
	НовыеПараметры = Новый ФиксированныйМассив(НовыйМассив);
	
	Элементы.РаботыРабота.ПараметрыВыбора = НовыеПараметры;

КонецПроцедуры // УстановитьПараметрыВыбора()

&НаКлиенте
Процедура РаботыПередОкончаниемРедактирования(Элемент, НоваяСтрока, ОтменаРедактирования, Отказ)
	
	ТекущиеДанные = Элемент.ТекущиеДанные;
	Если ЗначениеЗаполнено(ТекущиеДанные.Автомобиль)
		И Не ЗначениеЗаполнено(ТекущиеДанные.ТипКузова) Тогда
		
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = НСтр("ru = 'Укажите тип кузова или очистите поле автомобиль!'");
		Сообщение.Поле = ОбщегоНазначенияКлиентСервер.ПутьКТабличнойЧасти("Объект.Работы", ТекущиеДанные.НомерСтроки, "ТипКузова");
		Сообщение.УстановитьДанные(Объект);
		Сообщение.Сообщить();
		
	КонецЕсли; 
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьРаботы(Адрес)
	
	ДанныеЗаполнения = ПолучитьИзВременногоХранилища(Адрес);
	
	Если ТипЗнч(ДанныеЗаполнения) = Тип("Структура")
		И ДанныеЗаполнения.Свойство("РаботыИЦены")
		И ДанныеЗаполнения.РаботыИЦены.Количество() Тогда
		
		Для каждого СтрокаТаблицы Из ДанныеЗаполнения.РаботыИЦены Цикл
			НоваяСтрокаРабот = Объект.Работы.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрокаРабот, ДанныеЗаполнения);
			ЗаполнитьЗначенияСвойств(НоваяСтрокаРабот, СтрокаТаблицы);
		КонецЦикла;  
		
	КонецЕсли; 

КонецПроцедуры
 
#КонецОбласти 