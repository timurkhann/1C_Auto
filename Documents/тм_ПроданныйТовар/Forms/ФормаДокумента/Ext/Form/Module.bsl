&НаСервереБезКонтекста
Функция КлючСтрокиЗапасов(Документ, Номенклатура, Склад)
	
	Возврат Строка(Документ) + "|" + Строка(Номенклатура) + "|" + Строка(Склад);
	
КонецФункции 

&НаСервере
Процедура СоздатьКолонкиСкладов()
	
	Склады = СкладыДляКолонок();
	Если Склады.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	ТипКоличество = Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(15, 3));
	
	// Служебная таблица формы: склад <-> имена его колонок.
	// Понадобится следующим шагам: Заполнить, запись, чтение.
	ДобавляемыеРеквизиты = Новый Массив;
	ДобавляемыеРеквизиты.Добавить(Новый РеквизитФормы("СкладыМатрица", Новый ОписаниеТипов("ТаблицаЗначений")));
	ДобавляемыеРеквизиты.Добавить(Новый РеквизитФормы("Склад", Новый ОписаниеТипов("СправочникСсылка.СтруктурныеЕдиницы"), "СкладыМатрица"));
	ДобавляемыеРеквизиты.Добавить(Новый РеквизитФормы("Наименование", Новый ОписаниеТипов("Строка"), "СкладыМатрица"));
	ДобавляемыеРеквизиты.Добавить(Новый РеквизитФормы("КолонкаОстаток", Новый ОписаниеТипов("Строка"), "СкладыМатрица"));
	ДобавляемыеРеквизиты.Добавить(Новый РеквизитФормы("КолонкаРезерв", Новый ОписаниеТипов("Строка"), "СкладыМатрица"));
	
	Для Каждого СтрокаСклада Из Склады Цикл
		Ключ = КлючСклада(СтрокаСклада.Склад);
		ДобавляемыеРеквизиты.Добавить(Новый РеквизитФормы("Ост_" + Ключ, ТипКоличество, "Объект.Запасы", "Остаток"));
		ДобавляемыеРеквизиты.Добавить(Новый РеквизитФормы("Рез_" + Ключ, ТипКоличество, "Объект.Запасы", "Резерв"));
	КонецЦикла;
	
	ИзменитьРеквизиты(ДобавляемыеРеквизиты);
	
	// Элементы создаём только после добавления реквизитов.
	Для Каждого СтрокаСклада Из Склады Цикл
		
		Ключ = КлючСклада(СтрокаСклада.Склад);
		
		НоваяСтрока = ЭтотОбъект["СкладыМатрица"].Добавить();
		НоваяСтрока.Склад          = СтрокаСклада.Склад;
		НоваяСтрока.Наименование   = СтрокаСклада.Наименование;
		НоваяСтрока.КолонкаОстаток = "Ост_" + Ключ;
		НоваяСтрока.КолонкаРезерв  = "Рез_" + Ключ;
		
		Группа = Элементы.Добавить("ГрСклад_" + Ключ, Тип("ГруппаФормы"), Элементы.Запасы);
		Группа.Вид = ВидГруппыФормы.ГруппаКолонок;
		Группа.Заголовок = СтрокаСклада.Наименование;
		Группа.ОтображатьВШапке = Истина;
		Группа.Группировка = ГруппировкаКолонок.Горизонтальная;
		Группа.ШрифтЗаголовка = Новый Шрифт(,, Истина);
		
		Колонка = Элементы.Добавить(НоваяСтрока.КолонкаОстаток, Тип("ПолеФормы"), Группа);
		Колонка.Вид = ВидПоляФормы.ПолеВвода;
		Колонка.ПутьКДанным = "Объект.Запасы." + НоваяСтрока.КолонкаОстаток;
		Колонка.Заголовок = "Остаток";
		
		Если СтрокаСклада.ЭтоОсновнойСклад Тогда
			Колонка = Элементы.Добавить(НоваяСтрока.КолонкаРезерв, Тип("ПолеФормы"), Группа);
			Колонка.Вид = ВидПоляФормы.ПолеВвода;
			Колонка.ПутьКДанным = "Объект.Запасы." + НоваяСтрока.КолонкаРезерв;
			Колонка.Заголовок = "Резерв";
		КонецЕсли; 
		
	КонецЦикла;
	
КонецПроцедуры

// Набор складов для колонок. Повторяет действующее бизнес-правило базы:
// склад участвует, если у структурной единицы заполнен доп. реквизит
// "тм_ОсновныеСклады" (именно так сейчас определяются DaCar и Express).
// Один запрос, наименования берём здесь, чтобы не читать их в цикле.
&НаСервереБезКонтекста
Функция СкладыДляКолонок()
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ТипСтруктурнойЕдиницы", Перечисления.ТипыСтруктурныхЕдиниц.Склад);
	Запрос.Текст =
		"ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	СтруктурныеЕдиницы.Ссылка КАК Склад,
		|	СтруктурныеЕдиницы.Наименование КАК Наименование,
		|	ЕСТЬNULL(СтруктурныеЕдиницыДополнительныеРеквизиты.Значение, Ложь) КАК ЭтоОсновнойСклад
		|ИЗ
		|	Справочник.СтруктурныеЕдиницы КАК СтруктурныеЕдиницы
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.СтруктурныеЕдиницы.ДополнительныеРеквизиты КАК СтруктурныеЕдиницыДополнительныеРеквизиты
		|		ПО (СтруктурныеЕдиницы.Ссылка = СтруктурныеЕдиницыДополнительныеРеквизиты.Ссылка)
		|			И (СтруктурныеЕдиницыДополнительныеРеквизиты.Свойство.Имя = ""тм_ОсновныеСклады"")
		|ГДЕ
		|	НЕ СтруктурныеЕдиницы.ПометкаУдаления
		|	И СтруктурныеЕдиницы.ТипСтруктурнойЕдиницы = &ТипСтруктурнойЕдиницы
		|
		|УПОРЯДОЧИТЬ ПО
		|	Наименование";
	
	Возврат Запрос.Выполнить().Выгрузить();
	
КонецФункции

// Имя реквизита/элемента формы должно быть допустимым идентификатором,
// поэтому GUID склада очищаем от дефисов. Имена стабильны между сеансами —
// на них завяжем Заполнить, запись и чтение данных по складам.
&НаСервереБезКонтекста
Функция КлючСклада(Склад)
	
	Возврат СтрЗаменить(Строка(Склад.УникальныйИдентификатор()), "-", "");
	
КонецФункции

&НаСервереБезКонтекста
Функция ПродажиЗаДень(ДатаПроданныхТоваров)
	
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		|	тм_ПроданныеТоварыОбороты.Регистратор КАК Документ,
		|	тм_ПроданныеТоварыОбороты.Номенклатура КАК Номенклатура,
		|	тм_ПроданныеТоварыОбороты.Номенклатура.Артикул КАК Артикул,
		|	тм_ПроданныеТоварыОбороты.Склад КАК Склад,
		|	тм_ПроданныеТоварыОбороты.КоличествоОборот КАК Количество
		|ПОМЕСТИТЬ вт_подг
		|ИЗ
		|	РегистрНакопления.тм_ПроданныеТовары.Обороты(&НачПериода, &КонПериода, Регистратор) КАК тм_ПроданныеТоварыОбороты
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	вт_подг.Документ КАК Документ,
		|	вт_подг.Номенклатура КАК Номенклатура,
		|	вт_подг.Артикул КАК Артикул,
		|	вт_подг.Склад КАК Склад,
		|	вт_подг.Количество КАК Количество,
		|	ЕСТЬNULL(НоменклатураДополнительныеРеквизиты.Значение, """") КАК Производитель
		|ПОМЕСТИТЬ вт_производитель
		|ИЗ
		|	вт_подг КАК вт_подг
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Номенклатура.ДополнительныеРеквизиты КАК НоменклатураДополнительныеРеквизиты
		|		ПО вт_подг.Номенклатура = НоменклатураДополнительныеРеквизиты.Ссылка
		|			И (НоменклатураДополнительныеРеквизиты.Свойство = &Свойство)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	вт_производитель.Документ КАК Документ,
		|	вт_производитель.Номенклатура КАК Номенклатура,
		|	вт_производитель.Артикул КАК Артикул,
		|	вт_производитель.Склад КАК Склад,
		|	вт_производитель.Количество КАК Количество,
		|	вт_производитель.Производитель КАК Производитель,
		|	ВЫБОР
		|		КОГДА вт_производитель.Документ ССЫЛКА Документ.РасходнаяНакладная
		|			ТОГДА ВЫБОР
		|					КОГДА вт_производитель.Документ.Заказ = ЗНАЧЕНИЕ(Документ.ЗаказПокупателя.)
		|						ТОГДА ЛОЖЬ
		|					ИНАЧЕ ИСТИНА
		|				КОНЕЦ
		|		ИНАЧЕ ВЫБОР
		|				КОГДА вт_производитель.Документ.Комментарий ПОДОБНО ""%"" + ""#Создан документом заказ покупателя"" + ""%""
		|					ТОГДА ИСТИНА
		|				ИНАЧЕ ЛОЖЬ
		|			КОНЕЦ
		|	КОНЕЦ КАК ЕстьОснование,
		|	ВЫБОР
		|		КОГДА вт_производитель.Документ ССЫЛКА Документ.СписаниеЗапасов
		|			ТОГДА ИСТИНА
		|		ИНАЧЕ ЛОЖЬ
		|	КОНЕЦ КАК ЭтоСписаниеЗапасов
		|ИЗ
		|	вт_производитель КАК вт_производитель";
	
	Запрос.УстановитьПараметр("НачПериода", НачалоДня(ДатаПроданныхТоваров));
	Запрос.УстановитьПараметр("КонПериода", КонецДня(ДатаПроданныхТоваров));
	Запрос.УстановитьПараметр("Свойство", ПланыВидовХарактеристик.тм_ПредопределенныеЭлементы.Производитель.Значение);
	
	Результат = Запрос.Выполнить();
	Если Результат.Пустой() Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Возврат Результат.Выгрузить();
	
КонецФункции

&НаКлиенте
Процедура ОбновитьИтогиПодвала()
	
	Если Объект.Запасы.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	Для Каждого СтрокаСклада Из ЭтотОбъект["СкладыМатрица"] Цикл
		
		КолонкаОстаток = Элементы.Найти(СтрокаСклада.КолонкаОстаток);
		КолонкаРезерв  = Элементы.Найти(СтрокаСклада.КолонкаРезерв);
		
		Если КолонкаОстаток = Неопределено И КолонкаРезерв = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		
		СуммаОстаток = 0;
		СуммаРезерв  = 0;
		
		Для Каждого СтрокаЗапасов Из Объект.Запасы Цикл
			СуммаОстаток = СуммаОстаток + СтрокаЗапасов[СтрокаСклада.КолонкаОстаток];
			СуммаРезерв  = СуммаРезерв  + СтрокаЗапасов[СтрокаСклада.КолонкаРезерв];
		КонецЦикла;
		
		КолонкаОстаток.ТекстПодвала = Формат(СуммаОстаток, "ЧДЦ=3");
		Если КолонкаРезерв <> Неопределено Тогда
			КолонкаРезерв.ТекстПодвала  = Формат(СуммаРезерв, "ЧДЦ=3");
		КонецЕсли; 
		
	КонецЦикла;
	
КонецПроцедуры


#КонецОбласти 
