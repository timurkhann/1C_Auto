		Возврат;
	КонецЕсли;
	
	//КартаЗаписей = Новый Соответствие;
	//Для Каждого Запись Из Объект.Запасы Цикл
	//	КартаЗаписей.Вставить(КлючСтрокиЗапасов(Запись.Документ, Запись.Номенклатура, Запись.Склад), Запись);
	//КонецЦикла;
	
	//Для Каждого СтрокаЗапасов Из Объект.Запасы Цикл
	//	Для Каждого СтрокаСклада Из ЭтотОбъект["СкладыМатрица"] Цикл
	//		
	//		Запись = КартаЗаписей.Получить(
	//			КлючСтрокиЗапасов(СтрокаЗапасов.Документ, СтрокаЗапасов.Номенклатура, СтрокаСклада.Склад));
	//		
	//		Если Запись <> Неопределено Тогда
	//			СтрокаЗапасов[СтрокаСклада.КолонкаОстаток] = Запись.Остаток;
	//			СтрокаЗапасов[СтрокаСклада.КолонкаРезерв]  = Запись.Резерв;
	//		КонецЕсли;
	//		
	//	КонецЦикла;
	//КонецЦикла;
	//КартаЗаписей = Новый Соответствие;
	ТаблицаЗапасы = Объект.Запасы.Выгрузить();
	Объект.Запасы.Очистить();
	//
	//Для Каждого Запись Из ТаблицаЗапасы Цикл
	//	КартаЗаписей.Вставить(КлючСтрокиЗапасов(Запись.Документ, Запись.Номенклатура, Запись.Склад), Запись);
	//КонецЦикла;
	
	Для Каждого СтрокаЗапасов Из ТаблицаЗапасы Цикл
		
		
		Отбор = Новый Структура("Документ, Номенклатура, Артикул, Количество, Производитель, ЕстьОснование, ЭтоСписаниеЗапасов, Цена");
		ЗаполнитьЗначенияСвойств(Отбор, СтрокаЗапасов);
		
		ИскомыеСтроки = Объект.Запасы.НайтиСтроки(Отбор);
		Если ИскомыеСтроки.Количество() Тогда
			//СтрокаОбъекта = ИскомыеСтроки[0];
			Продолжить;
