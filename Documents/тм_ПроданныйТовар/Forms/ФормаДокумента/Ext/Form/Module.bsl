
#Область ОбработчикиСобытийФормы

&НаСервере

Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	СоздатьКолонкиСкладов();       // из предыдущего шага
	ЗаполнитьКолонкиИзДокумента(); // новый шаг: данные из ТЧ Запасы
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	ОбновитьИтогиПодвала();
КонецПроцедуры

&НаСервере
Процедура ПередЗаписьюНаСервере(Отказ, ТекущийОбъект, ПараметрыЗаписи)
	СохранитьОстаткиПоСкладамВДокумент(ТекущийОбъект);
КонецПроцедуры

&НаСервере
Процедура ПослеЗаписиНаСервере(ТекущийОбъект, ПараметрыЗаписи)
	ЗаполнитьКолонкиИзДокумента();
КонецПроцедуры

&НаКлиенте
Процедура Заполнить(Команда)
	
	Если Не ЗначениеЗаполнено(Объект.ДатаПроданныхТоваров) Тогда
		ПоказатьПредупреждение(, "Не заполнена дата проданных товаров");
		Возврат;
	КонецЕсли;
	
	ЗаполнитьНаСервере();
	ОбновитьИтогиПодвала();
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормы

&НаСервере
Процедура ЗаполнитьНаСервере()
	
	Если ЭтотОбъект["СкладыМатрица"].Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	Продажи = ПродажиЗаДень(Объект.ДатаПроданныхТоваров);
	Если Продажи = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Номенклатуры       = Новый Массив;
	ДокументыПродаж    = Новый Массив;
	
	Для Каждого СтрокаПродаж Из Продажи Цикл
		Если Номенклатуры.Найти(СтрокаПродаж.Номенклатура) = Неопределено Тогда
			Номенклатуры.Добавить(СтрокаПродаж.Номенклатура);
		КонецЕсли;
		Если ДокументыПродаж.Найти(СтрокаПродаж.Документ) = Неопределено Тогда
			ДокументыПродаж.Добавить(СтрокаПродаж.Документ);
		КонецЕсли;
	КонецЦикла;
	
	Склады = Новый Массив;
	Для Каждого СтрокаСклада Из ЭтотОбъект["СкладыМатрица"] Цикл
		Склады.Добавить(СтрокаСклада.Склад);
	КонецЦикла;
	
	КартаОстатков = ОстаткиПоСкладамКарта(Номенклатуры, Склады);
	КартаЦен      = ЦеныПродажиКарта(ДокументыПродаж);
	
	Объект.Запасы.Очистить();
	
	ИдентификаторыУдаления = Новый Массив;
	
	Для Каждого СтрокаПродаж Из Продажи Цикл
		
		НоваяСтрока = Объект.Запасы.Добавить();
		НоваяСтрока.Документ           = СтрокаПродаж.Документ;
		НоваяСтрока.Номенклатура       = СтрокаПродаж.Номенклатура;
		НоваяСтрока.Артикул            = СтрокаПродаж.Артикул;
		НоваяСтрока.Количество         = СтрокаПродаж.Количество;
		НоваяСтрока.Производитель      = СтрокаПродаж.Производитель;
		НоваяСтрока.ЕстьОснование      = СтрокаПродаж.ЕстьОснование;
		НоваяСтрока.ЭтоСписаниеЗапасов = СтрокаПродаж.ЭтоСписаниеЗапасов;
		НоваяСтрока.Склад              = СтрокаПродаж.Склад;
		
		Цена = КартаЦен.Получить(Строка(СтрокаПродаж.Документ) + "|" + Строка(СтрокаПродаж.Номенклатура));
		НоваяСтрока.Цена = ?(Цена = Неопределено, 0, Цена);
		
		// Основные колонки Остаток/Резерв = остаток склада, с которого была продажа строки.
		ОстаткиСклада = КартаОстатков.Получить(Строка(СтрокаПродаж.Номенклатура) + "|" + Строка(СтрокаПродаж.Склад));
		Если ОстаткиСклада = Неопределено Тогда
			НоваяСтрока.Остаток = 0;
			НоваяСтрока.Резерв  = 0;
		Иначе
			НоваяСтрока.Остаток = ОстаткиСклада.Остаток;
			НоваяСтрока.Резерв  = ОстаткиСклада.Резерв;
		КонецЕсли;
		
		ЕстьОстаток = Ложь;
		
		// Матрица по всем складам базы -> динамические колонки.
		Для Каждого СтрокаСклада Из ЭтотОбъект["СкладыМатрица"] Цикл
			
			ОстаткиСклада = КартаОстатков.Получить(
				Строка(СтрокаПродаж.Номенклатура) + "|" + Строка(СтрокаСклада.Склад));
			
			Если ОстаткиСклада = Неопределено Тогда
				НоваяСтрока[СтрокаСклада.КолонкаОстаток] = 0;
				НоваяСтрока[СтрокаСклада.КолонкаРезерв]  = 0;
			Иначе
				НоваяСтрока[СтрокаСклада.КолонкаОстаток] = ОстаткиСклада.Остаток;
				НоваяСтрока[СтрокаСклада.КолонкаРезерв]  = ОстаткиСклада.Резерв;
				ЕстьОстаток = Истина;
			КонецЕсли;
			
		КонецЦикла;
		
		Если Не ЕстьОстаток Тогда
			ИдентификаторыУдаления.Добавить(НоваяСтрока.ПолучитьИдентификатор());
		КонецЕсли;
		
	КонецЦикла;
	
	Для каждого ИдентификаторУдаления Из ИдентификаторыУдаления Цикл
		ДанныеФормыЭлементКоллекции = Объект.Запасы.НайтиПоИдентификатору(ИдентификаторУдаления);
		Объект.Запасы.Удалить(ДанныеФормыЭлементКоллекции);
	КонецЦикла; 
	
	Модифицированность = Истина;
	
КонецПроцедуры  

&НаСервереБезКонтекста
Функция ЦеныПродажиКарта(ДокументыПродаж)
	
	Карта = Новый Соответствие;
	
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		|	Запасы.Ссылка КАК Документ,
		|	Запасы.Номенклатура КАК Номенклатура,
		|	МАКСИМУМ(Запасы.Цена) КАК Цена
		|ИЗ
		|	Документ.РасходнаяНакладная.Запасы КАК Запасы
		|ГДЕ
		|	Запасы.Ссылка В (&Документы)
		|СГРУППИРОВАТЬ ПО
		|	Запасы.Ссылка,
		|	Запасы.Номенклатура
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	Запасы.Ссылка,
		|	Запасы.Номенклатура,
		|	МАКСИМУМ(Запасы.Цена)
		|ИЗ
		|	Документ.ЗаказПокупателя.Запасы КАК Запасы
		|ГДЕ
		|	Запасы.Ссылка В (&Документы)
		|СГРУППИРОВАТЬ ПО
		|	Запасы.Ссылка,
		|	Запасы.Номенклатура";
	
	Запрос.УстановитьПараметр("Документы", ДокументыПродаж);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Карта.Вставить(Строка(Выборка.Документ) + "|" + Строка(Выборка.Номенклатура), Выборка.Цена);
	КонецЦикла;
	
	Возврат Карта;
	
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьЗаголовокСвернутогоОтображения(Форма, НазваниеГруппы, ДинамическиеПараметры)
	
	Заголовок = Новый Массив;
	
	Для Каждого Параметр Из ДинамическиеПараметры Цикл
		Заголовок.Добавить(Параметр);
	КонецЦикла;
	
	Если Заголовок.Количество() > 0 Тогда
		Форма.Элементы[НазваниеГруппы].Заголовок = СтрСоединить(Заголовок, " / ");
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ДатаПроданныхТоваровПриИзменении(Элемент)

КонецПроцедуры

&НаКлиенте
Процедура СкладПриИзменении(Элемент)
	
	ДинамическиеПараметры = Новый Массив;
	ДинамическиеПараметры.Добавить("Отбор:");
	
	Если ЗначениеЗаполнено(Объект.Склад) Тогда
		ДинамическиеПараметры.Добавить(Строка(Объект.Склад));
	КонецЕсли; 
	
	Если ЗначениеЗаполнено(Объект.ДатаПроданныхТоваров) Тогда
		ДинамическиеПараметры.Добавить(Формат(Объект.ДатаПроданныхТоваров, "ДФ=yyyy-MM-dd"));
	КонецЕсли; 

	УстановитьЗаголовокСвернутогоОтображения(ЭтотОбъект, "ГруппаОтбор", ДинамическиеПараметры);

КонецПроцедуры

&НаСервереБезКонтекста
Функция ОстаткиПоСкладамКарта(Номенклатуры, Склады)
	
	Карта = Новый Соответствие;
	
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		|	ОстаткиТоваров.Номенклатура КАК Номенклатура,
		|	ОстаткиТоваров.СтруктурнаяЕдиница КАК Склад,
		|	ОстаткиТоваров.Количество КАК Остаток,
		|	ОстаткиТоваров.Резерв КАК Резерв
		|ИЗ
		|	РегистрСведений.ОстаткиТоваров КАК ОстаткиТоваров
		|ГДЕ
		|	ОстаткиТоваров.Номенклатура В(&Номенклатуры)
		|	И ОстаткиТоваров.СтруктурнаяЕдиница В(&Склады)";
	
	Запрос.УстановитьПараметр("Номенклатуры", Номенклатуры);
	Запрос.УстановитьПараметр("Склады", Склады);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Карта.Вставить(
			Строка(Выборка.Номенклатура) + "|" + Строка(Выборка.Склад),
			Новый Структура("Остаток, Резерв", Выборка.Остаток, Выборка.Резерв));
	КонецЦикла;
	
	Возврат Карта;
	
КонецФункции

// Сворачивает матрицу динамических колонок формы в ТЧ Запасы.
// Пишем только ненулевые пары Остаток/Резерв: при открытии отсутствие записи
// означает 0, а таблица документа не раздувается строками × склады.
&НаСервере
Процедура СохранитьОстаткиПоСкладамВДокумент(ТекущийОбъект)
	
	Если ЭтотОбъект["СкладыМатрица"].Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	ТекущийОбъект.Запасы.Очистить();
	
	Для Каждого СтрокаЗапасов Из Объект.Запасы Цикл
		Для Каждого СтрокаСклада Из ЭтотОбъект["СкладыМатрица"] Цикл
			
			Остаток = СтрокаЗапасов[СтрокаСклада.КолонкаОстаток];
			Резерв  = СтрокаЗапасов[СтрокаСклада.КолонкаРезерв];
			
			Если Остаток = 0 И Резерв = 0 Тогда
				Продолжить;
			КонецЕсли;
			
			НоваяЗапись = ТекущийОбъект.Запасы.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяЗапись, СтрокаЗапасов,, "Склад");
			НоваяЗапись.Склад         = СтрокаСклада.Склад;
			НоваяЗапись.Остаток       = Остаток;
			НоваяЗапись.Резерв        = Резерв;
			
		КонецЦикла;
	КонецЦикла;
	
КонецПроцедуры

// Раскладывает сохранённые в документе значения по динамическим колонкам.
// Без поиска в цикле: сначала один проход по ТЧ в карту-соответствие.
