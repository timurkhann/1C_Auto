
&НаСервереБезКонтекста
&Вместо("ДеревоНастроекЗначениеПриИзмененииНаСервере")
Процедура тм_ДеревоНастроекЗначениеПриИзмененииНаСервере(Знач Настройка, Знач ЗначениеНастройки, Знач Пользователь)
	
	РеквизитыНастройки = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Настройка, "Родитель, Родитель.Наименование, Наименование");
	
	ЭтоНастройкаDaCar = Ложь;
	Если ЗначениеЗаполнено(РеквизитыНастройки.Родитель)
		И РеквизитыНастройки.РодительНаименование = "DaCar" Тогда
		ИмяНастройки = РеквизитыНастройки.Наименование;
		ЭтоНастройкаDaCar = Истина;
	Иначе
		ИмяНастройки = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Настройка, "ИмяПредопределенныхДанных");
	КонецЕсли;
	
	тм_ПерсональныеНастройкиУНФ.Установить(ЗначениеНастройки, ИмяНастройки, Пользователь,, ЭтоНастройкаDaCar);
	
КонецПроцедуры
