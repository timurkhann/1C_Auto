#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	УстановитьУО();
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	УстановитьЗаголовокДекорации("Данные не актуальны");
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура СотрудникПриИзменении(Элемент)
	
	ТекстЗаголовка = "Данные актуальны на " + Формат(ТекущаяДата(), "ДЛФ=T");
	УстановитьЗаголовокДекорации(ТекстЗаголовка);
	
	ЗаполнитьНаСервере();
	
КонецПроцедуры

&НаКлиенте
Процедура СостояниеПриИзменении(Элемент)
	
	ТекстЗаголовка = "Данные актуальны на " + Формат(ТекущаяДата(), "ДЛФ=T");
	УстановитьЗаголовокДекорации(ТекстЗаголовка);

	ЗаполнитьНаСервере();
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормы

&НаКлиенте
Процедура Свернуть(Команда)
	
	ЭлементыДерева = ДанныеПоСотрудникам.ПолучитьЭлементы();
	Для каждого ЭлементДерева Из ЭлементыДерева Цикл
		Элементы.ДанныеПоСотрудникам.Свернуть(ЭлементДерева.ПолучитьИдентификатор());
	КонецЦикла;

КонецПроцедуры

&НаКлиенте
Процедура Развернуть(Команда)
	
	ЭлементыДерева = ДанныеПоСотрудникам.ПолучитьЭлементы();
	Для каждого ЭлементДерева Из ЭлементыДерева Цикл
		Элементы.ДанныеПоСотрудникам.Развернуть(ЭлементДерева.ПолучитьИдентификатор());
	КонецЦикла;
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура Заполнить(Команда)
	
	ТекстЗаголовка = "Данные актуальны на " + Формат(ТекущаяДата(), "ДЛФ=T");
	УстановитьЗаголовокДекорации(ТекстЗаголовка);
	
	ЗаполнитьНаСервере();
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Процедура УстановитьУО()
	
	Перем ОформляемоеПоле, ЭлементОтбора, ЭлементОформления;
	
	ЭлементОформления = УсловноеОформление.Элементы.Добавить();  
	
	ЭлементОтбора = ЭлементОформления.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	ЭлементОтбора.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("ДанныеПоСотрудникам.Состояние");
	ЭлементОтбора.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
	ЭлементОтбора.ПравоеЗначение = Справочники.СостоянияЗаказНарядов.Завершен;
	ЭлементОтбора.Использование = Истина;
	
	ОформляемоеПоле = ЭлементОформления.Поля.Элементы.Добавить(); 
	ОформляемоеПоле.Поле = Новый ПолеКомпоновкиДанных("ДанныеПоСотрудникам");
	ОформляемоеПоле.Использование = Истина; 
	
	//можем настроить любой параметр =>
	ЭлементОформления.Оформление.УстановитьЗначениеПараметра("ЦветТекста", WebЦвета.Зеленый);
	
	
	ЭлементОформления = УсловноеОформление.Элементы.Добавить();  
	
	ЭлементОтбора = ЭлементОформления.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	ЭлементОтбора.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("ДанныеПоСотрудникам.Сотрудник");
	ЭлементОтбора.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
	ЭлементОтбора.ПравоеЗначение = Справочники.Сотрудники.ПустаяСсылка();
	ЭлементОтбора.Использование = Истина;
	
	ОформляемоеПоле = ЭлементОформления.Поля.Элементы.Добавить(); 
	ОформляемоеПоле.Поле = Новый ПолеКомпоновкиДанных("ДанныеПоСотрудникамСотрудник");
	ОформляемоеПоле.Использование = Истина; 
	
	//можем настроить любой параметр =>
	ЭлементОформления.Оформление.УстановитьЗначениеПараметра("Шрифт", Новый Шрифт(,, Истина));
	ЭлементОформления.Оформление.УстановитьЗначениеПараметра("Текст", "Общий итог:");
	
	ЭлементОформления = УсловноеОформление.Элементы.Добавить();  
	
	ЭлементОтбора = ЭлементОформления.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	ЭлементОтбора.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("ДанныеПоСотрудникам.Сотрудник");
	ЭлементОтбора.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
	ЭлементОтбора.ПравоеЗначение = Справочники.Сотрудники.ПустаяСсылка();
	ЭлементОтбора.Использование = Истина;
	
	ОформляемоеПоле = ЭлементОформления.Поля.Элементы.Добавить(); 
	ОформляемоеПоле.Поле = Новый ПолеКомпоновкиДанных("ДанныеПоСотрудникамСуммаПланФакт");
	ОформляемоеПоле.Использование = Истина; 
	
	//можем настроить любой параметр =>
	ЭлементОформления.Оформление.УстановитьЗначениеПараметра("Шрифт", Новый Шрифт(,, Истина));

КонецПроцедуры

&НаСервере
Процедура ЗаполнитьНаСервере()
	
	ТекстПостроителя = 
	"ВЫБРАТЬ
	|	Сотрудники.Ссылка КАК Сотрудник
	|ПОМЕСТИТЬ ВТ_Сотрудники
	|ИЗ
	|	Справочник.Сотрудники КАК Сотрудники
	|ГДЕ
	|	НЕ Сотрудники.ПометкаУдаления
	|	И НЕ Сотрудники.Недействителен
	|{ГДЕ
	|	Сотрудники.Ссылка КАК Сотрудник}
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	тм_ДокументыДляФормированияНачисленийЗарплаты.Документ КАК Документ
	|ПОМЕСТИТЬ ВТ_Документы
	|ИЗ
	|	РегистрСведений.тм_ДокументыДляФормированияНачисленийЗарплаты КАК тм_ДокументыДляФормированияНачисленийЗарплаты
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Таблица.Ссылка КАК Документ,
	|	Таблица.Ссылка.СостояниеЗаказа КАК Состояние,
	|	Таблица.тм_Сотрудник КАК тм_Сотрудник,
	|	Таблица.Номенклатура КАК Номенклатура,
	|	Таблица.тм_СуммаЗаВыполненнуюРаботу КАК СуммаЗаВыполненнуюРаботу,
	|	Таблица.Всего + Таблица.СуммаСкидкиНаценки КАК Сумма
	|ПОМЕСТИТЬ ВТ_Таблица
	|ИЗ
	|	Документ.ЗаказПокупателя.Работы КАК Таблица
	|ГДЕ
	|	Таблица.Ссылка В
	|			(ВЫБРАТЬ
	|				Т.Документ
	|			ИЗ
	|				ВТ_Документы КАК Т)
	|	И Таблица.тм_Сотрудник <> &ПустойСотрудник
	|{ГДЕ
	|	Таблица.Ссылка.СостояниеЗаказа КАК СостояниеЗаказа,
	|	Таблица.тм_Сотрудник КАК Сотрудник}
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	Таблица.Ссылка,
	|	Таблица.Ссылка.СостояниеЗаказа,
	|	Таблица.тм_Сотрудник,
	|	Таблица.Номенклатура,
	|	Таблица.тм_СуммаЗаВыполненнуюРаботу,
	|	Таблица.Всего + Таблица.СуммаСкидкиНаценки
	|ИЗ
	|	Документ.ЗаказПокупателя.Работы КАК Таблица
	|ГДЕ
	|	Таблица.Ссылка.Проведен
	|	И Таблица.Ссылка.СостояниеЗаказа = &ВРаботе
	|	И Таблица.тм_Сотрудник В
	|			(ВЫБРАТЬ
	|				Т.Сотрудник
	|			ИЗ
	|				ВТ_Сотрудники КАК Т)
	|{ГДЕ
	|	Таблица.Ссылка.СостояниеЗаказа КАК СостояниеЗаказа}
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ_Таблица.тм_Сотрудник КАК Сотрудник,
	|	ВТ_Таблица.Документ КАК ЗаказНаряд,
	|	ВТ_Таблица.Состояние КАК Состояние,
	|//	ВТ_Таблица.Номенклатура КАК Номенклатура,
	|	ОКР(СУММА(ВТ_Таблица.Сумма)) КАК СуммаРаботы,
	|	ОКР(СУММА(ВТ_Таблица.СуммаЗаВыполненнуюРаботу)) КАК СуммаРаботыПредопределенная,
	|	МАКСИМУМ(ЕСТЬNULL(тм_НастройкиСотрудников.ПроцентЗаВыполненнуюРаботуЗаказНаряд, 0)) КАК ПроцентПолучаемыйСотрудником,
	|	ОКР(СУММА(ВЫБОР
	|			КОГДА ВТ_Таблица.СуммаЗаВыполненнуюРаботу > 0
	|				ТОГДА ВТ_Таблица.СуммаЗаВыполненнуюРаботу
	|			КОГДА ЕСТЬNULL(тм_НастройкиСотрудников.ПроцентЗаВыполненнуюРаботуЗаказНаряд, 0) = 0
	|				ТОГДА 0
	|			ИНАЧЕ ВТ_Таблица.Сумма * ЕСТЬNULL(тм_НастройкиСотрудников.ПроцентЗаВыполненнуюРаботуЗаказНаряд, 0) / 100
	|		КОНЕЦ)) КАК СуммаПланФакт
	|ПОМЕСТИТЬ ВТ_Подг
	|ИЗ
	|	ВТ_Таблица КАК ВТ_Таблица
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.тм_НастройкиСотрудников КАК тм_НастройкиСотрудников
	|		ПО ВТ_Таблица.тм_Сотрудник = тм_НастройкиСотрудников.Сотрудник
	|
	|СГРУППИРОВАТЬ ПО
	|	ВТ_Таблица.тм_Сотрудник,
	|//	ВТ_Таблица.Номенклатура,
	|	ВТ_Таблица.Состояние,
	|	ВТ_Таблица.Документ
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ_Подг.Сотрудник КАК Сотрудник,
	|	ВТ_Подг.ЗаказНаряд КАК ЗаказНаряд,
	|	ВТ_Подг.Состояние КАК Состояние,
	|//	ВТ_Подг.Номенклатура КАК Номенклатура,
	|	ВТ_Подг.СуммаРаботы КАК СуммаРаботы,
	|	ВТ_Подг.СуммаРаботыПредопределенная КАК СуммаРаботыПредопределенная,
	|	ВТ_Подг.ПроцентПолучаемыйСотрудником КАК ПроцентПолучаемыйСотрудником,
	|	ВТ_Подг.СуммаПланФакт КАК СуммаПланФакт
	|ИЗ
	|	ВТ_Подг КАК ВТ_Подг
	|УПОРЯДОЧИТЬ ПО
	|	Сотрудник
	|
	|ИТОГИ
	|	СУММА(СуммаПланФакт)
	|ПО
	|	Сотрудник";
	
	Построитель = Новый ПостроительЗапроса;
	Построитель.Текст = ТекстПостроителя;
	Построитель.ДобавлениеПредставлений = ТипДобавленияПредставлений.НеДобавлять;
	//Построитель.ЗаполнитьНастройки(); 
	
	Если Не Сотрудник.Пустая() Тогда
		ЭлементОтбора = Построитель.Отбор.Добавить("Сотрудник");
		ЭлементОтбора.ВидСравнения = ВидСравнения.Равно;
		ЭлементОтбора.Использование = Истина;
		ЭлементОтбора.Значение = Сотрудник;
	КонецЕсли;
	
	Если Не Состояние.Пустая() Тогда
		ЭлементОтбора = Построитель.Отбор.Добавить("СостояниеЗаказа");
		ЭлементОтбора.ВидСравнения = ВидСравнения.Равно;
		ЭлементОтбора.Использование = Истина;
		ЭлементОтбора.Значение = Состояние;
	КонецЕсли;
	
	Построитель.Параметры.Вставить("ПустойСотрудник", Справочники.Сотрудники.ПустаяСсылка());
	Построитель.Параметры.Вставить("ВРаботе", тм_ОбщегоНазначения.ПредопределенныйЭлемент("СостояниеЗаказНаряда_ВРаботе", "Значение"));
	
	Построитель.Выполнить();
	
	ПромДерево = Построитель.Результат.Выгрузить(ОбходРезультатаЗапроса.ПоГруппировкам);
	
	Если ПромДерево.Строки.Количество() Тогда
		СтрокаОбщаяСумма = ПромДерево.Строки.Добавить();
		СтрокаОбщаяСумма.Сотрудник = Справочники.Сотрудники.ПустаяСсылка();
		СтрокаОбщаяСумма.СуммаПланФакт = ПромДерево.Строки.Итог("СуммаПланФакт");
		
		Смещение = ПромДерево.Строки.Индекс(СтрокаОбщаяСумма) * -1;
		ПромДерево.Строки.Сдвинуть(СтрокаОбщаяСумма, Смещение);
	КонецЕсли;
	
	ЗначениеВРеквизитФормы(ПромДерево, "ДанныеПоСотрудникам");
	
КонецПроцедуры

&НаКлиенте
Процедура УстановитьЗаголовокДекорации(ТекстЗаголовка)

	Элементы.ДекорацияАктуальность.Заголовок = Новый ФорматированнаяСтрока(
		ТекстЗаголовка, Новый Шрифт(, 14), WebЦвета.Зеленый);

КонецПроцедуры // УстановитьЗаголовокДекорации()

#КонецОбласти



