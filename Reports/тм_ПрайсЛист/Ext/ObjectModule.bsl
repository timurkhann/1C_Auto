
Процедура ПриКомпоновкеРезультата(ДокументРезультат, ДанныеРасшифровки, СтандартнаяОбработка)
	
	Настройки = КомпоновщикНастроек.ПолучитьНастройки();
	
	Настройки.ПараметрыДанных.УстановитьЗначениеПараметра("СвойствоПроизводитель",
		тм_ОбщегоНазначения.ПредопределенныйЭлемент("Производитель", "Значение"));
		
	Настройки.ПараметрыДанных.УстановитьЗначениеПараметра("ВидЦенаЗакупки",
		Справочники.ВидыЦен.Учетная);
	
	Настройки.ПараметрыДанных.УстановитьЗначениеПараметра("ДопустимыеСклады",
		тм_ОбщегоНазначения.ПредопределенныйЭлемент("НастройкаВыгрузкиПрайса", "МассивЗначений"));
		
	НастройкиПВХ = тм_ОбщегоНазначения.ПредопределенныйЭлемент("НастройкаВыгрузкиПрайса", "Соответствие");
	
	Если НастройкиПВХ["ПроцентНачисления"] <> Неопределено Тогда
		Множитель = 1 + (НастройкиПВХ["ПроцентНачисления"] / 100);
	Иначе
		Множитель = 1.15;
	КонецЕсли;
	
	Настройки.ПараметрыДанных.УстановитьЗначениеПараметра("Множитель", Множитель);
		
	КомпоновщикНастроек.ЗагрузитьНастройки(Настройки);
	
КонецПроцедуры
