		<dataSource>ИсточникДанных1</dataSource>
		<query>ВЫБРАТЬ
	ОстаткиТоваров.Номенклатура.Артикул КАК Артикул,
	ОстаткиТоваров.Номенклатура.Наименование КАК Наименование,
	ЕСТЬNULL(НоменклатураДополнительныеРеквизиты.Значение, "") КАК Производитель,
	ОстаткиТоваров.Номенклатура.ЕдиницаИзмерения КАК ЕдиницаИзмерения,
	СУММА(ОстаткиТоваров.Количество) КАК Количество,
	ОстаткиТоваров.Номенклатура КАК Номенклатура
ПОМЕСТИТЬ ВТ_ОстаткиНоменклатуры
ИЗ
	РегистрСведений.ОстаткиТоваров КАК ОстаткиТоваров
		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Номенклатура.ДополнительныеРеквизиты КАК НоменклатураДополнительныеРеквизиты
		ПО ОстаткиТоваров.Номенклатура = НоменклатураДополнительныеРеквизиты.Ссылка
			И (НоменклатураДополнительныеРеквизиты.Свойство = &amp;СвойствоПроизводитель)
ГДЕ
	ОстаткиТоваров.СтруктурнаяЕдиница В(&amp;ДопустимыеСклады)
	И ОстаткиТоваров.Количество &gt; 0

СГРУППИРОВАТЬ ПО
	ОстаткиТоваров.СтруктурнаяЕдиница,
	ОстаткиТоваров.Номенклатура.ЕдиницаИзмерения,
	ОстаткиТоваров.Номенклатура.Наименование,
	ОстаткиТоваров.Номенклатура.Артикул,
	ОстаткиТоваров.Номенклатура,
	ЕСТЬNULL(НоменклатураДополнительныеРеквизиты.Значение, "")

ИНДЕКСИРОВАТЬ ПО
	Номенклатура
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ
	ЦеныНоменклатурыСрезПоследних.Номенклатура КАК Номенклатура,
	ЦеныНоменклатурыСрезПоследних.Цена КАК Цена
ПОМЕСТИТЬ ВТ_ЦеныЗакупки
ИЗ
	РегистрСведений.ЦеныНоменклатуры.СрезПоследних(
			{(&amp;Период)},
			Номенклатура В
					(ВЫБРАТЬ
						ВТ_ОстаткиНоменклатуры.Номенклатура КАК Номенклатура
					ИЗ
						ВТ_ОстаткиНоменклатуры КАК ВТ_ОстаткиНоменклатуры)
				И ВидЦен = &amp;ВидЦенаЗакупки) КАК ЦеныНоменклатурыСрезПоследних
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ
	ВТ_ОстаткиНоменклатуры.Артикул КАК Артикул,
	ВТ_ОстаткиНоменклатуры.Наименование КАК Наименование,
	ВТ_ОстаткиНоменклатуры.Производитель КАК Производитель,
	ВТ_ОстаткиНоменклатуры.ЕдиницаИзмерения КАК ЕдиницаИзмерения,
	ВТ_ОстаткиНоменклатуры.Количество КАК Количество,
	ОКР(ЕСТЬNULL(ВТ_ЦеныЗакупки.Цена, 0) * &amp;Множитель) КАК Цена,
	ОКР(ЕСТЬNULL(ВТ_ЦеныЗакупки.Цена, 0) * &amp;Множитель) * ВТ_ОстаткиНоменклатуры.Количество КАК Сумма
ИЗ
	ВТ_ОстаткиНоменклатуры КАК ВТ_ОстаткиНоменклатуры
		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_ЦеныЗакупки КАК ВТ_ЦеныЗакупки
		ПО ВТ_ОстаткиНоменклатуры.Номенклатура = ВТ_ЦеныЗакупки.Номенклатура
ГДЕ
	ЕСТЬNULL(ВТ_ЦеныЗакупки.Цена, 0) &gt; 0</query>
