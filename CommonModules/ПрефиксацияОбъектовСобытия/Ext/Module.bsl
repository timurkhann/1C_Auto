
&После("УстановитьПрефикс")
Процедура тм_УстановитьПрефикс(Источник, Префикс, УстановитьПрефиксИнформационнойБазы, УстановитьПрефиксОрганизации)
	
	Если ТипЗнч(Источник) = Тип("ДокументОбъект.РасходнаяНакладная") Тогда	
		Префикс = СтрЗаменить(Префикс, "НФ", "КРН");
		Префикс = СтрЗаменить(Префикс, "СС", "СРН");
	ИначеЕсли ТипЗнч(Источник) = Тип("ДокументОбъект.ЗаказПокупателя") Тогда
		Если Источник.ВидОперации = Перечисления.ВидыОперацийЗаказПокупателя.ЗаказНаряд Тогда
			Префикс = СтрЗаменить(Префикс, "НФ", "КЗН");
			Префикс = СтрЗаменить(Префикс, "СС", "СЗН");
		ИначеЕсли Источник.ВидОперации = Перечисления.ВидыОперацийЗаказПокупателя.ЗаказНаПродажу Тогда
			Префикс = СтрЗаменить(Префикс, "НФ", "КЗП");
			Префикс = СтрЗаменить(Префикс, "СС", "СЗП");
		КонецЕсли; 
	КонецЕсли; 
	
КонецПроцедуры
