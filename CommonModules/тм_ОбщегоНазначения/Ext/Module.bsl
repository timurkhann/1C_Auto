#Область ПредопределенныеЭлементы

Функция ПредопределенныйЭлемент(ИмяЭлемента, ЗапрашиваемыеДанные = "") Экспорт
	
	УстановитьПривилегированныйРежим(Истина);
	
	Результат = Неопределено;
	
	ПредопределенныйЭлемент = Неопределено;
	Если ТипЗнч(ИмяЭлемента) = Тип("ПланВидовХарактеристикСсылка.тм_ПредопределенныеЭлементы") Тогда
		ПредопределенныйЭлемент = ИмяЭлемента;
	ИначеЕсли ТипЗнч(ИмяЭлемента) = Тип("Строка") Тогда
		ПредопределенныйЭлемент = ПланыВидовХарактеристик.тм_ПредопределенныеЭлементы[ИмяЭлемента];
	КонецЕсли;
	
	Если не ЗначениеЗаполнено(ПредопределенныйЭлемент) Тогда
		Возврат Результат;
	КонецЕсли;
	
	Если ВРЕГ(ЗапрашиваемыеДанные) = ВРЕГ("Значение") Тогда
		Результат = ПредопределенныйЭлемент.ТипЗначения.ПривестиЗначение(ПредопределенныйЭлемент.Значение);
	ИначеЕсли ВРЕГ(ЗапрашиваемыеДанные) = ВРЕГ("МассивЗначений") Тогда
		Результат = ПредопределенныйЭлемент.СписокЗначенийЭлемента.Выгрузить().ВыгрузитьКолонку("ЭлементСпискаЗначений");
	ИначеЕсли ВРЕГ(ЗапрашиваемыеДанные) = ВРЕГ("СписокЗначений") Тогда
		Результат = Новый СписокЗначений;
		Результат.ЗагрузитьЗначения(ПредопределенныйЭлемент.СписокЗначенийЭлемента.Выгрузить().ВыгрузитьКолонку("ЭлементСпискаЗначений"));
	ИначеЕсли ВРЕГ(ЗапрашиваемыеДанные) = ВРЕГ("Соответствие") Тогда
		СоответствиеЗначений = ПредопределенныйЭлемент.СоответствиеЗначений.Выгрузить();
		Результат = Новый Соответствие;
		Для Каждого СтрокаЗначений из СоответствиеЗначений Цикл
			Результат.Вставить(СтрокаЗначений._Ключ, СтрокаЗначений._Значение); 
		КонецЦикла;
	ИначеЕсли ВРЕГ(ЗапрашиваемыеДанные) = ВРЕГ("ТаблицаЗначений") Тогда
		Результат = Новый ТаблицаЗначений;
		Результат = ПредопределенныйЭлемент.ТаблицаНастроек.Выгрузить();
	ИначеЕсли ВРЕГ(ЗапрашиваемыеДанные) = ВРЕГ("Структура") Тогда 
		СоответствиеЗначений = ПредопределенныйЭлемент.СоответствиеЗначений.Выгрузить();
		Результат = Новый Структура;
		Для Каждого СтрокаЗначений из СоответствиеЗначений Цикл
			Результат.Вставить(СтрокаЗначений._Ключ, СтрокаЗначений._Значение);
		КонецЦикла;
	Иначе
		Если ПредопределенныйЭлемент.СписокЗначенийЭлемента.Количество() > 1 Тогда
			Результат = ПредопределенныйЭлемент.СписокЗначенийЭлемента.Выгрузить().ВыгрузитьКолонку("ЭлементСпискаЗначений");
		ИначеЕсли ПредопределенныйЭлемент.СоответствиеЗначений.Количество() > 0 Тогда
			СоответствиеЗначений = ПредопределенныйЭлемент.СоответствиеЗначений.Выгрузить();
			Результат = Новый Соответствие;
			Для Каждого СтрокаЗначений из СоответствиеЗначений Цикл
				Результат.Вставить(СтрокаЗначений._Ключ, СтрокаЗначений._Значение); 
			КонецЦикла;
		Иначе
			Результат = ПредопределенныйЭлемент.ТипЗначения.ПривестиЗначение(ПредопределенныйЭлемент.Значение);
		КонецЕсли;  
	КонецЕсли;
	
	УстановитьПривилегированныйРежим(Ложь);
	
	Возврат Результат;
	
КонецФункции	
#КонецОбласти