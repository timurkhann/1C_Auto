
Процедура глОповеститьПользователяОбИзменениях() Экспорт

	Результат = тм_ОбщегоНазначенияВызовСервера.ЕстьНеПрочитанныеПисьма();
	Если Результат.КоличествоНеПрочитано Тогда
		Описание = Новый ОписаниеОповещения("ОткрытьФормуЧата", тм_ОбщегоНазначенияКлиент);
		ТекстСообщения = "Есть не прочитанные сообщения (" + Результат.КоличествоНеПрочитано + ")"
			+ Символы.ПС + "Нажмите, чтобы открыть";
		ПоказатьОповещениеПользователя("Чат", Описание, ТекстСообщения);
	КонецЕсли; 
	
КонецПроцедуры

Процедура глЗаполнитьНастройки(Права)Экспорт

	тм_ОбщегоНазначенияВызовСервера.ЗаполнитьНастройки(Права);

КонецПроцедуры
 
Функция глДоступнаНастройка(Права, ИмяНастройки, ПроверяемоеЗначение) Экспорт

	Возврат Права[ИмяНастройки] = ПроверяемоеЗначение;
	
КонецФункции

Процедура глОповеститьПользователяОМинимальномОстаткеПриСтартеСистемы() Экспорт

	ПозицииСМинОстатком = тм_ОбщегоНазначенияВызовСервера.ПолучитьМинимальныйОстатокНоменклатуры();
	Если Не ЗначениеЗаполнено(ПозицииСМинОстатком) Тогда
		Возврат;
	КонецЕсли;
	
	Для каждого СтрокаСтрук Из ПозицииСМинОстатком Цикл
		ТекстПользователю = СтрШаблон(НСтр("ru = 'Остаток по позиции <[%1] %2> составляет <%3>. Минимальный порог: %4'"), 
			СтрокаСтрук.Артикул,
			СтрокаСтрук.Номенклатура, 
			СтрокаСтрук.Остаток, 
			СтрокаСтрук.МинимальныйПорог);
	
		ОбщегоНазначенияКлиент.СообщитьПользователю(ТекстПользователю);
	КонецЦикла; 
	
КонецПроцедуры

Процедура глОповеститьПользователяОТекущихЗаказНарядах() Экспорт

	ЗаказНаряды = тм_ОбщегоНазначенияВызовСервера.ЗаказНарядыМастерПриемщикаВРаботе();
	Если Не ЗначениеЗаполнено(ЗаказНаряды) Тогда
		Возврат;
	КонецЕсли;
	
	ПараметрыПередачи = Новый Структура;
	ПараметрыПередачи.Вставить("ЗаказНаряды", ЗаказНаряды);
	
	ОткрытьФорму("ОбщаяФорма.тм_ТекущиеЗаказНарядыМастеровПриемщиков", ПараметрыПередачи,,,,,, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	
КонецПроцедуры
