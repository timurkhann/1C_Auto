#Область тм_ФормированиеНачисленийЗаработнойПлаты

Процедура тм_СформироватьНачислениеЗаработнойПлаты() Экспорт
	
	ОбщегоНазначения.ПриНачалеВыполненияРегламентногоЗадания(Метаданные.РегламентныеЗадания.тм_ФормированиеНачисленийЗаработнойПлаты);
	
	НачатьТранзакцию();
	Попытка
		Запрос = Новый Запрос;
		Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
		Запрос.Текст = 
			"ВЫБРАТЬ
			|	тм_ДокументыДляФормированияНачисленийЗарплаты.Документ КАК Документ
			|ПОМЕСТИТЬ ВТ_Документы
			|ИЗ
			|	РегистрСведений.тм_ДокументыДляФормированияНачисленийЗарплаты КАК тм_ДокументыДляФормированияНачисленийЗарплаты
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|ВЫБРАТЬ
			|	Таблица.Ссылка КАК Документ,
			|	Таблица.тм_Сотрудник КАК тм_Сотрудник,
			|	Таблица.Номенклатура КАК Номенклатура,
			|	Таблица.тм_СуммаЗаВыполненнуюРаботу КАК СуммаЗаВыполненнуюРаботу,
			|	Таблица.Всего + Таблица.СуммаСкидкиНаценки КАК Сумма
			|ПОМЕСТИТЬ ВТ_Таблица
			|ИЗ
			|	Документ.ЗаказПокупателя.Работы КАК Таблица
			|ГДЕ
			|	Таблица.Ссылка В
			|			(ВЫБРАТЬ
			|				Т.Документ
			|			ИЗ
			|				ВТ_Документы КАК Т)
			|	И Таблица.тм_Сотрудник <> &ПустойСотрудник
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|ВЫБРАТЬ
			|	ВТ_Таблица.Документ КАК Документ,
			|	ВТ_Таблица.тм_Сотрудник КАК тм_Сотрудник,
			|	ВТ_Таблица.Номенклатура КАК Номенклатура,
			|	ВТ_Таблица.Сумма КАК Сумма,
			|	ВТ_Таблица.СуммаЗаВыполненнуюРаботу КАК СуммаРаботыПредопределенная,
			|	ЕСТЬNULL(тм_НастройкиСотрудников.ПроцентЗаВыполненнуюРаботуЗаказНаряд, 0) КАК ПроцентПолучаемыйСотрудником
			|ИЗ
			|	ВТ_Таблица КАК ВТ_Таблица
			|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.тм_НастройкиСотрудников КАК тм_НастройкиСотрудников
			|		ПО ВТ_Таблица.тм_Сотрудник = тм_НастройкиСотрудников.Сотрудник";
		
		Запрос.УстановитьПараметр("ПустойСотрудник", Справочники.Сотрудники.ПустаяСсылка());
		
		РезультатЗапроса = Запрос.Выполнить();
		ВременнаяТаблицаЗапроса = Запрос.МенеджерВременныхТаблиц.Таблицы.Найти("ВТ_Документы");
		ВТ_Документы = ВременнаяТаблицаЗапроса.ПолучитьДанные().Выгрузить();
		
		Если РезультатЗапроса.Пустой() Тогда
			УдалитьДокументыПоКоторымСформированыНачисления(ВТ_Документы);
			Возврат;
		КонецЕсли;
		
		Блокировка = Новый БлокировкаДанных;
		ЭлементБлокировки = Блокировка.Добавить("РегистрСведений.тм_ДокументыДляФормированияНачисленийЗарплаты");
		ЭлементБлокировки.Режим = РежимБлокировкиДанных.Исключительный;
		ЭлементБлокировки.ИсточникДанных = РезультатЗапроса;
		ЭлементБлокировки.ИспользоватьИзИсточникаДанных("Документ", "Документ");
		Блокировка.Заблокировать();
		
		НачислениеЗарплаты = Документы.тм_НачислениеЗарплаты.СоздатьДокумент();
		НачислениеЗарплаты.Дата = ТекущаяДатаСеанса();
		
		Выборка = РезультатЗапроса.Выбрать();
		
		Пока Выборка.Следующий() Цикл
			
			СтрокаНачисления = НачислениеЗарплаты.Начисления.Добавить();
			
			Комментарий = "";
			
			Если Выборка.СуммаРаботыПредопределенная > 0 Тогда
				Сумма = Выборка.СуммаРаботыПредопределенная;
			ИначеЕсли Выборка.ПроцентПолучаемыйСотрудником = 0 Тогда
				Сумма = 0;
				Комментарий = СтрШаблон("Сумма не рассчитана для %1. Не указан процент за выполненные работы!",
					Выборка.тм_Сотрудник);
			Иначе
				Сумма = (Выборка.Сумма * Выборка.ПроцентПолучаемыйСотрудником) / 100;
				Сумма = Окр(Сумма);
			КонецЕсли;
			
			СтрокаНачисления.Сотрудник = Выборка.тм_Сотрудник;
			СтрокаНачисления.ДокументОснование = Выборка.Документ;
			СтрокаНачисления.Номенклатура = Выборка.Номенклатура;
			СтрокаНачисления.Комментарий = Комментарий;
			СтрокаНачисления.Сумма = Сумма;
			
		КонецЦикла;
		
		НачислениеЗарплаты.ДополнительныеСвойства.Вставить("ВыполняетсяЗаписьИзРегламентногоЗадания", Истина);
		НачислениеЗарплаты.Записать(РежимЗаписиДокумента.Проведение);
		УдалитьДокументыПоКоторымСформированыНачисления(ВТ_Документы);
		
		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
		ЗаписьЖурналаРегистрации("DaCar.НачислениеЗарплаты",
			УровеньЖурналаРегистрации.Ошибка, Метаданные.Документы.тм_НачислениеЗарплаты,, ОписаниеОшибки());
	КонецПопытки; 
	
КонецПроцедуры

Процедура УдалитьДокументыПоКоторымСформированыНачисления(ДокументыОбработанные)
	
	Если ДокументыОбработанные.Количество() Тогда
		
		Набор = РегистрыСведений.тм_ДокументыДляФормированияНачисленийЗарплаты.СоздатьНаборЗаписей();
		Набор.ДополнительныеСвойства.Вставить("ВыполняетсяЗаписьДокумента", Истина);
		Для каждого СтрокаТаблицы Из ДокументыОбработанные Цикл
			Набор.Отбор.Документ.Установить(СтрокаТаблицы.Документ);
			Набор.Записать();
		КонецЦикла; 
		
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#Область тм_ОтправкаПрайсЛиста

Процедура тм_ОтправкаПрайсЛиста() Экспорт
	
	Результат = Новый ТабличныйДокумент();
	
	Отчет = Отчеты.тм_ПрайсЛист.Создать();
	Отчет.СкомпоноватьРезультат(Результат);
	
	ФайлXLS = ПолучитьИмяВременногоФайла("XLS");
	Результат.Записать(ФайлXLS, ТипФайлаТабличногоДокумента.XLS);
	
	СистемнаяУчетнаяЗапись = РаботаСПочтовымиСообщениями.СистемнаяУчетнаяЗапись();
	ПараметрыПисьма = ПолучитьПараметрыПисьма(ФайлXLS);
	
	Письмо = РаботаСПочтовымиСообщениями.ПодготовитьПисьмо(СистемнаяУчетнаяЗапись, ПараметрыПисьма);
	РаботаСПочтовымиСообщениями.ОтправитьПисьмо(СистемнаяУчетнаяЗапись, Письмо);
	
КонецПроцедуры

Функция ПолучитьПараметрыПисьма(ФайлXLS)
	
	НастройкиПВХ = тм_ОбщегоНазначения.ПредопределенныйЭлемент("НастройкаВыгрузкиПрайса", "Соответствие");
	
	КомуСтр = НастройкиПВХ["ПолучателиПисем"];
	Кому = СтрРазделить(КомуСтр, ";", Ложь);
	
	ПараметрыПисьма = Новый Структура;
	ПараметрыПисьма.Вставить("Кому", СформироватьПолучателей(Кому));
	ПараметрыПисьма.Вставить("Тема", "Прайс-лист Dacar");
	ПараметрыПисьма.Вставить("Тело", "Прйс-лист во вложении");
	ПараметрыПисьма.Вставить("Вложения", ПолучитьВложение(ФайлXLS));
	
	УдалитьФайлы(ФайлXLS);
	
	Возврат ПараметрыПисьма;

КонецФункции // ПолучитьПараметрыПисьма()

Функция СформироватьПолучателей(ПолучателиПисем)

	Кому = Новый Массив;
	Для каждого Получатель Из ПолучателиПисем Цикл
		СтруктураДанных = Новый Структура; 
		СтруктураДанных.Вставить("Адрес", Получатель);
		СтруктураДанных.Вставить("Представление", Получатель);
		Кому.Добавить(СтруктураДанных);
	КонецЦикла; 
	
	Возврат Кому;

КонецФункции // СформироватьСтруктуруПолучателей()

Функция ПолучитьВложение(ФайлXLS)
	
	Вложение = Новый Массив;
	СтруктураДанных = Новый Структура; 
	СтруктураДанных.Вставить("АдресВоВременномХранилище", ПоместитьВоВременноеХранилище(Новый ДвоичныеДанные(ФайлXLS))); 
	СтруктураДанных.Вставить("Представление", "Прайс-лист.xls");
	
	Вложение.Добавить(СтруктураДанных);
	Возврат Вложение;
	
КонецФункции // ОписаниеВложения()

#КонецОбласти
