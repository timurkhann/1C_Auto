Функция ПолучитьПраваОбъекта(Знач Объект, Знач Пользователь = Неопределено) Экспорт
	
	Если ТипЗнч(Объект) = Тип("ДанныеФормыСтруктура")
		И Объект.Свойство("Ссылка") Тогда
		мОбъект = Объект.Ссылка.Метаданные().Имя;
	ИначеЕсли ТипЗнч(Объект) = Тип("Строка") Тогда
		мОбъект = Объект;
	ИначеЕсли ОбщегоНазначения.ЭтоСсылка(ТипЗнч(Объект)) Тогда
		мОбъект = Объект.Метаданные().Имя;
	Иначе
		ВызватьИсключение НСтр("ru = 'Не удалось определить тип объекта'");;
	КонецЕсли;
	
	Если Пользователь = Неопределено Тогда
		Пользователь = Пользователи.ТекущийПользователь();
	КонецЕсли;
	
	Возврат тм_КЭШ.ПолучитьПраваОбъекта(мОбъект, Пользователь);

КонецФункции // ()

