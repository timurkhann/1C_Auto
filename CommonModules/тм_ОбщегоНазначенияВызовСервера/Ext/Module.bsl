Процедура ЗаполнитьНастройки(Права) Экспорт

	Если ТипЗнч(Права) <> Тип("Соответствие") Тогда
		Права = Новый Соответствие;
	КонецЕсли;
	
	НастройкаСклад = ПланыВидовХарактеристик.НастройкиПользователей.ОсновнойСклад;
	Пользователь = Пользователи.ТекущийПользователь();
	
	Права.Вставить("ПолныеПрава", ДоступнаРоль("ПолныеПрава"));
	Права.Вставить("ВосстанавливатьРанееОткрытыеВкладки", ЗначениеНастройкиПользователя("Восстанавливать ранее открытые вкладки", Пользователь, Ложь, Истина));
	Права.Вставить("ПроверятьСтрокиПередУдалением", ЗначениеНастройкиПользователя("Проверять строки перед удалением", Пользователь, Ложь, Истина));
	Права.Вставить("Организация_Куликова", ПланыВидовХарактеристик.тм_ПредопределенныеЭлементы.Организация_Куликова.Значение);
	Права.Вставить("Организация_Савицкий", ПланыВидовХарактеристик.тм_ПредопределенныеЭлементы.Организация_Савицкий.Значение);
	Права.Вставить("ОсновнойСклад", тм_ПерсональныеНастройкиУНФ.Прочитать(НастройкаСклад, Пользователь));

КонецПроцедуры
 
