// Функция - Получить исключенных производителей
//
// Параметры:
//  Производители	 - Массив, СписокЗначений, Строка - Производители для проверки
// 
// Возвращаемое значение:
//  Массив - Массив исключенных производителей
//
Функция ПолучитьИсключенныхПроизводителей(Производители) Экспорт
	
	ИсключенныеПроизводители = Новый Массив;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ВЫРАЗИТЬ(тм_СоответствияЗначений.Измерение1 КАК СТРОКА(100)) КАК Измерение1
		|ИЗ
		|	РегистрСведений.тм_СоответствияЗначений КАК тм_СоответствияЗначений
		|ГДЕ
		|	тм_СоответствияЗначений.Наименование = ""Исключенные производители""
		|	И ВЫРАЗИТЬ(тм_СоответствияЗначений.Измерение1 КАК СТРОКА(100)) В (&СписокПроизводителей)";
	
	Запрос.УстановитьПараметр("СписокПроизводителей", Производители); 
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Выборка = РезультатЗапроса.Выбрать(); 
	Пока Выборка.Следующий() Цикл
		ИсключенныеПроизводители.Добавить(Выборка.Измерение1);
	КонецЦикла;  
	
	Возврат ИсключенныеПроизводители;

КонецФункции // ЕстьИсключенныеПроизводители()

Функция ПолучитьМинимальныйОстатокНоменклатуры() Экспорт
	
	Если ПланыВидовХарактеристик.тм_ПредопределенныеЭлементы.ОповеститьПользователяОМинимальномОстаткеПриСтартеСистемы.Значение = Ложь Тогда
		Возврат Неопределено;
	КонецЕсли; 
	
	ЕстьСоответствиеЗначений = тм_СоответствияЗначений.ЕстьСоответствиеЗначений("ПользовательОповещенияМинОстатка", ПараметрыСеанса.ТекущийПользователь);
	Если Не ЕстьСоответствиеЗначений Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Запрос = Новый Запрос; 
	Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	Запрос.Текст =
		"ВЫБРАТЬ
		|	тм_УправлениеЗапасамиГруппа.Номенклатура КАК Номенклатура,
		|	тм_УправлениеЗапасамиГруппа.МинимальныйУровеньЗапаса КАК МинимальныйПорог
		|ПОМЕСТИТЬ ВТ_Данные
		|ИЗ
		|	РегистрСведений.тм_УправлениеЗапасамиГруппа КАК тм_УправлениеЗапасамиГруппа
		|ГДЕ
		|	тм_УправлениеЗапасамиГруппа.МинимальныйУровеньЗапаса <> 0
		|
		|ИНДЕКСИРОВАТЬ ПО
		|	Номенклатура
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ОстаткиТоваров.Номенклатура КАК Номенклатура,
		|	СУММА(ОстаткиТоваров.Количество - ОстаткиТоваров.Резерв) КАК Остаток,
		|	ПРЕДСТАВЛЕНИЕ(ОстаткиТоваров.Номенклатура) КАК НоменклатураПредставление,
		|	ОстаткиТоваров.Номенклатура.Артикул КАК Артикул
		|ИЗ
		|	РегистрСведений.ОстаткиТоваров КАК ОстаткиТоваров
		|ГДЕ
		|	ОстаткиТоваров.Номенклатура В ИЕРАРХИИ
		|			(ВЫБРАТЬ
		|				ВТ_Данные.Номенклатура КАК Номенклатура
		|			ИЗ
		|				ВТ_Данные КАК ВТ_Данные)
		|
		|СГРУППИРОВАТЬ ПО
		|	ОстаткиТоваров.Номенклатура,
		|	ОстаткиТоваров.Номенклатура.Артикул
		|";
	РезультатЗапроса = Запрос.Выполнить(); 
	Если РезультатЗапроса.Пустой() Тогда
		Возврат Неопределено;
	КонецЕсли; 
	
	РезультатЗапросаГруппы = Запрос.МенеджерВременныхТаблиц.Таблицы.Получить(0).ПолучитьДанные(); 
	ГруппыСМинимальнымОстатком = РезультатЗапросаГруппы.Выгрузить();
	
	ПозицииСМинОстатком = Новый Массив;
	
	Выборка = РезультатЗапроса.Выбрать();
	
	Пока Выборка.Следующий() Цикл
		
		Для каждого СтрокаТаблицы Из ГруппыСМинимальнымОстатком Цикл
			Если Выборка.Номенклатура.ПринадлежитЭлементу(СтрокаТаблицы.Номенклатура)
				И Выборка.Остаток < СтрокаТаблицы.МинимальныйПорог Тогда
				СтруктураДанных = Новый Структура;
				СтруктураДанных.Вставить("Номенклатура"); 
				СтруктураДанных.Вставить("Артикул"); 
				СтруктураДанных.Вставить("МинимальныйПорог");
				СтруктураДанных.Вставить("Остаток");
				
				ЗаполнитьЗначенияСвойств(СтруктураДанных, Выборка,, "Номенклатура");
				СтруктураДанных.МинимальныйПорог = СтрокаТаблицы.МинимальныйПорог;
				СтруктураДанных.Номенклатура = Выборка.НоменклатураПредставление;
				ПозицииСМинОстатком.Добавить(СтруктураДанных);
			КонецЕсли; 
		КонецЦикла; 
	КонецЦикла;  
	
	Возврат ПозицииСМинОстатком;

КонецФункции // ПолучитьМинимальныйОстатокНоменклатуры()

