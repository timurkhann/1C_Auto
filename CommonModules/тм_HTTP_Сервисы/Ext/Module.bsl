
Функция ОбработатьЗапрос(Запрос) Экспорт
	
	Попытка
		РегистрыСведений.тм_ЛогиHTTP.СохранитьВЛог(Запрос);
		
		ТелоОтвета = "";
		Если Запрос.HTTPМетод = "GET" Тогда
			nameData = Запрос.ПараметрыURL.Получить("nameData");
			ТелоОтвета = СформироватьОтветПоЗапросуGet(nameData, Запрос.ПараметрыЗапроса);
		ИначеЕсли Запрос.HTTPМетод = "POST" Тогда
			nameData = Запрос.ПараметрыURL.Получить("nameData");
			ТелоОтвета = СформироватьОтветПоЗапросуPost(nameData, Запрос);
		КонецЕсли;
		
		Ответ = Новый HTTPСервисОтвет(200);
		Ответ.УстановитьТелоИзСтроки(ТелоОтвета, КодировкаТекста.UTF8); 
	Исключение
		Ответ = Новый HTTPСервисОтвет(400); 
		ОтветОшибка = тм_РаботаJSON.СформироватьОтветResult(ОписаниеОшибки());
		Ответ.УстановитьТелоИзСтроки(ОтветОшибка, КодировкаТекста.UTF8); 
	КонецПопытки; 
	
	Ответ.Заголовки.Вставить("Content-Type", "application/json; charset=utf-8");
	
	Возврат Ответ;
	
КонецФункции 

#Область GET
	
Функция СформироватьОтветПоЗапросуGet(nameData, ПараметрыЗапроса)
	
	Если nameData = "nomenclature" Тогда
		ТелоОтвета = ОбработатьЗапрос_GET_Номенклатура();
		Если ПустаяСтрока(ТелоОтвета) Тогда
			Возврат тм_РаботаJSON.СформироватьОтветResult("Все данные загружены");
		КонецЕсли;
	ИначеЕсли nameData = "nomenclature_all" Тогда
		Если ПараметрыЗапроса.Получить("warehouse") = Неопределено
			Или Не СтроковыеФункцииКлиентСервер.ЭтоУникальныйИдентификатор(ПараметрыЗапроса["warehouse"]) Тогда
			Возврат тм_РаботаJSON.СформироватьОтветResult("Не передан склад загрузки или передан не UID склада");
		КонецЕсли;
		ТелоОтвета = ОбработатьЗапрос_GET_Номенклатура_Вся(ПараметрыЗапроса.Получить("warehouse"));
		Если ПустаяСтрока(ТелоОтвета) Тогда
			Возврат тм_РаботаJSON.СформироватьОтветResult("Все данные загружены");
		КонецЕсли;
	ИначеЕсли nameData = "warehouses" Тогда 
		ТелоОтвета = ОбработатьЗапрос_GET_Склады();
		Если ПустаяСтрока(ТелоОтвета) Тогда
			Возврат тм_РаботаJSON.СформироватьОтветResult("Все данные загружены");
		КонецЕсли;
	ИначеЕсли nameData = "cells" Тогда
		Если ПараметрыЗапроса.Получить("warehouse") = Неопределено
			Или Не СтроковыеФункцииКлиентСервер.ЭтоУникальныйИдентификатор(ПараметрыЗапроса["warehouse"]) Тогда
