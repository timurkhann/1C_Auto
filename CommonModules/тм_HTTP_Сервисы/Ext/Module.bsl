Функция ОбработатьЗапрос_GET_ПроверитьДанныеНаЗагрузку(СкладUID)
	
	Узел = ПланыВидовХарактеристик.тм_ПредопределенныеЭлементы.ПланОбменаТСД.Значение;
	
	Данные = Новый Массив;
	
	ТекстЗапроса = "";
	
	Для каждого Состав Из Метаданные.ПланыОбмена.тм_ОбменТСД.Состав Цикл
		
		ТекстШаблон = ТекстШаблон();
		
		Если Не ПустаяСтрока(ТекстЗапроса) Тогда
			ТекстЗапроса = ТекстЗапроса +
				"
				|
				|ОБЪЕДИНИТЬ ВСЕ
				|
				|";
		КонецЕсли; 
		
		ТекстШаблон = СтрЗаменить(ТекстШаблон, "ИмяОбъекта", Состав.Метаданные.Синоним);
		ТекстШаблон = СтрЗаменить(ТекстШаблон, "ОбъектВыгрузки", Состав.Метаданные.ПолноеИмя() + ".Изменения");
		
		Если Состав.Метаданные.ПолноеИмя() = "Справочник.Ячейки" Тогда
			ТекстШаблон = СтрЗаменить(ТекстШаблон, "// ОтборПоВладельцу", "И ПредставлениеОбъекта.Ссылка.Владелец = &Владелец");
		КонецЕсли;
		
		ТекстЗапроса = ТекстЗапроса + ТекстШаблон;
		
	КонецЦикла;
		
	Запрос = Новый Запрос;
	Запрос.Текст = ТекстЗапроса;
	
	Запрос.Параметры.Вставить("Узел", Узел);
	Запрос.Параметры.Вставить("Владелец", Справочники.СтруктурныеЕдиницы.ПолучитьСсылку(Новый УникальныйИдентификатор(СкладUID)));
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Если РезультатЗапроса.Пустой() Тогда
		Возврат "";
	КонецЕсли;
	
	Выборка = РезультатЗапроса.Выбрать();
	Пока Выборка.Следующий() Цикл
		СтруктураДанных = Новый Структура("ПредставлениеОбъекта, Количество"); 
		ЗаполнитьЗначенияСвойств(СтруктураДанных, Выборка);
		Данные.Добавить(СтруктураДанных);
	КонецЦикла; 
	
	ТелоОтвета = тм_РаботаJSON.ЗначениеВJSON(Данные);

	Возврат ТелоОтвета;
	
КонецФункции // ОбработатьЗапрос_GET_ПроверитьДанныеНаЗагрузку()

Функция ОбработатьЗапрос_GET_Номенклатура_Вся(СкладUID)
	
	Данные = Новый Массив;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ПРЕДСТАВЛЕНИЕ(УНИКАЛЬНЫЙИДЕНТИФИКАТОР(ОстаткиТоваров.Номенклатура)) КАК НоменклатураUID,
		|	ОстаткиТоваров.Номенклатура.ПометкаУдаления КАК ПометкаУдаления,
		|	ОстаткиТоваров.Номенклатура.Наименование КАК Наименование,
		|	ОстаткиТоваров.Номенклатура.Артикул КАК Артикул,
		|	ВЫРАЗИТЬ(НоменклатураДополнительныеРеквизиты.Значение КАК Справочник.ЗначенияСвойствОбъектов).Наименование КАК Производитель,
		|	ПРЕДСТАВЛЕНИЕ(УНИКАЛЬНЫЙИДЕНТИФИКАТОР(ЕСТЬNULL(тм_ЯчейкиНоменклатуры.Склад, ЗНАЧЕНИЕ(Справочник.СтруктурныеЕдиницы.ПустаяСсылка)))) КАК ВладелецUID,
		|	ПРЕДСТАВЛЕНИЕ(УНИКАЛЬНЫЙИДЕНТИФИКАТОР(ЕСТЬNULL(тм_ЯчейкиНоменклатуры.Ячейка, ЗНАЧЕНИЕ(Справочник.Ячейки.ПустаяСсылка)))) КАК ЯчейкаUID,
		|	ЕСТЬNULL(тм_ЯчейкиНоменклатуры.Ячейка.ПометкаУдаления, ЛОЖЬ) КАК ЯчейкаПометкаУдаления,
		|	ЕСТЬNULL(тм_ЯчейкиНоменклатуры.Ячейка.Наименование, """") КАК ЯчейкаНаименование
		|ИЗ
		|	РегистрСведений.ОстаткиТоваров КАК ОстаткиТоваров
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.Номенклатура.ДополнительныеРеквизиты КАК НоменклатураДополнительныеРеквизиты
		|		ПО (НоменклатураДополнительныеРеквизиты.Ссылка = ОстаткиТоваров.Номенклатура)
		|			И (НоменклатураДополнительныеРеквизиты.Свойство.Имя = ""Производитель_DaCar"")
		|			И (ОстаткиТоваров.СтруктурнаяЕдиница = &Склад)
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.тм_ЯчейкиНоменклатуры КАК тм_ЯчейкиНоменклатуры
		|		ПО ОстаткиТоваров.СтруктурнаяЕдиница = тм_ЯчейкиНоменклатуры.Склад
		|			И ОстаткиТоваров.Номенклатура = тм_ЯчейкиНоменклатуры.Номенклатура
		|ГДЕ
		|	НЕ ОстаткиТоваров.Номенклатура.ПометкаУдаления
		|	И НЕ ОстаткиТоваров.Номенклатура.ЭтоГруппа
		|	И ОстаткиТоваров.Номенклатура.ТипНоменклатуры = ЗНАЧЕНИЕ(Перечисление.ТипыНоменклатуры.Запас)
		|	И ОстаткиТоваров.Количество > 0";
	
	Запрос.УстановитьПараметр("Склад", Справочники.СтруктурныеЕдиницы.ПолучитьСсылку(Новый УникальныйИдентификатор(СкладUID)));
	РезультатЗапроса = Запрос.Выполнить();
	
	Если РезультатЗапроса.Пустой() Тогда
		Возврат "";
	КонецЕсли;
	
	Выборка = РезультатЗапроса.Выбрать();
	Пока Выборка.Следующий() Цикл
		СтруктураДанных = Новый Структура("НоменклатураUID, Артикул, ПометкаУдаления, Производитель, Наименование, ЯчейкаUID, ЯчейкаНаименование, ЯчейкаПометкаУдаления, ВладелецUID"); 
		ЗаполнитьЗначенияСвойств(СтруктураДанных, Выборка);
		//СтруктураДанных.НоменклатураUID = XMLСтрока(Выборка.Ссылка); 
		//СтруктураДанных.ЯчейкаUID = XMLСтрока(Выборка.Ячейка); 
		//СтруктураДанных.ВладелецUID =  XMLСтрока(Выборка.ВладелецЯчейки);
		Данные.Добавить(СтруктураДанных);
	КонецЦикла; 
	
	ТелоОтвета = тм_РаботаJSON.ЗначениеВJSON(Данные);
	Возврат ТелоОтвета;
	
КонецФункции 

