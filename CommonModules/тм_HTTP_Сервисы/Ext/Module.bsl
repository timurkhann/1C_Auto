#Область POST

Функция СформироватьОтветПоЗапросуPost(nameData, Запрос)
	
	Если nameData = "ApplicationsForAccommodation" Тогда
		ТелоЗапроса = Запрос.ПолучитьТелоКакСтроку();
		Если ПустаяСтрока(ТелоЗапроса) Тогда
			Возврат тм_РаботаJSON.СформироватьОтветResult(СтрШаблон("Не передано тело запроса метода <%1>", nameData));
		КонецЕсли;
		
		ТелоОтвета = ОбработатьЗапрос_POST_ЗаявкиНаРазмещение(ТелоЗапроса, nameData);
	ИначеЕсли nameData = "barcodes" Тогда
		ТелоЗапроса = Запрос.ПолучитьТелоКакСтроку();
		Если ПустаяСтрока(ТелоЗапроса) Тогда
			Возврат тм_РаботаJSON.СформироватьОтветResult(СтрШаблон("Не передано тело запроса метода <%1>", nameData));
		КонецЕсли;
		
		ТелоОтвета = ОбработатьЗапрос_POST_Штрихкоды(ТелоЗапроса, nameData);
		
	ИначеЕсли nameData = "cells" Тогда
		ТелоЗапроса = Запрос.ПолучитьТелоКакСтроку();
		Если ПустаяСтрока(ТелоЗапроса) Тогда
			Возврат тм_РаботаJSON.СформироватьОтветResult(СтрШаблон("Не передано тело запроса метода <%1>", nameData));
		КонецЕсли;
		
		ТелоОтвета = ОбработатьЗапрос_POST_Ячейки(ТелоЗапроса, nameData);
		
	Иначе
		Возврат тм_РаботаJSON.СформироватьОтветResult("Не корректно указан <nameData>");
	КонецЕсли;
	
	Возврат ТелоОтвета;
	
КонецФункции // СформироватьОтветПоЗапросуGet()

Функция ОбработатьЗапрос_POST_ЗаявкиНаРазмещение(ТелоЗапроса, nameData)
	
	Данные = тм_РаботаJSON.JSONВЗначение(ТелоЗапроса);
	
	Если ТипЗнч(Данные) <> Тип("Структура") Тогда
		Возврат тм_РаботаJSON.СформироватьОтветResult(СтрШаблон("Не корректно передано тело запроса метода <%1>", nameData));
	КонецЕсли; 
	
	БылоИзменение = Ложь;
	ЗаявкаНаРазмещениеСсылка = Документы.тм_ЗаявкаНаРазмещение.ПолучитьСсылку(Новый УникальныйИдентификатор(Данные.ДокументUID));
	ЗаявкаНаРазмещение = ЗаявкаНаРазмещениеСсылка.ПолучитьОбъект();
	
	// Запасы
	Если Данные.Запасы.Количество() <> ЗаявкаНаРазмещение.Запасы.Количество() Тогда
		Возврат тм_РаботаJSON.СформироватьОтветResult(СтрШаблон("Ошибка! Количество строк документа в 1С <%1>, в ТСД <%2>", 
			ЗаявкаНаРазмещение.Запасы.Количество(), Данные.Запасы.Количество()));
	КонецЕсли;
	
	Для каждого СтрокаТаблицы Из Данные.Запасы Цикл
		Номенклатура = Справочники.Номенклатура.ПолучитьСсылку(Новый УникальныйИдентификатор(СтрокаТаблицы.НоменклатураUID));
		СтрокаДокумента = ЗаявкаНаРазмещение.Запасы.Найти(Номенклатура, "Номенклатура");
		
		Если СтрокаДокумента = Неопределено Тогда
			Возврат тм_РаботаJSON.СформироватьОтветResult(СтрШаблон("Удалена строка документа по номенклатуре <%1>", Номенклатура));
		КонецЕсли;
		
		Если СтрокаДокумента.КоличествоФакт <> СтрокаТаблицы.КоличествоФакт Тогда
			БылоИзменение = Истина;
			СтрокаДокумента.КоличествоФакт = СтрокаТаблицы.КоличествоФакт;
		КонецЕсли;
		
		Ячейка = Справочники.Ячейки.ПолучитьСсылку(Новый УникальныйИдентификатор(СтрокаТаблицы.ЯчейкаUID));
		Если СтрокаДокумента.Ячейка <> Ячейка Тогда
			БылоИзменение = Истина;
			СтрокаДокумента.Ячейка = Ячейка;
		КонецЕсли; 
		
		Если Номенклатура.Ячейка <> Ячейка Тогда
			НоменклатураОбъект = Номенклатура.ПолучитьОбъект();
			НоменклатураОбъект.Ячейка = Ячейка;
			НоменклатураОбъект.Склад = Ячейка.Владелец;
			ОбновлениеИнформационнойБазы.ЗаписатьОбъект(НоменклатураОбъект);
		КонецЕсли;
	КонецЦикла;
	
	Если БылоИзменение Тогда
		ЗаявкаНаРазмещение.ЗаполненВТСД = Истина;
		ЗаявкаНаРазмещение.ДополнительныеСвойства.Вставить("ЗагрузкаИзТСД");
		ЗаявкаНаРазмещение.ДополнительныеСвойства.Вставить("СоздатьДокументПеремещениеПоЯчейкам");  
		Попытка
			ЗаявкаНаРазмещение.Записать();
			ТелоОтвета = тм_РаботаJSON.СформироватьОтветResult("Документ успешно загружен!");
		Исключение
			ТелоОтвета = тм_РаботаJSON.СформироватьОтветResult(ОписаниеОшибки());
		КонецПопытки;
	Иначе
		ТелоОтвета = тм_РаботаJSON.СформироватьОтветResult("Документ не загружен. Изменений не было!");
	КонецЕсли; 
	
	Возврат ТелоОтвета;
	
КонецФункции 

Функция ОбработатьЗапрос_POST_Штрихкоды(ТелоЗапроса, nameData)
	
	Данные = тм_РаботаJSON.JSONВЗначение(ТелоЗапроса);
	
	Если ТипЗнч(Данные) <> Тип("Массив") Тогда
		Возврат тм_РаботаJSON.СформироватьОтветResult(СтрШаблон("Не корректно передано тело запроса метода <%1>", nameData));
	КонецЕсли;
	
	Для каждого КлючИЗначение Из Данные Цикл
		
		Номенклатура = Справочники.Номенклатура.ПолучитьСсылку(Новый УникальныйИдентификатор(КлючИЗначение.НоменклатураUID));
		
		Если ПустаяСтрока(Номенклатура.ВерсияДанных) Тогда
			Текст = СтрШаблон("Не найдена номенклатура по ГУИД: %1, Артикул: %2", КлючИЗначение.НоменклатураUID, КлючИЗначение.Артикул);
			ТекстОшибки = СтрШаблон(НСтр("ru = 'Штрихкоды не выгружены. Причина:%1'"), Текст);
			
			ЗаписьЖурналаРегистрации("ОбработатьЗапрос_POST_Штрихкоды", УровеньЖурналаРегистрации.Ошибка,,, ТекстОшибки);
			Продолжить;
		КонецЕсли;
		
		НаборЗаписей = РегистрыСведений.ШтрихкодыНоменклатуры.СоздатьНаборЗаписей();
		НаборЗаписей.Отбор.Номенклатура.Установить(Номенклатура);
		//НаборЗаписей.Очистить();
		
		//БылоИзменение = Ложь;
		
		НоваяЗапись = НаборЗаписей.Добавить();
		НоваяЗапись.Штрихкод = КлючИЗначение.Штрихкод;
		НоваяЗапись.Номенклатура = Номенклатура;
		БылоИзменение = Истина;
		
		Попытка
			Если БылоИзменение Тогда
				НаборЗаписей.ОбменДанными.Загрузка = Истина;
				НаборЗаписей.ОбменДанными.Получатели.АвтоЗаполнение = Ложь;
				НаборЗаписей.Записать();
			КонецЕсли; 
		Исключение
			ТекстОшибки = СтрШаблон(НСтр("ru = 'Штрихкоды не выгружены. Причина:%1'"), ОписаниеОшибки());
			ЗаписьЖурналаРегистрации("ОбработатьЗапрос_POST_Штрихкоды", УровеньЖурналаРегистрации.Ошибка,,, ТекстОшибки);
			Возврат тм_РаботаJSON.СформироватьОтветResult(ТекстОшибки);
		КонецПопытки;
		
		// Запись номенклатуры с указанием ячейки
		ЯчейкаИзТСД = Справочники.Ячейки.ПолучитьСсылку(Новый УникальныйИдентификатор(КлючИЗначение.ЯчейкаUID));
		Если ЗначениеЗаполнено(ЯчейкаИзТСД) Тогда
			НоваяЗапись = РегистрыСведений.тм_ЯчейкиНоменклатуры.СоздатьМенеджерЗаписи();
			НоваяЗапись.Номенклатура = Номенклатура;
			НоваяЗапись.Склад = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ЯчейкаИзТСД, "Владелец");
			НоваяЗапись.Ячейка = ЯчейкаИзТСД;
			
			НоваяЗапись.Записать();
		КонецЕсли;
		
		ЯчейкаИзБазы = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Номенклатура, "Ячейка");
		Если Не ЗначениеЗаполнено(ЯчейкаИзБазы) Тогда
			Попытка
				НоменклатураОбъект = Номенклатура.ПолучитьОбъект();
				НоменклатураОбъект.Ячейка = ЯчейкаИзТСД;
				НоменклатураОбъект.Склад = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ЯчейкаИзТСД, "Владелец");
				
				ОбновлениеИнформационнойБазы.ЗаписатьОбъект(НоменклатураОбъект);
			Исключение
				ТекстОшибки = СтрШаблон(НСтр("ru = 'Штрихкоды не выгружены. Причина:%1'"), ОписаниеОшибки());
				ЗаписьЖурналаРегистрации("ОбработатьЗапрос_POST_Штрихкоды", УровеньЖурналаРегистрации.Ошибка,,, ТекстОшибки);
				Возврат тм_РаботаJSON.СформироватьОтветResult(ТекстОшибки);
			КонецПопытки;
		КонецЕсли;
		
	КонецЦикла;
	
	ТелоОтвета = тм_РаботаJSON.СформироватьОтветResult("Штрихкоды успешно выгружены!");
	
	Возврат ТелоОтвета;
	
КонецФункции 

