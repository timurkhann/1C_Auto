Функция ОбработатьЗапрос_GET_ЗаявкиНаРазмещение(СкладUID)
	
	Узел = ПланыВидовХарактеристик.тм_ПредопределенныеЭлементы.ПланОбменаТСД.Значение;
	
	Данные = Новый Массив;
	ВыгруженныеПозиции = Новый Массив;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	тм_ЗаявкаНаРазмещениеЗапасы.Ссылка КАК Ссылка,
		|	тм_ЗаявкаНаРазмещениеЗапасы.Ссылка.Номер КАК Номер,
		|	тм_ЗаявкаНаРазмещениеЗапасы.Номенклатура КАК Номенклатура,
		|	тм_ЗаявкаНаРазмещениеЗапасы.Номенклатура.Артикул КАК Артикул,
		|	тм_ЗаявкаНаРазмещениеЗапасы.Номенклатура.Наименование КАК Наименование,
		|	тм_ЗаявкаНаРазмещениеЗапасы.Номенклатура.ПометкаУдаления КАК ПометкаУдаления,
		|	ВЫРАЗИТЬ(НоменклатураДополнительныеРеквизиты.Значение КАК Справочник.ЗначенияСвойствОбъектов).Наименование КАК Производитель,
		|	ЕСТЬNULL(тм_ЗаявкаНаРазмещениеЗапасы.Номенклатура.Ячейка, ЗНАЧЕНИЕ(Справочник.Ячейки.ПустаяСсылка)) КАК ЯчейкаНоменклатуры,
		|	ЕСТЬNULL(тм_ЗаявкаНаРазмещениеЗапасы.Номенклатура.Ячейка.Наименование, """") КАК ЯчейкаНаименование,
		|	ЕСТЬNULL(тм_ЗаявкаНаРазмещениеЗапасы.Номенклатура.Ячейка.Владелец, ЗНАЧЕНИЕ(Справочник.СтруктурныеЕдиницы.ПустаяСсылка)) КАК ВладелецЯчейки,
		|	ЕСТЬNULL(тм_ЗаявкаНаРазмещениеЗапасы.Номенклатура.Ячейка.ПометкаУдаления, ЛОЖЬ) КАК ЯчейкаПометкаУдаления,
		|	ЕСТЬNULL(тм_ШтрихкодыЯчеек.Штрихкод, """") КАК ЯчейкаШтрихкод,
		|	тм_ЗаявкаНаРазмещениеЗапасы.Количество КАК Количество,
		|	тм_ЗаявкаНаРазмещениеИзменения.Ссылка.СтруктурнаяЕдиница КАК Склад,
		|	тм_ЗаявкаНаРазмещениеЗапасы.Ячейка КАК Ячейка,
		|	тм_ЗаявкаНаРазмещениеИзменения.Ссылка.Дата КАК Дата,
		|	тм_ЗаявкаНаРазмещениеИзменения.Ссылка.Комментарий КАК Комментарий
		|ИЗ
		|	Документ.тм_ЗаявкаНаРазмещение.Изменения КАК тм_ЗаявкаНаРазмещениеИзменения
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.тм_ЗаявкаНаРазмещение.Запасы КАК тм_ЗаявкаНаРазмещениеЗапасы
		|		ПО тм_ЗаявкаНаРазмещениеИзменения.Ссылка = тм_ЗаявкаНаРазмещениеЗапасы.Ссылка
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.тм_ШтрихкодыЯчеек КАК тм_ШтрихкодыЯчеек
		|		ПО (тм_ЗаявкаНаРазмещениеЗапасы.Номенклатура.Ячейка = тм_ШтрихкодыЯчеек.Ячейка)
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Номенклатура.ДополнительныеРеквизиты КАК НоменклатураДополнительныеРеквизиты
		|		ПО тм_ЗаявкаНаРазмещениеЗапасы.Номенклатура = НоменклатураДополнительныеРеквизиты.Ссылка
		|			И (НоменклатураДополнительныеРеквизиты.Свойство.Имя = ""Производитель_DaCar"")
		|ГДЕ
		|	тм_ЗаявкаНаРазмещениеИзменения.Узел = &Узел
		|	И тм_ЗаявкаНаРазмещениеИзменения.Ссылка.СтруктурнаяЕдиница = &СтруктурнаяЕдиница
		|ИТОГИ ПО
		|	Ссылка
		|";
	Запрос.УстановитьПараметр("Узел", Узел);
	Запрос.УстановитьПараметр("СтруктурнаяЕдиница", Справочники.СтруктурныеЕдиницы.ПолучитьСсылку(Новый УникальныйИдентификатор(СкладUID)));

	РезультатЗапроса = Запрос.Выполнить();
	
	Если РезультатЗапроса.Пустой() Тогда
		Возврат "";
	КонецЕсли;

	ВыборкаСсылка = РезультатЗапроса.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	
	Пока ВыборкаСсылка.Следующий() Цикл
		СтруктураДанных = Новый Структура; 
		СтруктураДанных.Вставить("ДокументUID", XMLСтрока(ВыборкаСсылка.Ссылка));
		СтруктураДанных.Вставить("Запасы", Новый Массив); 
		
		ВыгруженныеПозиции.Добавить(ВыборкаСсылка.Ссылка);
		
		Выборка = ВыборкаСсылка.Выбрать();
		Пока Выборка.Следующий() Цикл 
			СтрокаЗапасы = Новый Структура("НоменклатураUID, ЯчейкаUID, Количество, Артикул, Наименование, ПометкаУдаления, Производитель, ЯчейкаНоменклатурыUID, ЯчейкаНаименование, ВладелецUID, ЯчейкаПометкаУдаления, ЯчейкаШтрихкод"); 
			ЗаполнитьЗначенияСвойств(СтрокаЗапасы, Выборка);
			СтрокаЗапасы.НоменклатураUID 		= XMLСтрока(Выборка.Номенклатура);
			СтрокаЗапасы.ЯчейкаUID 				= XMLСтрока(Выборка.Ячейка);
			СтрокаЗапасы.ЯчейкаНоменклатурыUID 	= XMLСтрока(Выборка.ЯчейкаНоменклатуры);
			СтрокаЗапасы.ВладелецUID		 	= XMLСтрока(Выборка.ВладелецЯчейки);
			СтруктураДанных.Вставить("Комментарий", Выборка.Комментарий);
			СтруктураДанных.Вставить("Дата", 		Выборка.Дата);
			СтруктураДанных.Вставить("СкладUID", 	XMLСтрока(Выборка.Склад));
			СтруктураДанных.Вставить("Номер", 		Выборка.Номер);
			СтруктураДанных.Запасы.Добавить(СтрокаЗапасы);
