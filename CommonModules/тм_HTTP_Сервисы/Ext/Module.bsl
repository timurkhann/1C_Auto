Функция ОбработатьЗапрос_GET_Ячейки(СкладUID)
	
	Узел = ПланыВидовХарактеристик.тм_ПредопределенныеЭлементы.ПланОбменаТСД.Значение;
	
	Данные = Новый Массив;
	ВыгруженныеПозиции = Новый Массив;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ЯчейкиИзменения.Ссылка КАК Ссылка,
		|	ЯчейкиИзменения.Ссылка.Наименование КАК ЯчейкаНаименование,
		|	ЯчейкиИзменения.Ссылка.ПометкаУдаления КАК ПометкаУдаления,
		|	ЯчейкиИзменения.Ссылка.Владелец КАК Владелец
		|ИЗ
		|	Справочник.Ячейки.Изменения КАК ЯчейкиИзменения
		|ГДЕ
		|	ЯчейкиИзменения.Узел = &Узел
		|	И ЯчейкиИзменения.Ссылка.Владелец = &Владелец
		|";
	Запрос.Параметры.Вставить("Узел", Узел); 
	Запрос.УстановитьПараметр("Владелец", Справочники.СтруктурныеЕдиницы.ПолучитьСсылку(Новый УникальныйИдентификатор(СкладUID)));

	РезультатЗапроса = Запрос.Выполнить();
	
	Если РезультатЗапроса.Пустой() Тогда
		Возврат "";
	КонецЕсли;
	
	Выборка = РезультатЗапроса.Выбрать();
	Пока Выборка.Следующий() Цикл
		СтруктураДанных = Новый Структура("ЯчейкаUID, ЯчейкаНаименование, ПометкаУдаления, ВладелецUID"); 
		ЗаполнитьЗначенияСвойств(СтруктураДанных, Выборка);
		СтруктураДанных.ЯчейкаUID = XMLСтрока(Выборка.Ссылка);
		СтруктураДанных.ВладелецUID = XMLСтрока(Выборка.Владелец);
		Данные.Добавить(СтруктураДанных);
		ВыгруженныеПозиции.Добавить(Выборка.Ссылка);
	КонецЦикла; 
	
	ТелоОтвета = тм_РаботаJSON.ЗначениеВJSON(Данные);
	УдалитьВыгруженныеОбъекты(ВыгруженныеПозиции); 
	Возврат ТелоОтвета;
	
КонецФункции 

Функция ОбработатьЗапрос_GET_Штрихкоды()
	
	Узел = ПланыВидовХарактеристик.тм_ПредопределенныеЭлементы.ПланОбменаТСД.Значение;
	
	Данные = Новый Массив;
	ВыгруженныеПозиции = Новый Массив;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		// Запрос рабочий, в консоле в режиме предприятия отрабатывает
		"ВЫБРАТЬ
		|	ШтрихкодыНоменклатурыИзменения.Штрихкод КАК Штрихкод,
		|	ШтрихкодыНоменклатурыИзменения.Номенклатура КАК ЭлементШтрихкода,
		|	""Номенклатура"" КАК ВидШтрихкода
		|ИЗ
		|	РегистрСведений.ШтрихкодыНоменклатуры.Изменения КАК ШтрихкодыНоменклатурыИзменения
		|ГДЕ
		|	ШтрихкодыНоменклатурыИзменения.Узел = &Узел
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	тм_ШтрихкодыЯчеекИзменения.Штрихкод,
		|	тм_ШтрихкодыЯчеекИзменения.Ячейка,
		|	""Ячейка""
		|ИЗ
		|	РегистрСведений.тм_ШтрихкодыЯчеек.Изменения КАК тм_ШтрихкодыЯчеекИзменения
		|ГДЕ
		|	тм_ШтрихкодыЯчеекИзменения.Узел = &Узел";
		
	Запрос.Параметры.Вставить("Узел", Узел);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Если РезультатЗапроса.Пустой() Тогда
		Возврат "";
	КонецЕсли;
	
	Выборка = РезультатЗапроса.Выбрать();
	Пока Выборка.Следующий() Цикл
		СтруктураДанных = Новый Структура("ЭлементШтрихкодаUID, Штрихкод, ВидШтрихкода"); 
		ЗаполнитьЗначенияСвойств(СтруктураДанных, Выборка);
		СтруктураДанных.ЭлементШтрихкодаUID = XMLСтрока(Выборка.ЭлементШтрихкода); 
		Данные.Добавить(СтруктураДанных);
		ВыгруженныеПозиции.Добавить(Выборка.ЭлементШтрихкода);
	КонецЦикла; 
	
	ТелоОтвета = тм_РаботаJSON.ЗначениеВJSON(Данные);
	УдалитьВыгруженныеОбъекты(ВыгруженныеПозиции, Истина);
	Возврат ТелоОтвета;
	
КонецФункции 

Функция _ОбработатьЗапрос_GET_ЗаявкиНаРазмещение(СкладUID)
	
	Узел = ПланыВидовХарактеристик.тм_ПредопределенныеЭлементы.ПланОбменаТСД.Значение;
	
	Данные = Новый Массив;
	ВыгруженныеПозиции = Новый Массив;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	тм_ЗаявкаНаРазмещениеЗапасы.Ссылка КАК Ссылка,
		|	тм_ЗаявкаНаРазмещениеЗапасы.Номенклатура КАК Номенклатура,
		|	тм_ЗаявкаНаРазмещениеЗапасы.Количество КАК Количество,
		|	тм_ЗаявкаНаРазмещениеИзменения.Ссылка.СтруктурнаяЕдиница КАК Склад,
		|	тм_ЗаявкаНаРазмещениеЗапасы.Ячейка КАК Ячейка,
		|	тм_ЗаявкаНаРазмещениеИзменения.Ссылка.Дата КАК Дата,
		|	тм_ЗаявкаНаРазмещениеИзменения.Ссылка.Комментарий КАК Комментарий
		|ИЗ
		|	Документ.тм_ЗаявкаНаРазмещение.Изменения КАК тм_ЗаявкаНаРазмещениеИзменения
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.тм_ЗаявкаНаРазмещение.Запасы КАК тм_ЗаявкаНаРазмещениеЗапасы
		|		ПО тм_ЗаявкаНаРазмещениеИзменения.Ссылка = тм_ЗаявкаНаРазмещениеЗапасы.Ссылка
		|ГДЕ
		|	тм_ЗаявкаНаРазмещениеИзменения.Узел = &Узел
