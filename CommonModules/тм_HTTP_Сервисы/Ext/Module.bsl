		ТелоОтвета = ОбработатьЗапрос_GET_ПроверитьДанныеНаЗагрузку(ПараметрыЗапроса.Получить("warehouse"));
		Если ПустаяСтрока(ТелоОтвета) Тогда
			Возврат тм_РаботаJSON.СформироватьОтветResult("Все данные загружены");
		КонецЕсли;
		
	//ИначеЕсли nameData = "All" Тогда
	//	СтрСообщение = "";
	//	ТелоОтвета = ОбработатьЗапрос_GET_Номенклатура();
	//	Если ПустаяСтрока(ТелоОтвета) Тогда
	//		СтрСообщение = ?(ПустаяСтрока(СтрСообщение), "Все данные загружены по номенклатуре", СтрСообщение + ", номенклатуре");
	//	КонецЕсли;
	//	ТелоОтвета = ОбработатьЗапрос_GET_Склады();
	//	Если ПустаяСтрока(ТелоОтвета) Тогда
	//		СтрСообщение = ?(ПустаяСтрока(СтрСообщение), "Все данные загружены по складам", СтрСообщение + ", складам");
	//	КонецЕсли;
	//	ТелоОтвета = ОбработатьЗапрос_GET_Ячейки(СкладUID);
	//	Если ПустаяСтрока(ТелоОтвета) Тогда
	//		СтрСообщение = ?(ПустаяСтрока(СтрСообщение), "Все данные загружены по ячейкам", СтрСообщение + ", ячейкам");
	//	КонецЕсли;
	//	ТелоОтвета = ОбработатьЗапрос_GET_Штрихкоды();
	//	Если ПустаяСтрока(ТелоОтвета) Тогда
	//		СтрСообщение = ?(ПустаяСтрока(СтрСообщение), "Все данные загружены по штрихкодом", СтрСообщение + ", штрихкодом");
	//	КонецЕсли;
	//	Возврат тм_РаботаJSON.СформироватьОтветResult(СтрСообщение);
	Иначе
		Возврат тм_РаботаJSON.СформироватьОтветResult("Не корректно указан <nameData>");
	КонецЕсли;
	
	Возврат ТелоОтвета;
	
КонецФункции // СформироватьОтветПоЗапросуGet()

Функция ОбработатьЗапрос_GET_Номенклатура()
	
	Узел = ПланыВидовХарактеристик.тм_ПредопределенныеЭлементы.ПланОбменаТСД.Значение;
	
	Данные = Новый Массив;
	ВыгруженныеПозиции = Новый Массив;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	НоменклатураИзменения.Ссылка КАК Ссылка,
		|	НоменклатураИзменения.Ссылка.ПометкаУдаления КАК ПометкаУдаления,
		|	Номенклатура.Наименование КАК Наименование,
		|	Номенклатура.Артикул КАК Артикул,
		|	Номенклатура.Ячейка КАК Ячейка, 
		|	ЕСТЬNULL(Номенклатура.Ячейка.ПометкаУдаления, ЛОЖЬ) КАК ЯчейкаПометкаУдаления, 
		|	ЕСТЬNULL(Номенклатура.Ячейка.Владелец, ЗНАЧЕНИЕ(Справочник.СтруктурныеЕдиницы.ПустаяСсылка)) КАК ВладелецЯчейки,
		|	ЕСТЬNULL(Номенклатура.Ячейка.Наименование, """") КАК ЯчейкаНаименование,
		|	ВЫРАЗИТЬ(НоменклатураДополнительныеРеквизиты.Значение КАК Справочник.ЗначенияСвойствОбъектов).Наименование КАК Производитель
		|ИЗ
		|	Справочник.Номенклатура.Изменения КАК НоменклатураИзменения
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.Номенклатура КАК Номенклатура
		|			ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.Номенклатура.ДополнительныеРеквизиты КАК НоменклатураДополнительныеРеквизиты
		|			ПО (НоменклатураДополнительныеРеквизиты.Ссылка = Номенклатура.Ссылка)
		|				И (НоменклатураДополнительныеРеквизиты.Свойство.Имя = ""Производитель_DaCar"")
		|		ПО НоменклатураИзменения.Ссылка = Номенклатура.Ссылка
		|ГДЕ
		|	НоменклатураИзменения.Узел = &Узел
		|";
	Запрос.Параметры.Вставить("Узел", Узел); 
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Если РезультатЗапроса.Пустой() Тогда
		Возврат "";
	КонецЕсли;
	
	Выборка = РезультатЗапроса.Выбрать();
	Пока Выборка.Следующий() Цикл
		СтруктураДанных = Новый Структура("НоменклатураUID, Артикул, ПометкаУдаления, Производитель, Наименование, ЯчейкаUID, ЯчейкаНаименование, ЯчейкаПометкаУдаления, ВладелецUID"); 
		ЗаполнитьЗначенияСвойств(СтруктураДанных, Выборка);
		СтруктураДанных.НоменклатураUID = XMLСтрока(Выборка.Ссылка); 
		СтруктураДанных.ЯчейкаUID = XMLСтрока(Выборка.Ячейка); 
		СтруктураДанных.ВладелецUID =  XMLСтрока(Выборка.ВладелецЯчейки);
		Данные.Добавить(СтруктураДанных);
		ВыгруженныеПозиции.Добавить(Выборка.Ссылка);
	КонецЦикла; 
	
	ТелоОтвета = тм_РаботаJSON.ЗначениеВJSON(Данные);
	УдалитьВыгруженныеОбъекты(ВыгруженныеПозиции); 
	Возврат ТелоОтвета;
	
КонецФункции 

