
#Область ПрограммныйИнтерфейс

&После("ПриДобавленииОбработчиковОбновления")
Процедура тм_ПриДобавленииОбработчиковОбновления(Обработчики)
	
	Обработчик = Обработчики.Добавить();
	Обработчик.Версия = "*";
	Обработчик.Процедура = "ОбновлениеИнформационнойБазыУНФ.тм_ЗаполнитьПредопределенныеЭлементы";
	Обработчик.Комментарий = НСтр("ru = Заполняет предопределенные элементы'");
	
	Обработчик = Обработчики.Добавить();
	Обработчик.Версия = "1.6.26.124";
	Обработчик.Процедура = "ОбновлениеИнформационнойБазыУНФ.ОтменитьДокументыУстановкиЦенРабот";
	Обработчик.Комментарий = НСтр("ru = Устанавливает пометку удаления на авто-ки созданные документы'");
	
КонецПроцедуры

#КонецОбласти

#Область ВыполнятьВсегда

Процедура тм_ЗаполнитьПредопределенныеЭлементы() Экспорт

	Если Не ЗначениеЗаполнено(ПланыВидовХарактеристик.тм_ПредопределенныеЭлементы.НастройкаУстановкиЦенНоменклатуры.Значение) Тогда
		НастройкаУстановкиЦенНоменклатуры = ПланыВидовХарактеристик.тм_ПредопределенныеЭлементы.НастройкаУстановкиЦенНоменклатуры.ПолучитьОбъект();
		НастройкаУстановкиЦенНоменклатуры.Значение = Справочники.тм_НастройкиУстановкиЦенНоменклатуры.НайтиПоКоду("000000001");
		ОбновлениеИнформационнойБазы.ЗаписатьОбъект(НастройкаУстановкиЦенНоменклатуры);
	КонецЕсли;

	Если Не ЗначениеЗаполнено(ПланыВидовХарактеристик.тм_ПредопределенныеЭлементы.ОповеститьПользователяОМинимальномОстаткеПриСтартеСистемы.Значение) Тогда
		НастройкаОповеститьПользователяОМинимальномОстатке = ПланыВидовХарактеристик.тм_ПредопределенныеЭлементы.ОповеститьПользователяОМинимальномОстаткеПриСтартеСистемы.ПолучитьОбъект();
		НастройкаОповеститьПользователяОМинимальномОстатке.Значение = Истина;
		ОбновлениеИнформационнойБазы.ЗаписатьОбъект(НастройкаОповеститьПользователяОМинимальномОстатке);
	КонецЕсли;
	
	// Обмен с ТСД
	Если Не ЗначениеЗаполнено(ПланыВидовХарактеристик.тм_ПредопределенныеЭлементы.ПланОбменаТСД.Значение) Тогда
		Узел = ПланыОбмена.тм_ОбменТСД.НайтиПоКоду("002");
		Если Узел.Пустая() Тогда
			УзелОбъект = ПланыОбмена.тм_ОбменТСД.СоздатьУзел();
			УзелОбъект.Код = "002";
			УзелОбъект.Наименование = "ТСД";
			УзелОбъект.ОбменДанными.Загрузка = Истина;
			УзелОбъект.Записать();
			УзелНовый = УзелОбъект.Ссылка;
		Иначе
			УзелНовый = Узел;
		КонецЕсли;
		
		НастройкаПланОбменаТСД = ПланыВидовХарактеристик.тм_ПредопределенныеЭлементы.ПланОбменаТСД.ПолучитьОбъект();
		НастройкаПланОбменаТСД.Значение = УзелНовый;
		ОбновлениеИнформационнойБазы.ЗаписатьОбъект(НастройкаПланОбменаТСД);
	КонецЕсли;
	
	// ЗонаПриемкиDacar
	Если Не ЗначениеЗаполнено(ПланыВидовХарактеристик.тм_ПредопределенныеЭлементы.ЗонаПриемкиDacar.Значение) Тогда
		ЯчейкаDacar = Справочники.Ячейки.НайтиПоНаименованию("Зона приемки Dacar");
		
		Если ЯчейкаDacar.Пустая() Тогда
			ЯчейкаDacarОбъект = Справочники.Ячейки.СоздатьЭлемент();
			ЯчейкаDacarОбъект.Наименование = "Зона приемки Dacar";
			ЯчейкаDacarОбъект.Владелец = Справочники.СтруктурныеЕдиницы.НайтиПоНаименованию("Dacar-Avto");
			ОбновлениеИнформационнойБазы.ЗаписатьОбъект(ЯчейкаDacarОбъект);
			ЯчейкаDacarНовый = ЯчейкаDacarОбъект.Ссылка;
		Иначе
			ЯчейкаDacarНовый = ЯчейкаDacar;
		КонецЕсли; 
		
		НастройкаЗонаПриемкиDacar = ПланыВидовХарактеристик.тм_ПредопределенныеЭлементы.ЗонаПриемкиDacar.ПолучитьОбъект();
		НастройкаЗонаПриемкиDacar.Значение = ЯчейкаDacarНовый;
		ОбновлениеИнформационнойБазы.ЗаписатьОбъект(НастройкаЗонаПриемкиDacar);
	КонецЕсли;
	
	// ЗонаПриемкиExpress
	Если Не ЗначениеЗаполнено(ПланыВидовХарактеристик.тм_ПредопределенныеЭлементы.ЗонаПриемкиExpress.Значение) Тогда
		ЯчейкаExpress = Справочники.Ячейки.НайтиПоНаименованию("Зона приемки Express");
		
		Если ЯчейкаExpress.Пустая() Тогда
			ЯчейкаExpressОбъект = Справочники.Ячейки.СоздатьЭлемент();
			ЯчейкаExpressОбъект.Наименование = "Зона приемки Express";
			ЯчейкаExpressОбъект.Владелец = Справочники.СтруктурныеЕдиницы.НайтиПоНаименованию("Express");

			ОбновлениеИнформационнойБазы.ЗаписатьОбъект(ЯчейкаExpressОбъект);
			ЯчейкаExpressНовый = ЯчейкаExpressОбъект.Ссылка;
		Иначе
			ЯчейкаExpressНовый = ЯчейкаExpress;
		КонецЕсли; 
		
		НастройкаЗонаПриемкиExpress = ПланыВидовХарактеристик.тм_ПредопределенныеЭлементы.ЗонаПриемкиExpress.ПолучитьОбъект();
		НастройкаЗонаПриемкиExpress.Значение = ЯчейкаExpressНовый;
		ОбновлениеИнформационнойБазы.ЗаписатьОбъект(НастройкаЗонаПриемкиExpress);
	КонецЕсли;
	
	// Производитель_DaCar
	Если Не ЗначениеЗаполнено(ПланыВидовХарактеристик.тм_ПредопределенныеЭлементы.Производитель.Значение) Тогда
		НастройкаПроизводитель = ПланыВидовХарактеристик.тм_ПредопределенныеЭлементы.Производитель.ПолучитьОбъект();
		НастройкаПроизводитель.Значение = ПланыВидовХарактеристик.ДополнительныеРеквизитыИСведения.НайтиПоРеквизиту("Имя", "Производитель_DaCar");
		ОбновлениеИнформационнойБазы.ЗаписатьОбъект(НастройкаПроизводитель);
	КонецЕсли;

	// РегистрироватьНоменклатуруНаВыгрузкуТСД
	Если ПланыВидовХарактеристик.тм_ПредопределенныеЭлементы.РегистрироватьНоменклатуруНаВыгрузкуТСД.Значение = Неопределено Тогда
		Настройка = ПланыВидовХарактеристик.тм_ПредопределенныеЭлементы.РегистрироватьНоменклатуруНаВыгрузкуТСД.ПолучитьОбъект();
		Настройка.Значение = Ложь;
		ОбновлениеИнформационнойБазы.ЗаписатьОбъект(Настройка);
	КонецЕсли;
	
	// Сумма начисления зп работы
	Если Не ЗначениеЗаполнено(ПланыВидовХарактеристик.тм_ПредопределенныеЭлементы.СуммаНачисленияЗаРаботу.Значение) Тогда
		НастройкаНачисления = ПланыВидовХарактеристик.тм_ПредопределенныеЭлементы.СуммаНачисленияЗаРаботу.ПолучитьОбъект();
		НастройкаНачисления.Значение = ПланыВидовХарактеристик.ДополнительныеРеквизитыИСведения.НайтиПоРеквизиту("Имя", "СуммаНачисленияЗаРаботу_DaCar");
		ОбновлениеИнформационнойБазы.ЗаписатьОбъект(НастройкаНачисления);
	КонецЕсли;

КонецПроцедуры
	
#КонецОбласти 

#Область Обработчик_1_6_26_124

Процедура ОтменитьДокументыУстановкиЦенРабот() Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	тм_УстановкаЦенРабот.Ссылка КАК Ссылка
		|ИЗ
		|	Документ.тм_УстановкаЦенРабот КАК тм_УстановкаЦенРабот
		|ГДЕ
		|	тм_УстановкаЦенРабот.СозданАвтоматически
		|	И НЕ тм_УстановкаЦенРабот.ПометкаУдаления";
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Выборка = РезультатЗапроса.Выбрать();
	
	Пока Выборка.Следующий() Цикл
		Документ = Выборка.Ссылка.ПолучитьОбъект();
		Попытка
			Документ.УстановитьПометкуУдаления(Истина);
		Исключение
			ЗаписьЖурналаРегистрации("DaCar.ПометкаУдаленияУстановкиЦенРабот", 
				УровеньЖурналаРегистрации.Ошибка,
				Метаданные.Документы.тм_УстановкаЦенРабот,
				Выборка.Ссылка,
				ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
		КонецПопытки; 
	КонецЦикла;
	
КонецПроцедуры

#КонецОбласти

 
