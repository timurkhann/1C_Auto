
&ИзменениеИКонтроль("ПомеченныеНаУдаление")
Функция тм_ПомеченныеНаУдаление(Знач ОтборМетаданных, ИскатьТехнологическиеОбъекты)

	ЭтоМодельСервиса = ОбщегоНазначения.РазделениеВключено();
	ВОбластиДанных = ?(ЭтоМодельСервиса, ОбщегоНазначения.ДоступноИспользованиеРазделенныхДанных(), Ложь);
	ОтборМетаданных = ?(ОтборМетаданных <> Неопределено И ОтборМетаданных.Количество() > 0,
	ОтборМетаданных.ВыгрузитьЗначения(), Неопределено);

	ИсключенияПоискаУдаляемых = Новый Массив;
	ИсключенияПоиска = Новый Соответствие;
	Если Не ИскатьТехнологическиеОбъекты Тогда
		ИсключенияПоискаСсылок = ОбщегоНазначения.ИсключенияПоискаСсылок();
		Для Каждого ИсключениеПоиска Из ИсключенияПоискаСсылок Цикл
			Если ИсключениеПоиска.Значение = "*" Тогда
				ИсключенияПоискаУдаляемых.Добавить(ИсключениеПоиска.Ключ);
				ИсключенияПоиска[ИсключениеПоиска.Ключ] = Истина;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;

	ПомеченныеНаУдаление = Новый Массив;
	#Удаление
	Для Каждого Элемент Из НайтиПомеченныеНаУдаление( , ОтборМетаданных, ИсключенияПоискаУдаляемых) Цикл
		Если Не СоответствуетОтборуМетаданных(ОтборМетаданных, Элемент) Или ИсключенияПоиска[Элемент.Метаданные()]
			<> Неопределено Тогда
			Продолжить;
		КонецЕсли;

		ПомеченныеНаУдаление.Добавить(Элемент);
	КонецЦикла;
	#КонецУдаления
	#Вставка
	ПомеченныеНаУдалениеЭлементы = НайтиПомеченныеНаУдаление( , ОтборМетаданных, ИсключенияПоискаУдаляемых);
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	Номенклатура.Ссылка КАК Номенклатура
		|ИЗ
		|	Справочник.Номенклатура КАК Номенклатура
		|ГДЕ
		|	Номенклатура.тм_БлокировкаУдаления
		|	И Номенклатура.Ссылка В(&СсылкиНоменклатуры)";
	
	Запрос.УстановитьПараметр("СсылкиНоменклатуры", ПомеченныеНаУдалениеЭлементы);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ИсключаемыеПозицииНоменклатуры = РезультатЗапроса.Выгрузить().ВыгрузитьКолонку("Номенклатура");
	
	Для Каждого Элемент Из ПомеченныеНаУдалениеЭлементы Цикл
		Если ТипЗнч(Элемент) = Тип("СправочникСсылка.Номенклатура")
			И ИсключаемыеПозицииНоменклатуры.Найти(Элемент) <> Неопределено Тогда
			Продолжить;
		КонецЕсли;
		
		Если Не СоответствуетОтборуМетаданных(ОтборМетаданных, Элемент)
			Или ИсключенияПоиска[Элемент.Метаданные()] <> Неопределено Тогда
			Продолжить;
		КонецЕсли;

		ПомеченныеНаУдаление.Добавить(Элемент);
	КонецЦикла;
	#КонецВставки
	
	Результат = Новый Массив;
	ЭтоПредопределенныеЭлементы = ОбщегоНазначения.ЭтоПредопределенныеЭлементы(ПомеченныеНаУдаление);
	ИнформацияОТипах = УдалениеПомеченныхОбъектовСлужебный.ИнформацияОТипах(ПомеченныеНаУдаление);

	Для Каждого Элемент Из ПомеченныеНаУдаление Цикл

		Если Не СоответствуетОтборуМетаданных(ОтборМетаданных, Элемент) Или ИсключенияПоиска[Элемент.Метаданные()]
			<> Неопределено Тогда
			Продолжить;
		КонецЕсли;

		Информация = ИнформацияОТипах[ТипЗнч(Элемент)];
		ЭтоПредопределенный = (ЭтоПредопределенныеЭлементы[Элемент] = Истина);
		ЭтоНеразделенныйОбъектВОбластиДанных = ВОбластиДанных И Не Информация.Разделенный;

		ОбъектПодлежитУдалению = Не ЭтоПредопределенный И Не ЭтоНеразделенныйОбъектВОбластиДанных
		И (Не Информация.Технический Или ИскатьТехнологическиеОбъекты);
		Если ОбъектПодлежитУдалению Тогда
			Результат.Добавить(Элемент);
		КонецЕсли;

	КонецЦикла;

	Возврат Результат;
КонецФункции
