#КонецОбласти

#Область ПрЗаписи_Справочников

Процедура тм_ПриЗаписиСправочниковПриЗаписи_ТСД(Источник, Отказ) Экспорт
	
	Если Источник.ОбменДанными.Загрузка Или Отказ Тогда
		Возврат;
	КонецЕсли;
	
	ИспользоватьОбменТСД = ПолучитьФункциональнуюОпцию("тм_ИспользоватьОбменТСД");
	РегистрироватьНоменклатуруНаВыгрузкуТСД = ПланыВидовХарактеристик.тм_ПредопределенныеЭлементы.РегистрироватьНоменклатуруНаВыгрузкуТСД.Значение;
	
	Если ИспользоватьОбменТСД
		И РегистрироватьНоменклатуруНаВыгрузкуТСД = Истина
		И Метаданные.ПланыОбмена.тм_ОбменТСД.Состав.Содержит(Источник.Метаданные()) Тогда
		
		Узел = ПланыВидовХарактеристик.тм_ПредопределенныеЭлементы.ПланОбменаТСД.Значение;
		
		Если ТипЗнч(Источник) = Тип("СправочникОбъект.Номенклатура") Тогда
			Если Не Источник.ЭтоГруппа
				И Источник.ТипНоменклатуры = Перечисления.ТипыНоменклатуры.Запас Тогда
				ПланыОбмена.ЗарегистрироватьИзменения(Узел, Источник.Ссылка);
			КонецЕсли; 
		ИначеЕсли ТипЗнч(Источник) = Тип("СправочникОбъект.СтруктурныеЕдиницы")
			И Источник.ТипСтруктурнойЕдиницы = Перечисления.ТипыСтруктурныхЕдиниц.Склад Тогда
			ПланыОбмена.ЗарегистрироватьИзменения(Узел, Источник.Ссылка);
		Иначе // ячейка
			ПланыОбмена.ЗарегистрироватьИзменения(Узел, Источник.Ссылка);
		КонецЕсли; 
		
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область ПрЗаписи_Документов

Процедура тм_ПриЗаписиДокументовПриЗаписи_ТСД(Источник, Отказ) Экспорт
	
	мЭтотОбъект = Источник;
	Если мЭтотОбъект.ОбменДанными.Загрузка Или Отказ Тогда
		Возврат;
	КонецЕсли;
	
	ИспользоватьОбменТСД = ПолучитьФункциональнуюОпцию("тм_ИспользоватьОбменТСД");
	
	ТипДокумента = ТипЗнч(мЭтотОбъект);
	
	Если ТипДокумента = Тип("ДокументОбъект.тм_ЗаявкаНаРазмещение")
		И Не Источник.ЗаполненВТСД
		И ИспользоватьОбменТСД Тогда
		
		Если ТипЗнч(Источник.ДокументОснование) = Тип("ДокументСсылка.ПриходнаяНакладная") Тогда
			ЗарегистрироватьКВыгрузке = Не тм_ОбменТСД.ВыгруженВТСД(Источник.ДокументОснование);
		ИначеЕсли ТипЗнч(Источник.ДокументОснование ) = Тип("ДокументСсылка.ОприходованиеЗапасов")
			И Источник.ДополнительныеСвойства.Свойство("ЗарегистрироватьКВыгрузке") Тогда
			ЗарегистрироватьКВыгрузке = Истина;
		Иначе
			ЗарегистрироватьКВыгрузке = Ложь;
		КонецЕсли; 

		Если ЗарегистрироватьКВыгрузке Тогда
			ПланыОбмена.ЗарегистрироватьИзменения(ПланыВидовХарактеристик.тм_ПредопределенныеЭлементы.ПланОбменаТСД.Значение, Источник.Ссылка);
		КонецЕсли;
	КонецЕсли
	
КонецПроцедуры 

#КонецОбласти 


