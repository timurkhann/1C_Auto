
Процедура тм_ЗарегистрироватьИзмененияРегистраДляОбменаТСДПриЗаписи(Источник, Отказ, Замещение) Экспорт
	
	Если Источник.ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;
	
	ИспользоватьОбменТСД = ПолучитьФункциональнуюОпцию("тм_ИспользоватьОбменТСД");
	
	Если ИспользоватьОбменТСД Тогда
		Узел = ПланыВидовХарактеристик.тм_ПредопределенныеЭлементы.ПланОбменаТСД.Значение;
		Если Источник.Количество() Тогда
			ПланыОбмена.ЗарегистрироватьИзменения(Узел, Источник);
		Иначе
			ПланыОбмена.УдалитьРегистрациюИзменений(Узел, Источник);
		КонецЕсли;
	КонецЕсли;
	
	// Выше выполняется удаление данных из плана обмена, т.к. АвтоЗаполнение в Ложь ставить нужно до записи. Если поставить перед запью, набор узлов уже будет сформирован. не ставлю т.к. лень делать в форме записи РС ШК
	
	//Изменение данных без регистрации изменений
	//В некоторых случаях факт изменения данных, для которых выполняется автоматическая регистрация, не должен быть зарегистрирован механизмом регистрации изменений.
	//Для того чтобы не произошла автоматическая регистрация изменений данных, необходимо перед вызовом процедуры записи данных 
	//(объекта, набора записей или менеджера значения константы) установить свойство АвтоЗаполнение коллекции узлов-приемников в значение Ложь.
	//Это приведет к тому, что список узлов, для которых должно быть зарегистрировано изменение данных, автоматически заполнен не будет. 
	//Если в процессе записи коллекция узлов-примеников останется пустой, то регистрации изменения данных не произойдет.
	
	// Поэтому удаление узлов реализовывать не нужно
	//УстановитьПривилегированныйРежим(Истина);
	
	//Узел = ПланыОбмена.тм_ОбменТСД.НайтиПоКоду("002");
	//
	//ТипИсточника = ТипЗнч(Источник);
	//Если ТипИсточника = Тип("РегистрСведенийНаборЗаписей.ШтрихкодыНоменклатуры")
	//	И Источник.ДополнительныеСвойства.Свойство("УдалитьРегистрациюИзменения") Тогда
	//	Источник.ОбменДанными.Получатели.Удалить(Узел);
	//Иначе
	//	Возврат;
	//КонецЕсли;
	
КонецПроцедуры

Процедура ОчиститьРанееЗаписанныеШтрихКоды(НаборЗаписей, Узел)
	
	ЭтоРегистрШтрихкодов = ТипЗнч(НаборЗаписей) = Тип("РегистрСведенийНаборЗаписей.ШтрихкодыНоменклатуры");
	
	Запрос = Новый Запрос;
	
	Если ЭтоРегистрШтрихкодов Тогда
		Запрос.Текст = 
			"ВЫБРАТЬ
			|	ШтрихкодыИзменения.Штрихкод КАК Штрихкод,
			|	ШтрихкодыИзменения.Номенклатура КАК Номенклатура,
			|	ШтрихкодыИзменения.Характеристика КАК Характеристика,
			|	ШтрихкодыИзменения.Партия КАК Партия,
			|	ШтрихкодыИзменения.ЕдиницаИзмерения КАК ЕдиницаИзмерения
			|ИЗ
			|	РегистрСведений.ШтрихкодыНоменклатуры.Изменения КАК ШтрихкодыИзменения
			|ГДЕ
			|	ШтрихкодыИзменения.Узел В (&Узел)
			|	И ШтрихкодыИзменения.Номенклатура В (&Номенклатура)
			|	И ШтрихкодыИзменения.Характеристика В (&Характеристика)
			|	И ШтрихкодыИзменения.Партия В (&Партия)
			|	И ШтрихкодыИзменения.ЕдиницаИзмерения В (&ЕдиницаИзмерения)
			|	И НЕ ШтрихкодыИзменения.Штрихкод В (&Штрихкод)";
	Иначе
		Запрос.Текст = 
			"ВЫБРАТЬ
			|	ШтрихкодыЯчеекИзменения.Штрихкод КАК Штрихкод,
			|	ШтрихкодыЯчеекИзменения.Ячейка КАК Ячейка
			|ИЗ
			|	РегистрСведений.тм_ШтрихкодыЯчеек.Изменения КАК ШтрихкодыЯчеекИзменения
			|ГДЕ
			|	ШтрихкодыЯчеекИзменения.Узел В (&Узел)
			|	И ШтрихкодыЯчеекИзменения.Ячейка В (&Ячейка)
			|	И НЕ ШтрихкодыЯчеекИзменения.Штрихкод В (&Штрихкод)";
	
	КонецЕсли;
	
	Параметры = Новый Структура;
	Для каждого Отбор Из НаборЗаписей.Отбор Цикл
		Параметры.Вставить(Отбор.Имя, Отбор.Значение);
	КонецЦикла;
	
	Параметры.Вставить("Узел", Узел);
	
	ОбщегоНазначенияКлиентСервер.ДополнитьСтруктуру(Запрос.Параметры, Параметры);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Выборка = РезультатЗапроса.Выбрать();
	
	Имярегистра = ?(ЭтоРегистрШтрихкодов, "ШтрихкодыНоменклатуры", "тм_ШтрихкодыЯчеек");
	
	Пока Выборка.Следующий() Цикл
		
		УдаляемыйНаборЗаписейИзПлана = РегистрыСведений[Имярегистра].СоздатьНаборЗаписей();
		Для каждого Отбор из УдаляемыйНаборЗаписейИзПлана.Отбор Цикл
			Отбор.Использование = Истина;
			Отбор.Значение = Выборка[Отбор.Имя];
		КонецЦикла;
		
		УдаляемыйНаборЗаписейИзПлана.Прочитать();
		
		ПланыОбмена.УдалитьРегистрациюИзменений(ПланыВидовХарактеристик.тм_ПредопределенныеЭлементы.ПланОбменаТСД.Значение, УдаляемыйНаборЗаписейИзПлана);
		
	КонецЦикла;

КонецПроцедуры
 
