
// Функция - Есть соответствие значений
//
// Параметры:
//  Наименование - Строка - Наименование соответствия
//  Измерение1 - Произвольный - Проверка по Измерению. По умолчнию Неопределено
// 
// Возвращаемое значение:
//   Булево - Истина, если есть соответствие 
//
Функция ЕстьСоответствиеЗначений(Наименование, Измерение1 = Неопределено) Экспорт

	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	тм_СоответствияЗначений.Наименование КАК Наименование
		|ИЗ
		|	РегистрСведений.тм_СоответствияЗначений КАК тм_СоответствияЗначений
		|ГДЕ
		|	тм_СоответствияЗначений.Наименование = &Наименование";
	
	Запрос.УстановитьПараметр("Наименование", Наименование);
	Если Измерение1 <> Неопределено Тогда
		Запрос.Текст = Запрос.Текст + Символы.ПС + "	И тм_СоответствияЗначений.Измерение1 = &Измерение1"; 
		Запрос.УстановитьПараметр("Измерение1", Измерение1);
	КонецЕсли; 
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Возврат Не РезультатЗапроса.Пустой();

КонецФункции // ЕстьСоответствиеЗначений()

// Функция - Получить значение соответствия
//
// Параметры:
//  Наименование		 - Строка - Наименование соответствия
//  КолонкаРезультата	 - Строка - Колонка результата
//  Фильтр				 - Структура - Накладываемые условия. По умолчанию Неопределено
//  ЗначениеПоУмолчанию	 - ЛюбойТип	- Возвращаемое значение, если запрос пустой
// 
// Возвращаемое значение:
//  ЛюбойТип - Результат выполнения запроса
//
Функция ПолучитьЗначениеСоответствия(Наименование, КолонкаРезультата, Фильтр = Неопределено, ЗначениеПоУмолчанию = Неопределено) Экспорт

	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	тм_СоответствияЗначений.Наименование КАК Наименование
		|ИЗ
		|	РегистрСведений.тм_СоответствияЗначений КАК тм_СоответствияЗначений
		|ГДЕ
		|	тм_СоответствияЗначений.Наименование = &Наименование";
	
	Если ТипЗнч(Фильтр) = Тип("Структура") Тогда
		Для каждого СтрокаСтрук Из Фильтр Цикл
			Запрос.Текст = Запрос.Текст + Символы.ПС 
				+ "	И (ВЫРАЗИТЬ(тм_СоответствияЗначений." + СтрокаСтрук.Ключ + " КАК " + СтрокаТипЗначения(СтрокаСтрук.Значение) 
				+ ")) = &" + СтрокаСтрук.Ключ;
			Запрос.УстановитьПараметр(СтрокаСтрук.Ключ, СтрокаСтрук.Значение);
		КонецЦикла; 
	КонецЕсли; 
	
	Запрос.УстановитьПараметр("Наименование", Наименование);
	
	РезультатЗапроса = Запрос.Выполнить();
	Если РезультатЗапроса.Пустой() Тогда
		Возврат ЗначениеПоУмолчанию;	
	КонецЕсли; 

	Возврат РезультатЗапроса.Выгрузить()[0].КолонкаРезультата;

КонецФункции // ПолучитьЗначениеСоответствия()   

// Функция - Получить значение соответствия
//
// Параметры:
//  Наименование		 - Строка - Наименование соответствия
//  Фильтр				 - Структура - Накладываемые условия. По умолчанию Неопределено 
// 
// Возвращаемое значение:
//  ТаблицаЗначений - Результат выполнения запроса в виде таблицы
//
Функция ПолучитьЗначенияСоответствия(Наименование, Фильтр = Неопределено) Экспорт

	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	тм_СоответствияЗначений.Наименование КАК Наименование,
		|	тм_СоответствияЗначений.Измерение1 КАК Измерение1,
		|	тм_СоответствияЗначений.Значение КАК Значение
		|ИЗ
		|	РегистрСведений.тм_СоответствияЗначений КАК тм_СоответствияЗначений
		|ГДЕ
		|	тм_СоответствияЗначений.Наименование = &Наименование";
	
	Если ТипЗнч(Фильтр) = Тип("Структура") Тогда
		Для каждого СтрокаСтрук Из Фильтр Цикл
			Запрос.Текст = Запрос.Текст + Символы.ПС 
				+ "	И (ВЫРАЗИТЬ(тм_СоответствияЗначений." + СтрокаСтрук.Ключ + " КАК " + СтрокаТипЗначения(СтрокаСтрук.Значение) 
				+ ")) = &" + СтрокаСтрук.Ключ;
			Запрос.УстановитьПараметр(СтрокаСтрук.Ключ, СтрокаСтрук.Значение);
		КонецЦикла; 
	КонецЕсли; 
	
	Запрос.УстановитьПараметр("Наименование", Наименование);
	
	РезультатЗапроса = Запрос.Выполнить();

	Возврат РезультатЗапроса.Выгрузить();

КонецФункции // ПолучитьЗначениеСоответствия()   

Функция СтрокаТипЗначения(Значение)
	
	ТипЗнчЗначение = ТипЗнч(Значение);
	Если ТипЗнчЗначение = Тип("Строка") Тогда
		СтрокаТипЗначения = "СТРОКА (1024)"; 
	ИначеЕсли ТипЗнчЗначение = Тип("Число") Тогда
		СтрокаТипЗначения = "ЧИСЛО (10,0)"; 
	ИначеЕсли ТипЗнчЗначение = Тип("Булево") Тогда
		СтрокаТипЗначения = "БУЛЕВО";
	ИначеЕсли ТипЗнчЗначение = Тип("Дата") Тогда
		СтрокаТипЗначения = "ДАТА";
	ИначеЕсли ТипЗнчЗначение = Тип("NULL") Тогда
		СтрокаТипЗначения = "NULL";
	ИначеЕсли ТипЗнчЗначение = Тип("Неопределено") Тогда
		СтрокаТипЗначения = "НЕОПРЕДЕЛЕНО";
	Иначе
		МетаданныеЗначения = Метаданные.НайтиПоТипу(ТипЗнчЗначение);
		СтрокаТипЗначения  = МетаданныеЗначения.ПолноеИмя();
	КонецЕсли;
	
	Возврат СтрокаТипЗначения;

КонецФункции
