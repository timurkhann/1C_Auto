
&ИзменениеИКонтроль("СоздатьСчетФактуру")
Функция тм_СоздатьСчетФактуру(ДокументОснование, СчетФактураДата, СчетФактураНомер = Неопределено, СчетФактураНомерИсправления = Неопределено) Экспорт
	
	Полученный = Не СчетФактураНомер = Неопределено;
	#Вставка
	Если ТипЗнч(ДокументОснование) = Тип("ДокументСсылка.РасходнаяНакладная") Тогда
		тм_СостояниеРасходнойНакладной = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ДокументОснование, "тм_СостояниеРасходнойНакладной");
		Если тм_СостояниеРасходнойНакладной <> Перечисления.тм_СостояниеРасходнойНакладной.Завершен Тогда
			Права = тм_КЭШ.ПолучитьПраваОбъекта(ДокументОснование.Метаданные().Имя, Пользователи.ТекущийПользователь());
			Если Не Права.SA Тогда
				СтруктураВозврата = Новый Структура;
				СтруктураВозврата.Вставить("Ссылка", Неопределено);
				ОбщегоНазначения.СообщитьПользователю(НСтр("ru = 'Создать счет-фактуру возможно только в завершенном статусе!'"));
				Возврат СтруктураВозврата;
			КонецЕсли;
		КонецЕсли;
	ИначеЕсли ТипЗнч(ДокументОснование) = Тип("ДокументСсылка.ЗаказПокупателя") 
		И ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ДокументОснование, "ВидОперации") = Перечисления.ВидыОперацийЗаказПокупателя.ЗаказНаряд Тогда 
		СостояниеЗаказа = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ДокументОснование, "СостояниеЗаказа");
		Если СостояниеЗаказа <> Справочники.СостоянияЗаказНарядов.Завершен Тогда
			Права = тм_КЭШ.ПолучитьПраваОбъекта(ДокументОснование.Метаданные().Имя, Пользователи.ТекущийПользователь());
			Если Не Права.SA Тогда
				СтруктураВозврата = Новый Структура;
				СтруктураВозврата.Вставить("Ссылка", Неопределено);
				ОбщегоНазначения.СообщитьПользователю(НСтр("ru = 'Создать счет-фактуру возможно только в завершенном статусе!'"));
				Возврат СтруктураВозврата;
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	#КонецВставки
	
	Корректировочный = Ложь;
	Если ТипЗнч(ДокументОснование) = Тип("ДокументСсылка.ПриходнаяНакладная") Тогда
		Корректировочный = ДокументОснование.ПокупателюВыставляетсяКорректировочныйСчетФактура;
	КонецЕсли;
	
	Если Полученный Тогда
		СчетФактура = Документы.СчетФактураПолученный.СоздатьДокумент();
	Иначе
		СчетФактура = Документы.СчетФактура.СоздатьДокумент();
	КонецЕсли;
	
	СчетФактура.Заполнить(ДокументОснование);
	
	СтруктураВозврата = Новый Структура;
	
	Если Полученный И Не Корректировочный Тогда
		СчетФактура.Дата = ДокументОснование.Дата;
		Если СчетФактура.Исправление И ЗначениеЗаполнено(СчетФактураНомерИсправления) Тогда
			СчетФактура.НомерИсправления = СчетФактураНомерИсправления;
			Если НЕ ЗначениеЗаполнено(СчетФактура.ДатаВходящегоДокумента) Тогда
				СчетФактура.ДатаВходящегоДокумента = СчетФактураДата;
			КонецЕсли;
		Иначе
			СчетФактура.НомерВходящегоДокумента = СчетФактураНомер;
			СчетФактура.ДатаВходящегоДокумента = СчетФактураДата;
		КонецЕсли;
		СчетФактура.УдалитьОбновлениеЗавершено = Истина;
		
		Если ДокументОснование.Проведен Тогда
			СчетФактура.Записать(РежимЗаписиДокумента.Проведение);
		Иначе
			СчетФактура.Записать(РежимЗаписиДокумента.Запись);
		КонецЕсли;
		
		СтруктураВозврата.Вставить("ДатаВходящегоДокумента", СчетФактура.ДатаВходящегоДокумента);
		СтруктураВозврата.Вставить("НомерВходящегоДокумента", СчетФактура.НомерВходящегоДокумента);
		
		СтруктураВозврата.Вставить("Дата", Дата(1,1,1));
		СтруктураВозврата.Вставить("Номер", "");
	Иначе
		
		Если Не ТипЗнч(ДокументОснование) = Тип("ДокументСсылка.ЗаказПокупателя") Тогда
			СчетФактура.Дата = СчетФактураДата;
		КонецЕсли;
		
		Если ДокументОснование.Проведен Тогда
			СчетФактура.Записать(РежимЗаписиДокумента.Проведение);
		Иначе
			СчетФактура.Записать(РежимЗаписиДокумента.Запись);
		КонецЕсли;
		
		ДатаНомер = ДатаНомерДляПечатиСчетаФактуры(СчетФактура.Ссылка);
		
		СтруктураВозврата.Вставить("Дата", ДатаНомер.Дата);
		СтруктураВозврата.Вставить("Номер", ДатаНомер.Номер);
		
		СтруктураВозврата.Вставить("ДатаВходящегоДокумента", Дата(1,1,1));
		СтруктураВозврата.Вставить("НомерВходящегоДокумента", "");
	КонецЕсли;
	
	СтруктураВозврата.Вставить("Ссылка", СчетФактура.Ссылка);

	Возврат СтруктураВозврата;
	
КонецФункции
