#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда
	
Функция ГруппыСМинимальнымОстатком() Экспорт

	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	тм_УправлениеЗапасамиГруппа.Номенклатура КАК Номенклатура,
		|	тм_УправлениеЗапасамиГруппа.МинимальныйУровеньЗапаса КАК МинимальныйУровеньЗапаса
		|ИЗ
		|	РегистрСведений.тм_УправлениеЗапасамиГруппа КАК тм_УправлениеЗапасамиГруппа
		|ГДЕ
		|	тм_УправлениеЗапасамиГруппа.МинимальныйУровеньЗапаса <> 0";
	
	РезультатЗапроса = Запрос.Выполнить();
	Возврат РезультатЗапроса.Выгрузить();
	
КонецФункции // ГруппыСМинимальнымОстатком()

