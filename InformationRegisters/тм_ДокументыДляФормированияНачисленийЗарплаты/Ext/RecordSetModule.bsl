#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда
	
Процедура ПередЗаписью(Отказ, Замещение)
	
	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;
	
	Права = тм_КЭШ.ПолучитьПраваОбъекта(Метаданные().Имя, Пользователи.ТекущийПользователь());
	
	ЗаписьРазрешена = ДополнительныеСвойства.Свойство("ВыполняетсяЗаписьДокумента")
		Или Права.SA;
	
	Если Не ЗаписьРазрешена Тогда
		ОбщегоНазначения.СообщитьПользователю(НСтр("ru = 'Запись документов для формирования начислений зарплаты не разрешена'"),,,, Отказ);
	КонецЕсли;
	
КонецПроцедуры
	
#КонецЕсли