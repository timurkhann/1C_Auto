#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда
	
Процедура ПередЗаписью(Отказ, Замещение)
	
	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;
	
	Если ЭтотОбъект.Количество() = 1 Тогда
		Штрихкод = ЭтотОбъект[0].Штрихкод;
		Если ПустаяСтрока(Штрихкод) Тогда
			ОбщегоНазначения.СообщитьПользователю(НСтр("ru = 'Необходимо указать штрихкод'"),,,, Отказ);
			Возврат;
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

Процедура ПриЗаписи(Отказ, Замещение)

	Если ЭтотОбъект.Количество() = 1 Тогда
		Ячейка = ЭтотОбъект[0].Ячейка;
		
		Запрос = Новый Запрос;
		Запрос.Текст = 
			"ВЫБРАТЬ
			|	тм_ШтрихкодыЯчеек.Ячейка КАК Ячейка,
			|	КОЛИЧЕСТВО(тм_ШтрихкодыЯчеек.Штрихкод) КАК Штрихкод
			|ИЗ
			|	РегистрСведений.тм_ШтрихкодыЯчеек КАК тм_ШтрихкодыЯчеек
			|ГДЕ
			|	тм_ШтрихкодыЯчеек.Ячейка = &Ячейка
			|
			|СГРУППИРОВАТЬ ПО
			|	тм_ШтрихкодыЯчеек.Ячейка
			|
			|ИМЕЮЩИЕ
			|	КОЛИЧЕСТВО(тм_ШтрихкодыЯчеек.Штрихкод) > 1";
		
		Запрос.УстановитьПараметр("Ячейка", Ячейка);
		
		РезультатЗапроса = Запрос.Выполнить();
		
		Выборка = РезультатЗапроса.Выбрать();
		
		Если Выборка.Следующий() Тогда
			ОбщегоНазначения.СообщитьПользователю(НСтр("ru = 'Запрещено создавать несколько штрихкодов для одной ячейки'"),,,, Отказ);
		КонецЕсли;
	КонецЕсли;

КонецПроцедуры






