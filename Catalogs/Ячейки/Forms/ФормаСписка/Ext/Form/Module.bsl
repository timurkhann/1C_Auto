#Область ОбработчикиСобытийФормы

&НаСервере
Процедура тм_ПриСозданииНаСервереПосле(Отказ, СтандартнаяОбработка)
	
	Список.ПроизвольныйЗапрос = Истина;
	Список.ТекстЗапроса = "ВЫБРАТЬ
	                      |	Ячейки.Наименование КАК Наименование,
	                      |	тм_ШтрихкодыЯчеек.Штрихкод КАК Штрихкод,
	                      |	Ячейки.Владелец КАК Владелец
	                      |ИЗ
	                      |	Справочник.Ячейки КАК Ячейки
	                      |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.тм_ШтрихкодыЯчеек КАК тм_ШтрихкодыЯчеек
	                      |		ПО (тм_ШтрихкодыЯчеек.Ячейка = Ячейки.Ссылка)";
	
	НовыйЭлемент = Элементы.Добавить("Штрихкод", Тип("ПолеФормы"), Элементы.Список);
	НовыйЭлемент.Вид = ВидПоляФормы.ПолеНадписи;
	НовыйЭлемент.ПутьКДанным = "Список.Штрихкод"; 
	
КонецПроцедуры

#КонецОбласти
