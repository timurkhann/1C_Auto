#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда
	
Функция тм_ЯчейкаНоменклатурыНаСкладе(Номенклатура, Склад) Экспорт

	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ЗапасыНаСкладахОстатки.Ячейка КАК Ячейка,
		|	0 КАК Приоритет
		|ПОМЕСТИТЬ ВТ_Ячейка
		|ИЗ
		|	РегистрНакопления.ЗапасыНаСкладах.Остатки(
		|			,
		|			Номенклатура = &Номенклатура
		|				И СтруктурнаяЕдиница = &Склад) КАК ЗапасыНаСкладахОстатки
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	тм_ЯчейкиНоменклатуры.Ячейка,
		|	1
		|ИЗ
		|	РегистрСведений.тм_ЯчейкиНоменклатуры КАК тм_ЯчейкиНоменклатуры
		|ГДЕ
		|	тм_ЯчейкиНоменклатуры.Номенклатура = &Номенклатура
		|	И тм_ЯчейкиНоменклатуры.Склад = &Склад
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ ПЕРВЫЕ 1
		|	ВТ_Ячейка.Ячейка КАК Ячейка
		|ИЗ
		|	ВТ_Ячейка КАК ВТ_Ячейка
		|ГДЕ
		|	ВТ_Ячейка.Ячейка <> ЗНАЧЕНИЕ(Справочник.Ячейки.ПустаяСсылка)
		|
		|УПОРЯДОЧИТЬ ПО
		|	ВТ_Ячейка.Приоритет";
	
	Запрос.УстановитьПараметр("Номенклатура", Номенклатура);
	Запрос.УстановитьПараметр("Склад", Склад);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Выборка = РезультатЗапроса.Выбрать();
	
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Ячейка;
	Иначе
		Возврат Справочники.Ячейки.ПустаяСсылка();
	КонецЕсли;

КонецФункции
	
	
#КонецЕсли