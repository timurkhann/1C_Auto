
#Область ОбработчикиСобытий

Процедура ПередЗаписью(Отказ)
	
	Если ПустаяСтрока(Имя) Тогда
		Имя = СтрЗаменить(СокрЛП(Наименование), " ", "_");
	Иначе
		Имя = СтрЗаменить(СокрЛП(Имя), " ", "_");
	КонецЕсли;
	
	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;
	
	Права = тм_КЭШ.ПолучитьПраваОбъекта(Метаданные().Имя, Пользователи.ТекущийПользователь());
	
	Если Не Права.Запись Тогда
		ОбщегоНазначения.СообщитьПользователю(НСтр("ru = 'Недостаточно прав на запись'"),,,, Отказ);
		Возврат;
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти
