#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура Расш1_АналогиВместо(Команда)
	
	Если Элементы.Аналоги.Пометка Тогда
		УстановитьОчиститьОтбор(Ложь);
		Элементы.Аналоги.Пометка = Ложь;
	Иначе	
		Номенклатура = Элементы.СписокЗапасы.ТекущаяСтрока;
		Аналоги = НайтиАналогиНоменклатуры(Номенклатура);
		УстановитьОчиститьОтбор(, Аналоги);    
		Элементы.Аналоги.Пометка = Истина;
	КонецЕсли; 
	
КонецПроцедуры

&НаКлиенте
Процедура тм_УстановитьСнятьБлокировкуУдаления(Команда)
	
	тм_УстановитьСнятьБлокировкуУдаленияНаСервере(Элементы.СписокЗапасы.ВыделенныеСтроки);
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервереБезКонтекста
Функция НайтиАналогиНоменклатуры(Номенклатура)

	Аналоги = Новый Массив;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	АналогиНоменклатуры.Аналог КАК Аналог
		|ИЗ
		|	РегистрСведений.АналогиНоменклатуры КАК АналогиНоменклатуры
		|ГДЕ
		|	АналогиНоменклатуры.Номенклатура = &Номенклатура
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	АналогиНоменклатуры.Номенклатура
		|ИЗ
		|	РегистрСведений.АналогиНоменклатуры КАК АналогиНоменклатуры
		|ГДЕ
		|	АналогиНоменклатуры.Аналог = &Номенклатура";
		
	Запрос.УстановитьПараметр("Номенклатура", Номенклатура);
	РезультатЗапроса = Запрос.Выполнить();
	
	Если Не РезультатЗапроса.Пустой() Тогда
		Выборка = РезультатЗапроса.Выбрать();
		Пока Выборка.Следующий() Цикл
			Аналоги.Добавить(Выборка.Аналог);		
		КонецЦикла;
	КонецЕсли; 
	
	Возврат Аналоги;
	
КонецФункции // НайтиАналогиНоменклатуры()
 
&НаСервере
Процедура УстановитьОчиститьОтбор(УстановитьОтбор = Истина, Аналоги = Неопределено)

	Если УстановитьОтбор Тогда
		ЭлементОтбора = СписокЗапасы.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));   
		ЭлементОтбора.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("Ссылка");
		ЭлементОтбора.ВидСравнения = ВидСравненияКомпоновкиДанных.ВСписке;
		ЭлементОтбора.Использование = Истина;
		ЭлементОтбора.ПравоеЗначение = Аналоги;
	Иначе
		СписокЗапасы.Отбор.Элементы.Очистить();
	КонецЕсли; 

КонецПроцедуры // УстановитьОчиститьОтбор()

&НаСервере
Процедура ДобавитьВставитьЭлементыНаФорму()
	
	//СписокЗапасы.ТекстЗапроса = тм_ПереопределяемыйСервер.ПереопределитьТекстЗапросаДинамическогоСписка("Номенклатура");
	//
	//Производитель = тм_ОбщегоНазначенияСервер.ДобавитьЭлементНаФорму(ЭтаФорма, "тм_Производитель", Тип("ПолеФормы"),, Элементы.СписокЗапасы, "СписокЗапасы.тм_Производитель");   
	//Производитель.Заголовок = "Производитель";
	//
	//СвойствоПроизводитель = ПланыВидовХарактеристик.ДополнительныеРеквизитыИСведения.НайтиПоРеквизиту("Имя", "Производитель_DaCar");
	//ОбщегоНазначенияКлиентСервер.УстановитьПараметрДинамическогоСписка(СписокЗапасы, "СвойствоПроизводитель",  СвойствоПроизводитель);
	
	ВведетсяУчетПоЯчейкам = ПолучитьФункциональнуюОпцию("УчетПоЯчейкам");
	
	ДобавляемыеРеквизиты = Новый Массив;
	
	тм_ДополнительнаяТаблица = Новый РеквизитФормы("тм_ДополнительнаяТаблица", Новый ОписаниеТипов("ДеревоЗначений"));
	ДобавляемыеРеквизиты.Добавить(тм_ДополнительнаяТаблица);
	
	ТипыКузова = Справочники.тм_ТипКузоваАвтомобиля.ВсеТипыКузова();
	
	КолонкаНастройка = Новый РеквизитФормы("Настройка", Новый ОписаниеТипов("Строка"), "тм_ДополнительнаяТаблица", "Настройка"); 
	КолонкаПроизводитель = Новый РеквизитФормы("Производитель", Новый ОписаниеТипов("Строка"), "тм_ДополнительнаяТаблица", "Производитель"); 
	КолонкаАвтомобиль = Новый РеквизитФормы("Автомобиль", Новый ОписаниеТипов("Строка"), "тм_ДополнительнаяТаблица", "Автомобиль"); 
	
	
	ДобавляемыеРеквизиты.Добавить(КолонкаНастройка);
	ДобавляемыеРеквизиты.Добавить(КолонкаПроизводитель);
	ДобавляемыеРеквизиты.Добавить(КолонкаАвтомобиль);
	
	Для каждого ТипКузова Из ТипыКузова Цикл
		ИмяРеквизита = ТипКузова.Имя;
		ЗаголовокКолонки = СтрШаблон("Цена (%1)", ТипКузова);
		
		КолонкаТипКузова = Новый РеквизитФормы(ИмяРеквизита, Новый ОписаниеТипов("Строка"), "тм_ДополнительнаяТаблица", ЗаголовокКолонки); 
		ДобавляемыеРеквизиты.Добавить(КолонкаТипКузова);
	КонецЦикла;
	
	// Ячейка
	Если ВведетсяУчетПоЯчейкам Тогда
		//КолонкаЯчейка = Новый РеквизитФормы("тм_Ячейка", Новый ОписаниеТипов("СправочникСсылка.Ячейки"), "РасшифровкаОстатков", "Ячейка"); 
		КолонкаЯчейка = Новый РеквизитФормы("тм_Ячейка", Новый ОписаниеТипов("Строка",,,, Новый КвалификаторыСтроки(1024)), "РасшифровкаОстатков", "Ячейка"); 
		ДобавляемыеРеквизиты.Добавить(КолонкаЯчейка);
	КонецЕсли;
	
	ИзменитьРеквизиты(ДобавляемыеРеквизиты);
	
	// Ячейка
	Если ВведетсяУчетПоЯчейкам Тогда
		ИндексЯчейки = ДобавляемыеРеквизиты.Найти(КолонкаЯчейка);
		ДобавляемыеРеквизиты.Удалить(ИндексЯчейки);
		
		РеквизитЯчейка = Элементы.Вставить("Колонка" + "тм_Ячейка", Тип("ПолеФормы"), Элементы.РасшифровкаОстатков, Элементы.РасшифровкаОстатковОстатокОбщий);
		РеквизитЯчейка.Вид = ВидПоляФормы.ПолеНадписи;
		РеквизитЯчейка.ПутьКДанным = СтрШаблон("РасшифровкаОстатков.%1", "тм_Ячейка");
		РеквизитЯчейка.Заголовок = "Ячейка (остаток/по умолчанию)";
		РеквизитЯчейка.ЦветФонаЗаголовка = ЦветаСтиля.ЦветФонаПодсказки;
	КонецЕсли;
	
	ГруппаДопИнформация =  тм_ОбщегоНазначенияВызовСервера.ДобавитьЭлементНаФорму(ЭтаФорма, 
		"тм_ГруппаДопИнформация",
		Тип("ГруппаФормы"),
		ВидГруппыФормы.ОбычнаяГруппа,
		Элементы.СпискиНоменклатуры); 
		
	ГруппаДопИнформация.Заголовок = НСтр("ru = 'Информация (Dacar)'"); 
	ГруппаДопИнформация.Поведение = ПоведениеОбычнойГруппы.Свертываемая;
	ГруппаДопИнформация.ОтображениеУправления = ОтображениеУправленияОбычнойГруппы.Картинка;
	
	ДопТаблица = тм_ОбщегоНазначенияВызовСервера.ДобавитьЭлементНаФорму(ЭтаФорма, 
		"тм_ДополнительнаяТаблица",
		Тип("ТаблицаФормы"),, ГруппаДопИнформация, "тм_ДополнительнаяТаблица"); 
	
	// запретим менять положение строк и сами строки, отключим командную панель
	ДопТаблица.ИзменятьСоставСтрок = Ложь;
	ДопТаблица.ИзменятьПорядокСтрок = Ложь;
	ДопТаблица.ПоложениеКоманднойПанели = ПоложениеКоманднойПанелиЭлементаФормы.Нет;
	
	Для каждого ДобавляемыйРеквизит Из ДобавляемыеРеквизиты Цикл
		Если ПустаяСтрока(ДобавляемыйРеквизит.Путь) Тогда
			Продолжить;
		КонецЕсли;
		Реквизит = Элементы.Добавить("Колонка" + ДобавляемыйРеквизит.Имя, Тип("ПолеФормы"), ДопТаблица);
		Реквизит.Вид = ВидПоляФормы.ПолеНадписи;
		Реквизит.ПутьКДанным = СтрШаблон("тм_ДополнительнаяТаблица.%1", ДобавляемыйРеквизит.Имя);
		Реквизит.Заголовок = ДобавляемыйРеквизит.Заголовок;
	КонецЦикла;
	
КонецПроцедуры // ДобавитьВставитьЭлементыНаФорму()

&НаКлиенте
Процедура ЗаполнитьДополнительнуюТаблицу()

	ЗаполнитьДополнительнуюТаблицуНаСервере(Элементы.СписокЗапасы.ТекущаяСтрока);
	РазвернутьДеревоDaCar();

КонецПроцедуры // ЗаполнитьДополнительнуюТаблицу()

&НаСервере
Процедура ЗаполнитьДополнительнуюТаблицуНаСервере(Номенклатура)
	
	СвойствоПроизводитель = ПланыВидовХарактеристик.тм_ПредопределенныеЭлементы.Производитель.Значение;
	
	ДопТаблица = РеквизитФормыВЗначение("тм_ДополнительнаяТаблица");
	ДопТаблица.Строки.Очистить();
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ЦеныРаботАвтомобилей.Работа КАК Работа,
		|	ЦеныРаботАвтомобилей.ТипКузова КАК ТипКузова,
		|	ЦеныРаботАвтомобилей.Автомобиль КАК Авто,
		|	МАКСИМУМ(ЦеныРаботАвтомобилей.Период) КАК Период
		|ПОМЕСТИТЬ ВТ_Макс
		|ИЗ
		|	РегистрСведений.тм_ЦеныРаботАвтомобилей КАК ЦеныРаботАвтомобилей
		|ГДЕ
		|	ИСТИНА
		|	И ЦеныРаботАвтомобилей.Работа = &Номенклатура
		|	И ЦеныРаботАвтомобилей.Автомобиль <> &ПустойАвтомобиль
		|	И ЦеныРаботАвтомобилей.ТипКузова В(&ТипыКозова)
		|
		|СГРУППИРОВАТЬ ПО
		|	ЦеныРаботАвтомобилей.Работа,
		|	ЦеныРаботАвтомобилей.ТипКузова,
		|	ЦеныРаботАвтомобилей.Автомобиль
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ЦеныРаботАвтомобилей.Работа КАК Работа,
		|	ЦеныРаботАвтомобилей.ТипКузова КАК ТипКузова,
		|	МАКСИМУМ(ЦеныРаботАвтомобилей.Период) КАК Период
		|ПОМЕСТИТЬ ВТ_МаксПустойАвто
		|ИЗ
		|	РегистрСведений.тм_ЦеныРаботАвтомобилей КАК ЦеныРаботАвтомобилей
		|ГДЕ
		|	ИСТИНА
		|	И ЦеныРаботАвтомобилей.Работа = &Номенклатура
		|	И ЦеныРаботАвтомобилей.Автомобиль = &ПустойАвтомобиль
		|	И ЦеныРаботАвтомобилей.ТипКузова В(&ТипыКозова)
		|
		|СГРУППИРОВАТЬ ПО
		|	ЦеныРаботАвтомобилей.Работа,
		|	ЦеныРаботАвтомобилей.ТипКузова
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	""Производитель запчасти"" КАК Настройка,
		|	"""" КАК ТипКузова,
		|	"""" КАК Автомобиль,
		|	НоменклатураДополнительныеРеквизиты.Значение КАК Значение
		|ИЗ
		|	Справочник.Номенклатура.ДополнительныеРеквизиты КАК НоменклатураДополнительныеРеквизиты
		|ГДЕ
		|	ИСТИНА
		|	И НоменклатураДополнительныеРеквизиты.Ссылка = &Номенклатура
		|	И НоменклатураДополнительныеРеквизиты.Свойство = &Свойство
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	""Цены работ"",
		|	ЕСТЬNULL(ЦеныРаботАвтомобилей.ТипКузова.Имя, """"),
		|	ПРЕДСТАВЛЕНИЕССЫЛКИ(ЦеныРаботАвтомобилей.Автомобиль),
		|	ЦеныРаботАвтомобилей.Цена
		|ИЗ
		|	РегистрСведений.тм_ЦеныРаботАвтомобилей КАК ЦеныРаботАвтомобилей
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТ_МаксПустойАвто КАК ВТ_МаксПустойАвто
		|		ПО (ИСТИНА)
		|			И ЦеныРаботАвтомобилей.Работа = ВТ_МаксПустойАвто.Работа
		|			И ЦеныРаботАвтомобилей.Период = ВТ_МаксПустойАвто.Период
		|			И ЦеныРаботАвтомобилей.ТипКузова = ВТ_МаксПустойАвто.ТипКузова
		|ГДЕ
		|	ИСТИНА
		|	И (ЦеныРаботАвтомобилей.Работа, ЦеныРаботАвтомобилей.ТипКузова) В
		|			(ВЫБРАТЬ
		|				ВТ_МаксПустойАвто.Работа КАК Работа,
		|				ВТ_МаксПустойАвто.ТипКузова КАК ТипКузова
		|			ИЗ
		|				ВТ_МаксПустойАвто КАК ВТ_МаксПустойАвто)
		|	И ЦеныРаботАвтомобилей.Автомобиль = &ПустойАвтомобиль
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	""Цены работ"",
		|	ЕСТЬNULL(ЦеныРаботАвтомобилей.ТипКузова.Имя, """"),
		|	ПРЕДСТАВЛЕНИЕССЫЛКИ(ЦеныРаботАвтомобилей.Автомобиль),
		|	ЦеныРаботАвтомобилей.Цена
		|ИЗ
		|	РегистрСведений.тм_ЦеныРаботАвтомобилей КАК ЦеныРаботАвтомобилей
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТ_Макс КАК ВТ_Макс
		|		ПО (ИСТИНА)
		|			И ЦеныРаботАвтомобилей.Работа = ВТ_Макс.Работа
		|			И ЦеныРаботАвтомобилей.Период = ВТ_Макс.Период
		|			И ЦеныРаботАвтомобилей.ТипКузова = ВТ_Макс.ТипКузова
		|			И ЦеныРаботАвтомобилей.Автомобиль = ВТ_Макс.Авто
		|ГДЕ
		|	ИСТИНА
		|	И (ЦеныРаботАвтомобилей.Работа, ЦеныРаботАвтомобилей.ТипКузова) В
		|			(ВЫБРАТЬ
		|				ВТ_Макс.Работа КАК Работа,
		|				ВТ_Макс.ТипКузова КАК ТипКузова
		|			ИЗ
		|				ВТ_Макс КАК ВТ_Макс)
		|	И ЦеныРаботАвтомобилей.Автомобиль <> &ПустойАвтомобиль
		|ИТОГИ ПО
		|	Настройка
		|";
	
	Запрос.Параметры.Вставить("Номенклатура", Номенклатура); 
	Запрос.Параметры.Вставить("Свойство", СвойствоПроизводитель); // <Дополнительный реквизит / сведение>[Производитель ("Общие")], ПланыВидовХарактеристик.ДополнительныеРеквизитыИСведения.НайтиПоНаименованию("Производитель");
	Запрос.Параметры.Вставить("ПустойАвтомобиль", Справочники.тм_Автомобили.ПустаяСсылка()); // <Автомобили (тм)>[]
	Запрос.Параметры.Вставить("ТипыКозова", Справочники.тм_ТипКузоваАвтомобиля.ВсеТипыКузова()); // <Список значений>[Внедорожник Люкс; Коммерческий; Кроссовер; Седан Хэтчбек Универсал]
	
	РезультатЗапроса = Запрос.Выполнить();
	Если РезультатЗапроса.Пустой() Тогда
		ЗначениеВРеквизитФормы(ДопТаблица, "тм_ДополнительнаяТаблица");
		Возврат;
	КонецЕсли;
	
	ТипНоменклатуры = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Номенклатура, "ТипНоменклатуры");
	
	ВыборкаНастройка = РезультатЗапроса.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	
	Пока ВыборкаНастройка.Следующий() Цикл
		
		СтрокаПервыйУровень = ДопТаблица.Строки.Добавить();
		СтрокаПервыйУровень.Настройка = ВыборкаНастройка.Настройка;
		
		ЭтоНастройкаПроизводитель = СтрокаПервыйУровень.Настройка = "Производитель запчасти";
		ЭтоНастройкаЦеныРабот = СтрокаПервыйУровень.Настройка = "Цены работ";
		
		Выборка = ВыборкаНастройка.Выбрать();
		
		СтрокаВторойУровень = Неопределено;
	
		Пока Выборка.Следующий() Цикл
			
			Если ЭтоНастройкаПроизводитель Тогда
				СтрокаПервыйУровень.Производитель = Выборка.Значение;
				Прервать;
			КонецЕсли;
			
			Если ЭтоНастройкаЦеныРабот Тогда
				
				ДанныеЗапроса = ПустаяИнформация(РезультатЗапроса);
				
				ЗаполнитьЗначенияСвойств(ДанныеЗапроса, Выборка, "Автомобиль");
				
				Если ЗначениеЗаполнено(Выборка.ТипКузова) Тогда
					ИмяНастройки = СтрЗаменить(СокрЛП(Выборка.ТипКузова), " ", "_");
					ДанныеЗапроса.Вставить(ИмяНастройки, Выборка.Значение);
				КонецЕсли;
				
				Если Не ЗначениеЗаполнено(ДанныеЗапроса.Автомобиль)
					И ТипНоменклатуры <> Перечисления.ТипыНоменклатуры.Запас Тогда
					ДанныеЗапроса.Автомобиль = "<для всех>";
				КонецЕсли;
				
				Если СтрокаВторойУровень <> Неопределено
					И ДанныеЗапроса.Автомобиль = "<для всех>" Тогда
					ЗаполнитьЗначенияСвойств(СтрокаВторойУровень, ДанныеЗапроса,, "Настройка");
				Иначе
					СтрокаВторойУровень = СтрокаПервыйУровень.Строки.Добавить();
					ЗаполнитьЗначенияСвойств(СтрокаВторойУровень, ДанныеЗапроса,, "Настройка");
				КонецЕсли;
				
			КонецЕсли;
			
		КонецЦикла;
		
	КонецЦикла;
	
	ЗначениеВРеквизитФормы(ДопТаблица, "тм_ДополнительнаяТаблица");
	
КонецПроцедуры

&НаСервере
Функция ПустаяИнформация(РезультатЗапроса)

	ДанныеЗапроса = Новый Структура;
	Для каждого Колонка Из РезультатЗапроса.Колонки Цикл
		ДанныеЗапроса.Вставить(Колонка.Имя);
	КонецЦикла;
	
	Возврат ДанныеЗапроса;
	
КонецФункции 
 
&НаСервере
Процедура УстановитьУсловноеОформлениеDacar()
	
	ИменаТиповКузовов = Справочники.тм_ТипКузоваАвтомобиля.ИменаТиповКузовов();
	
	// Автомобиль
	ЭлементУсловногоОформления = УсловноеОформление.Элементы.Добавить();
	
	Для каждого ЭлементФормы Из Элементы.тм_ДополнительнаяТаблица.ПодчиненныеЭлементы Цикл
		
		ЭлементФормы.ШрифтЗаголовка = Новый Шрифт(,, Истина);
		
		// Колонка цен
		ИскомыйТипКузова = СтрЗаменить(ЭлементФормы.Имя, "Колонка", "");
		Индекс = ИменаТиповКузовов.Найти(ИскомыйТипКузова);
		Если Индекс = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		
		ЭлементОтбора = ЭлементУсловногоОформления.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
		ЭлементОтбора.ЛевоеЗначение = Новый ПолеКомпоновкиДанных(СтрШаблон("тм_ДополнительнаяТаблица.%1", ИменаТиповКузовов[Индекс])); // имя поля
		ЭлементОтбора.ВидСравнения = ВидСравненияКомпоновкиДанных.Больше; // либо задаем свой
		ЭлементОтбора.ПравоеЗначение = 0;
		ЭлементОтбора.Использование = Истина;
		
		Поле = ЭлементУсловногоОформления.Поля.Элементы.Добавить(); 
		Поле.Поле = Новый ПолеКомпоновкиДанных(ЭлементФормы.Имя);
		Поле.Использование = Истина;
		
	КонецЦикла;
	
	ЭлементОтбора = ЭлементУсловногоОформления.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	ЭлементОтбора.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("тм_ДополнительнаяТаблица.Автомобиль"); // имя поля
	ЭлементОтбора.ВидСравнения = ВидСравненияКомпоновкиДанных.НачинаетсяС; // либо задаем свой
	ЭлементОтбора.ПравоеЗначение = "<для всех>";
	ЭлементОтбора.Использование = Истина;
	
	Поле = ЭлементУсловногоОформления.Поля.Элементы.Добавить(); 
	Поле.Поле = Новый ПолеКомпоновкиДанных("КолонкаАвтомобиль");
	Поле.Использование = Истина;
	
	ЭлементУсловногоОформления.Оформление.УстановитьЗначениеПараметра("ЦветТекста", WebЦвета.Красный);
	ЭлементУсловногоОформления.Оформление.УстановитьЗначениеПараметра("Шрифт", Новый Шрифт(,, Истина));
	
	// Настройка
	ЭлементУсловногоОформленияНастройка = УсловноеОформление.Элементы.Добавить();
	
	ЭлементОтбора = ЭлементУсловногоОформленияНастройка.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	ЭлементОтбора.ЛевоеЗначение = Новый ПолеКомпоновкиДанных(СтрШаблон("тм_ДополнительнаяТаблица.%1", "Настройка")); // имя поля
	ЭлементОтбора.ВидСравнения = ВидСравненияКомпоновкиДанных.Заполнено; // либо задаем свой
	ЭлементОтбора.Использование = Истина;
	
	Поле = ЭлементУсловногоОформленияНастройка.Поля.Элементы.Добавить(); 
	Поле.Поле = Новый ПолеКомпоновкиДанных("КолонкаНастройка");
	Поле.Использование = Истина;
		
	ЭлементУсловногоОформленияНастройка.Оформление.УстановитьЗначениеПараметра("ЦветТекста", WebЦвета.ТемноБордовый);
	ЭлементУсловногоОформленияНастройка.Оформление.УстановитьЗначениеПараметра("Шрифт", Новый Шрифт(,, Истина));
	
КонецПроцедуры // УстановитьУсловноеОформление()

&НаКлиенте
Процедура РазвернутьДеревоDaCar()
	
	ЭлементыДерева = ЭтотОбъект.тм_ДополнительнаяТаблица.ПолучитьЭлементы();
	Для каждого ЭлементДерева Из ЭлементыДерева Цикл
		Элементы.тм_ДополнительнаяТаблица.Развернуть(ЭлементДерева.ПолучитьИдентификатор());
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
&После("ОбновитьПанельОстатков")
Процедура тм_ОбновитьПанельОстатков(Номенклатура, ЕдиницаИзмерения, Характеристика)
	
	Если Не ОстаткиВидимость Тогда
		Возврат;
	КонецЕсли;
	
	Если Не ПолучитьФункциональнуюОпцию("УчетПоЯчейкам") Тогда
		Возврат;
	КонецЕсли;
	
	ЯчейкаПоУмолчанию = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Номенклатура, "Ячейка");
	
	Если РасшифровкаОстатков.Количество()
		И ЗначениеЗаполнено(ЯчейкаПоУмолчанию) Тогда
		
		ТаблицаРасшифровкаОстатков = РасшифровкаОстатков.Выгрузить(, "СтруктурнаяЕдиница, Номенклатура, Характеристика");
		
		Запрос = Новый Запрос;
		Запрос.УстановитьПараметр("ТаблицаРасшифровкаОстатков", ТаблицаРасшифровкаОстатков);
		Запрос.Текст = 
			"ВЫБРАТЬ
			|	ТаблицаРасшифровкаОстатков.СтруктурнаяЕдиница КАК СтруктурнаяЕдиница,
			|	ТаблицаРасшифровкаОстатков.Номенклатура КАК Номенклатура,
			|	ТаблицаРасшифровкаОстатков.Характеристика КАК Характеристика
			|ПОМЕСТИТЬ ВТ_Таблица
			|ИЗ
			|	&ТаблицаРасшифровкаОстатков КАК ТаблицаРасшифровкаОстатков
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|ВЫБРАТЬ
			|	ЗапасыНаСкладахОстатки.Номенклатура КАК Номенклатура,
			|	ЗапасыНаСкладахОстатки.Характеристика КАК Характеристика,
			|	ЗапасыНаСкладахОстатки.СтруктурнаяЕдиница КАК СтруктурнаяЕдиница,
			|	ПРЕДСТАВЛЕНИЕ(ЗапасыНаСкладахОстатки.Ячейка) КАК Ячейка
			|ПОМЕСТИТЬ ВТ_Остатки
			|ИЗ
			|	РегистрНакопления.ЗапасыНаСкладах.Остатки(
			|			,
			|			(Номенклатура, СтруктурнаяЕдиница, Характеристика) В
			|				(ВЫБРАТЬ
			|					ВТ_Таблица.Номенклатура КАК Номенклатура,
			|					ВТ_Таблица.СтруктурнаяЕдиница КАК СтруктурнаяЕдиница,
			|					ВТ_Таблица.Характеристика КАК Характеристика
			|				ИЗ
			|					ВТ_Таблица КАК ВТ_Таблица)) КАК ЗапасыНаСкладахОстатки
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|ВЫБРАТЬ
			|	ВТ_Таблица.СтруктурнаяЕдиница КАК СтруктурнаяЕдиница,
			|	ВТ_Таблица.Номенклатура КАК Номенклатура,
			|	ВТ_Таблица.Характеристика КАК Характеристика,
			|	ЕСТЬNULL(ВТ_Остатки.Ячейка, """") КАК ЯчейкаОстаток,
			|	ЕСТЬNULL(ПРЕДСТАВЛЕНИЕ(тм_ЯчейкиНоменклатуры.Ячейка), """") КАК ЯчейкаПоУмолчанию
			|ИЗ
			|	ВТ_Таблица КАК ВТ_Таблица
			|		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_Остатки КАК ВТ_Остатки
			|		ПО ВТ_Таблица.СтруктурнаяЕдиница = ВТ_Остатки.СтруктурнаяЕдиница
			|			И ВТ_Таблица.Номенклатура = ВТ_Остатки.Номенклатура
			|			И ВТ_Таблица.Характеристика = ВТ_Остатки.Характеристика
			|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.тм_ЯчейкиНоменклатуры КАК тм_ЯчейкиНоменклатуры
			|		ПО ВТ_Таблица.СтруктурнаяЕдиница = тм_ЯчейкиНоменклатуры.Склад
			|			И ВТ_Таблица.Номенклатура = тм_ЯчейкиНоменклатуры.Номенклатура";
		
		РезультатЗапроса = Запрос.Выполнить();
		
		Выборка = РезультатЗапроса.Выбрать();
		
		Пока Выборка.Следующий() Цикл
			Отбор = Новый Структура("СтруктурнаяЕдиница, Номенклатура, Характеристика");
			ЗаполнитьЗначенияСвойств(Отбор, Выборка);
			СтрокиРасшифровкиОстатков = РасшифровкаОстатков.НайтиСтроки(Отбор);
			
			Для каждого СтрокаРасшифровкаОстатков Из СтрокиРасшифровкиОстатков Цикл
				
				Если ПустаяСтрока(СтрокаРасшифровкаОстатков.тм_Ячейка) Тогда
					СтрокаРасшифровкаОстатков.тм_Ячейка = ?(ЗначениеЗаполнено(Выборка.ЯчейкаОстаток),
						Выборка.ЯчейкаОстаток, Выборка.ЯчейкаПоУмолчанию);
				Иначе
					СтрокаРасшифровкаОстатков.тм_Ячейка = СтрокаРасшифровкаОстатков.тм_Ячейка + ", " + 
						?(ЗначениеЗаполнено(Выборка.ЯчейкаОстаток),
						Выборка.ЯчейкаОстаток, Выборка.ЯчейкаПоУмолчанию);
						
				КонецЕсли;
				
			КонецЦикла; 
		КонецЦикла;
		
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ДобавитьКоманды()
	
	// Создадим команды
	Команда = ЭтотОбъект.Команды.Добавить("тм_УстановитьСнятьБлокировкуУдаления");
	Команда.Действие = "тм_УстановитьСнятьБлокировкуУдаления";
	
	// Создадим кнопку и привяжем к ней команду    	
	Кнопка = тм_ОбщегоНазначенияВызовСервера.ВставитьЭлементНаФорму(ЭтотОбъект, 
		"тм_УстановитьСнятьБлокировкуУдаления",
		Тип("КнопкаФормы"),
		Неопределено,
		Элементы.СписокЗапасыКонтекстноеМеню,
		Неопределено,
		Элементы.СписокЗапасыКонтекстноеМенюОтменитьПоиск);
		
	Кнопка.Заголовок = "Установить/снять блокировку удаления";
	Кнопка.ИмяКоманды = "тм_УстановитьСнятьБлокировкуУдаления";
	Кнопка.Картинка = БиблиотекаКартинок.ЗакончитьРедактирование;
	
КонецПроцедуры // ДобавитьКоманды()

&НаСервереБезКонтекста
Процедура тм_УстановитьСнятьБлокировкуУдаленияНаСервере(Знач МассивНоменклатуры)
	
	НачатьТранзакцию();
	Попытка
		БлокировкаДанных = Новый БлокировкаДанных;
		ЭлементБлокировкиДанных = БлокировкаДанных.Добавить("Справочник.Номенклатура");
		ЭлементБлокировкиДанных.УстановитьЗначение("Ссылка", МассивНоменклатуры[0]);
		ЭлементБлокировкиДанных.Режим = РежимБлокировкиДанных.Исключительный;
		БлокировкаДанных.Заблокировать();
		
		Для каждого ТекущаяНоменклатура Из МассивНоменклатуры Цикл
			НоменклатураОбъект = ТекущаяНоменклатура.ПолучитьОбъект();
			НоменклатураОбъект.тм_БлокировкаУдаления = Не НоменклатураОбъект.тм_БлокировкаУдаления;
			НоменклатураОбъект.ОбменДанными.Загрузка = Истина;
			НоменклатураОбъект.Записать();
		КонецЦикла;
		
		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
		ОбщегоНазначения.СообщитьПользователю(ОписаниеОшибки());
	КонецПопытки; 
	
КонецПроцедуры // тм_УстановитьСнятьБлокировкуУдаленияНаСервере()



#КонецОбласти 
